function displayRecordName(rec){
  const recordId=safe(rec&&rec.id);
  if(recordId===HOS_V151_ALCHEMY_BUDDY_ID) return "Alchemy Buddy";
  if(HOS_V151_ALCHEMY_CARD_IDS.has(recordId)){
    const germanName=safe(field(rec,"Deutscher Name")).trim();
    if(germanName) return germanName;
  }
  const rawTitle=safe(rec&&rec.name);
  if(norm(rawTitle)==="reiten horsemanship auf 20") return "Reiten auf 20";
  const raw=safe(rec.name||field(rec,"Name")).trim();
  const topic=safe(field(rec,"Name/Thema")||field(rec,"Thema")).trim();
  if(/^(pferd|hund)$/i.test(raw) && topic && norm(topic)!==norm(raw)) return topic;
  return raw||topic||"(ohne Name)";
}
function dogFoodText(rec){
  return norm([
    displayRecordName(rec),rec.name,rawGroup(rec),field(rec,"Unterkategorie"),field(rec,"Slot/Rolle"),
    field(rec,"Kategorie"),field(rec,"Name/Thema"),primaryCommand(rec)||rec.cheat
  ].filter(Boolean).join(" "));
}
function isPreferredDogTreat(rec){
  if(isAnimalExcluded(rec)) return false;
  const t=dogFoodText(rec), title=norm(displayRecordName(rec));
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec));
  if(/^(hund|koter|koeter|köter|pferd|pebbles)$/.test(title) && !/futter|wurst|sausage|krakauer|fleisch|meat/.test(title+" "+g)) return false;
  if(/krakauer\s+sattel|warsaddle|\bsattel\b|\bsaddle\b/.test(t) && !/futter|hundefutter|koeter-futter|köter-futter|smoked sausage|geraeucherte krakauer|geräucherte krakauer/.test(t)) return false;
  if(/29a4f58e-6e00-4f9c-9273-1a76e0eccff0|geraeucherte krakauer|geräucherte krakauer|smoked sausage|hundefutter|koeter-futter|köter-futter/.test(t)) return true;
  const foodBucket=/nahrung|food|jagd|fleisch|wurst|geraeuchert|geräuchert/.test(s+" "+g);
  if(!foodBucket) return false;
  if(/\b(krakauer|wurst|sausage|salami)\b/.test(title+" "+g)) return true;
  return /\b(hasenfleisch|hase|hare|kaninchen|rabbit|rehfleisch|reh|venison|wildschweinfleisch|wildschwein|boar|wildbret)\b/.test(title) && /fleisch|meat|wildbret|keule|braten/.test(title+" "+g);
}
function isDogTreat(rec){ return isKnownDogFood(rec)||isPreferredDogTreat(rec); }
function querySearchIndex(rec){
  const f=rec.fields||{};
  const visibleMeta=(value)=>{
    const text=playerSafeText(value);
    return /pruef|prüf/.test(norm(text))?"":text;
  };
  const playerFields=playerFieldEntries(rec).map(([key,value])=>[key,visibleMeta(value)]).flat().filter(Boolean);
  const core=[
    displayRecordName(rec),rec.name,rec.english_name,
    visibleMeta(rec.__sub),visibleMeta(rec.__allSub),
    primaryCommand(rec)||rec.cheat,
    visibleMeta(f["Kategorie"]),visibleMeta(f["Name/Thema"]),visibleMeta(f["Name"]),visibleMeta(f["Unterkategorie"]),visibleMeta(f["Slot/Rolle"]),visibleMeta(f["Set"]),visibleMeta(f["Setname"]),
    f["Befehl zum Kopieren"],f["Cheat zum Kopieren"],
    ...playerFields
  ];
  return norm(core.filter(Boolean).join(" "));
}
function animalIsRawAnimalSection(rec){
  const a = animalPrimaryText(rec);
  return /pferd & köter|pferd & koeter|23_lb_pferd_koeter|lb_pferd_koeter/.test(a.section+" "+a.group+" "+a.sheet);
}
function isAnimalExcluded(rec){
  const a = animalPrimaryText(rec);
  const primary = [a.title,a.group,a.section,a.sheet,a.cheat,a.slot,a.setName].join(" ");
  const h = blob(rec);
  const kind = norm(rec.kind || "");
  if(/^gamelog_(buff|perk)$/.test(kind)) return true;
  if(/nicht benutzen|gefahr|debug|intern(?:er|e)? prüf|intern(?:er|e)? pruef/.test(a.title+" "+a.group+" "+a.section+" "+a.sheet)) return true;

  // Interne Prüflisten und QC-Dubletten nie in die Spielerkategorie ziehen.
  if(/werkstatt|prüfung|pruefung|cheat[-_ ]?id|qc[-_ ]?cheat/.test(a.section+" "+a.sheet+" "+a.group)) return true;

  // Lösungen/Guides nur dann, wenn sie wirklich als Pferd-&-Köter-Abschnitt geführt sind.
  if(/hilfe|komplett|eurogamer|pdf|loesungsbuch|lösungsbuch|quest|fundort|karten/.test(a.section+" "+a.sheet+" "+a.group) && !animalIsRawAnimalSection(rec)) return true;

  // Harte Sperre gegen die TEST48-Leckage: Schmiedematerial, Waffen, Kräuter, Rezepte und Tränke
  // dürfen nicht nur wegen Wörtern wie Hufeisen, Hund oder Äsop in Pferd & Köter auftauchen.
  if(/material|handwerksmaterial|schmied|kraeuter|kräuter|tränke|traenke|gifte|rezepte|waffen|nahkampf|fernkampf|munition/.test(a.section+" "+a.sheet)) return true;
  if(/elixier des aesop|elixier des äsop|aesop|äsop|potion_aesop|hair_o_dog|hairodog|katerbier/.test(primary+" "+h)) return true;
  if(/schmiedeanleitung|recipe_/.test(primary+" "+a.cheat)) return true;
  return false;
}
function horseGearKind(rec){
  const a=animalPrimaryText(rec);
  const t=[a.title,a.group,a.cheat,a.slot,a.setName].join(" ");
  if(/rossstirn|chanfron|horse[-_ ]?head|horsehead/.test(t)) return "head";
  if(/sporen|spurs|\bsporn\b/.test(t)) return "spurs";
  if(/schabracke|saddlecloth|satteldecke|pferdedecke|caparison/.test(t)) return "caparison";
  if(/hinterzeug|\bharness\b/.test(t)) return "harness";
  if(/zaumzeug|\bzaum\b|bridon|trense|zuegel|bridle/.test(t)) return "bridle";
  if(/hufeisen|horseshoe/.test(t)) return "horseshoe";
  if(/sattel|saddle|warsaddle/.test(t)) return "saddle";
  if(/pferderuestung|pferderüstung|horse[-_ ]?armor/.test(t)) return "armor";
  return "";
}
function horseCommandKey(rec){
  return norm(primaryCommand(rec)||rec.cheat||"").replace(/\s+/g," ").trim();
}
function isHorseGearCandidate(rec){
  const a=animalPrimaryText(rec);
  const kind=horseGearKind(rec);
  if(!kind) return false;
  const bucket=[a.section,a.sheet,a.group,a.slot,a.setName].join(" ");
  const command=a.cheat;
  // Interne Gegenstandscodes sind der stärkste Beleg; danach echte Rüstungs-/Loadoutbereiche.
  if(/chanfron|caparison|saddle|horseshoe|spurs|bridle|harness/.test(command)) return true;
  if(/ruestung|rüstung|outfit|sets|loadouts|pferdeausruestung|pferdeausrüstung|pferd-\/koeter-set|pferd-\/köter-set/.test(bucket)) return true;
  return animalIsRawAnimalSection(rec);
}
function isActualHorseGear(rec){
  if(isAnimalExcluded(rec)) return false;
  return isHorseGearCandidate(rec);
}
function isKnownDogFood(rec){
  if(isAnimalExcluded(rec)) return false;
  const t=dogFoodText(rec), title=norm(displayRecordName(rec)), g=norm(rawGroup(rec));
  if(/^(hund|koter|koeter|köter|pferd|pebbles)$/.test(title) && !/futter|wurst|sausage|krakauer|fleisch|meat/.test(title+" "+g)) return false;
  if(/krakauer\s+sattel|warsaddle|\bsattel\b|\bsaddle\b/.test(t) && !/futter|hundefutter|koeter-futter|köter-futter|smoked sausage|geraeucherte krakauer|geräucherte krakauer/.test(t)) return false;
  return /29a4f58e-6e00-4f9c-9273-1a76e0eccff0|koeter-futter|köter-futter|hundefutter|futter fuer den hund|futter für den hund|geraeucherte krakauer|geräucherte krakauer|smoked sausage|dog food/.test(t);
}
function isHorseGear(rec){
  return isActualHorseGear(rec);
}
/* HEINRICHOS PLAYER V1.5 – PFERD/HUND-ASSET-ZUORDNUNG */
const HOS_PLAYER_HORSE_GUIDE_IDS=new Set(["eurogamer-45","heinrichos-tipp-212"]);
const HOS_PLAYER_KRAKAUER_ID="02_Fertige_Sets-63";
const HOS_PLAYER_DOG_CARE_IDS=new Set(["11_Skillbuecher-38","Attribute_&_Skills-028","gamelog_skill_20260611_015"]);
const HOS_PLAYER_HORSE_ASSET=ICON_CAT+"item_horse_pebbles_medallion_v11_inward_matte_transparent.png";
const HOS_PLAYER_KRAKAUER_ASSET=ICON_QUICK+"item_dog_food_bowl_bone_v11.png";
const HOS_PLAYER_DOG_CARE_ASSET=ICON_QUICK+"ui_quick_dog_food_care_v11_inward_matte_transparent.png";
window.HEINRICHOS_PLAYER_TIER_ASSETS_V15=Object.freeze({
  horseGuideIds:Array.from(HOS_PLAYER_HORSE_GUIDE_IDS),
  krakauerId:HOS_PLAYER_KRAKAUER_ID,
  dogCareIds:Array.from(HOS_PLAYER_DOG_CARE_IDS),
  shieldLogicChanged:false
});
function isAnimalRelated(rec){
  const playerAnimalId=safe(rec&&rec.id);
  if(HOS_PLAYER_HORSE_GUIDE_IDS.has(playerAnimalId)) return true;
  if(isAnimalExcluded(rec)) return false;
  const a = animalPrimaryText(rec);
  const titleAndCommand = [a.title,a.cheat,a.slot,a.setName].join(" ");
  const rawAnimal = animalIsRawAnimalSection(rec);
  const h = blob(rec);

  if(isActualHorseGear(rec)) return true;
  if(isDogTreat(rec)) return true;
  if(rawAnimal) return true;
  if(/horse_regeneration|reitbonus|horse_riding|horsemanship|reiten|das leben im sattel|skillbook_horseriding/.test(titleAndCommand+" "+h)) return true;
  if(/houndmaster|hundeskill|hundemeister|hundeflüsterer|hundefluesterer|gehorsam von hunden|vom treuesten freund|owned dog|\bköter\b|\bkoeter\b|\bhund\b|\bdog\b/.test(titleAndCommand)) return true;
  return false;
}
function animalSub(rec){
  const playerAnimalId=safe(rec&&rec.id);
  if(HOS_PLAYER_HORSE_GUIDE_IDS.has(playerAnimalId)) return "Pferd";
  const a=animalPrimaryText(rec);
  const rawAnimal=animalIsRawAnimalSection(rec);
  const titleAndCommand=[a.title,a.cheat,a.slot,a.setName].join(" ");
  const h=blob(rec);
  if(isAnimalExcluded(rec)) return "Alle";
  if(isActualHorseGear(rec)){
    const kind=horseGearKind(rec);
    if(kind==="head") return "Rossstirn / Stirnpanzerung";
    if(kind==="spurs") return "Sporen";
    if(kind==="saddle") return "Sättel";
    if(kind==="bridle") return "Zaumzeug";
    if(kind==="caparison") return "Schabracken";
    if(kind==="horseshoe") return "Hufeisen";
    return "Pferdeausrüstung";
  }
  if(isDogTreat(rec)) return "Köter-Futter / Würste";
  if(/houndmaster|hundeskill|hundemeister|hundefluesterer|hundeflüsterer|gehorsam von hunden|vom treuesten freund/.test(titleAndCommand+" "+h)) return "Hundeskill/Houndmaster";
  if(/horsemanship|horse_riding|reitkunst|\breiten\b|das leben im sattel|skillbook_horseriding/.test(titleAndCommand+" "+h)) return "Reiten/Horsemanship";
  if(/horse_regeneration|reitbonus|sporen|spurs|traglast|pferde-buffs/.test(titleAndCommand+" "+h)) return "Pferde-Buffs";
  if(/\bkoeter\b|\bköter\b|\bhund\b|\bdog\b/.test(titleAndCommand+" "+(rawAnimal?a.group:""))) return "Köter/Hund";
  if(/pferd|horse/.test(titleAndCommand+" "+(rawAnimal?a.group:""))) return "Pferd";
  return "Alle";
}
function quickSub(rec){
  const h=blob(rec);
  // Spezifische Aktion zuerst, damit Retterschnaps-/Save-Kontext andere Karten nicht verschluckt.
  if(/pickpocket|taschendieb/.test(h))return"Taschendiebstahl";
  if(/invisible|unsicht/.test(h))return"Unsichtbar";
  if(/retterschnaps|save|speichern/.test(h))return"Speichern";
  if(/heal|heil/.test(h))return"Heilen";
  if(/wash|wasch/.test(h))return"Waschen";
  if(/money|groschen|geld/.test(h))return"Groschen";
  if(/hunger|sättigung|saettigung|sattheit/.test(h))return"Sättigung";
  if(/exhaust|energie/.test(h))return"Energie";
  if(/lockpick|schloss/.test(h))return"Schlösser";
  if(/schmiede|schneider|schuster|reparatur|rüstungsset|ruestungsset/.test(h))return"Reparatur";
  return"Alle";
}
function skillSub(rec){
  const h=blob(rec);
  const strong=norm([displayRecordName(rec),rawGroup(rec),primaryCommand(rec),rec.cheat,field(rec,"Unterkategorie"),field(rec,"Skill"),field(rec,"Attribut")].join(" "));
  if(/prestige|(?:^|[^a-z])xp(?:[^a-z]|$)|erfahrung/.test(h))return"XP/Prestige";
  if(/lesen|lernen|reading|skillbook|buch/.test(h))return"Lesen/Lernen";
  // Der allgemeine Abschnittsname „Attribute & Skills“ darf nicht alle Skills zu Attributen machen.
  if(/(?:^|[^a-z])(strength|staerke|starke|agility|agilitaet|vitality|vitalitaet|speech|rede)(?:[^a-z]|$)/.test(strong))return"Attribute";
  return"Skills";
}
function buffSub(rec){const h=blob(rec); if(/ausdauer|stamina|energie|exhaust/.test(h))return"Ausdauer/Energie"; if(/hunger/.test(h))return"Hunger"; if(/verletz|injur|bleed/.test(h))return"Verletzungen"; if(/invisible|unsicht/.test(h))return"Unsichtbar"; if(/horse|pferd|dog|koeter|köter/.test(h))return"Pferd/Köter"; return"Heilung";}
function workshopSub(rec){const h=blob(rec); if(/fehlgeschlagen|fail|failed/.test(h))return"Fehlgeschlagen"; if(/ramon|getestet|confirmed|bestätigt|bestaetigt/.test(h))return"getestet"; if(/raw|log|uuid/.test(h))return"Raw/Log"; if(/suchbefehl|search/.test(h))return"Suchbefehle"; return"Prüfen";}
function diceSub(rec){
  return safe(rec&&rec.compass_group || rec&&rec.group || diceGroups(rec)[0] || "Spezial & Risiko");
}
function allSub(rec){const h=blob(rec); if(primaryCommand(rec))return"Cheats/Befehle"; if(/rüstung|ruestung|waffe|schwert|helm|bogen|trank|potion/.test(h))return"Ausrüstung"; if(/buch|book|rezept|recipe|skillbook/.test(h))return"Bücher/Rezepte"; if(/set|loadout|outfit/.test(h))return"Sets"; if(/prüfen|pruefen|ramon|getestet|fehlgeschlagen|teilpositiv/.test(h))return"Prüfstatus"; if(/http|guide|video|lb-|hilfe/.test(h))return"Quellen/Guides"; return"Alle Daten";}

function subKey(rec){
  const mk=mainKey(rec);
  if(mk==="weapons")return weaponSub(rec);
  if(mk==="armor")return armorSub(rec);
  if(mk==="potions")return potionSub(rec);
  if(mk==="recipes")return recipeSub(rec);
  if(mk==="materials")return materialSub(rec);
  if(mk==="food")return foodSub(rec);
  if(mk==="books")return bookSub(rec);
  if(mk==="sets")return setSub(rec);
  if(mk==="dice")return diceSub(rec);
  if(mk==="quests")return questSub(rec);
  if(mk==="resources")return resourcesSub(rec);
  if(mk==="animals")return animalSub(rec);
  if(mk==="quick")return quickSub(rec);
  if(mk==="skills")return skillSub(rec);
  if(mk==="buffs")return buffSub(rec);
  return workshopSub(rec);
}


function isEurogamerJunk(rec){
  const h = blob(rec);
  return /skip to main content|einloggen|account anlegen|community\/auth|\/community\/auth|auth\/start|login|registrieren/.test(h);
}

function resourceKind(rec){
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec)), h=blob(rec);
  if(isEurogamerJunk(rec)) return "JUNK";
  if(safe(rec&&rec.kind)==="hos_external_alchemy_resource") return "ALCHEMY_TOOL";
  if(/youtube|youtu\.be|video/.test(h) || /video-guides/.test(s)) return "VIDEO";
  if(/karten\s*&\s*fundorte|karten|fundorte/.test(s) && /http|karte|map|fundort/.test(h)) return "KARTE";
  if(/mapgenie|interaktive karte|interactive map|karte interaktiv|fundortkarte/.test(h)) return "KARTE";
  if(/eurogamer|https?:\/\/www\.eurogamer/.test(h)) return "ONLINE";
  if(/lb-|loesungsbuch|lösungsbuch|pdf|spielgrundlage|lb-kampf|lb-ruestung|lb-rüstung|lb-alchemie|lb-schmiede|lb-kraeuter|lb-kräuter|lb-tipps/.test(s+" "+g+" "+h)) return "OFFLINE";
  if(/nebenquest|hauptquest|questlösung|questloesung|alle quests|alle hauptquests|alle nebenquests|tödlicher pinselstrich|toedlicher pinselstrich/.test(h)) return "QUEST";
  if(/http/.test(h)) return "ONLINE";
  return "OFFLINE";
}

function eurogamerBucket(rec){
  const h = blob(rec);
  if(isEurogamerJunk(rec)) return "Ausgeblendet";
  if(/alle hauptquests|hauptquests|\bhauptquest\b|main quests|#section-3/.test(h)) return "Eurogamer Hauptquests";
  if(/alle nebenquests|nebenquests|nebenquest|side quests|tödlicher pinselstrich|toedlicher pinselstrich|#section-4|nebenquests-und-wie-man/.test(h)) return "Eurogamer Nebenquests";
  if(/aufträge|auftraege|aktivitäten|aktivitaeten|activities|#section-5/.test(h)) return "Eurogamer Aktivitäten";
  if(/dlc|schmiede|forge|legacy of the forge/.test(h)) return "DLC/Schmiede";
  if(/hardcore|spezial|romanzen/.test(h)) return "Eurogamer Spezialthemen";
  if(/allgemeine tipps|tipps|guides|spielgrundlage|einsteiger|schnellreise|speichern|retterschnaps|geld verdienen|was man als einsteiger|#section-2/.test(h)) return "Eurogamer Tipps";
  return "Eurogamer Übersicht";
}

function resourcesSub(rec){
  const forcedSub=hosFinalAuditResourceSub(rec);
  if(forcedSub) return forcedSub;
  const k = resourceKind(rec);
  if(k === "JUNK") return "Ausgeblendet";
  if(k === "ALCHEMY_TOOL") return "Alchemie-Tools";
  if(k === "ONLINE") return eurogamerBucket(rec);
  if(k === "KARTE") return /fundort|location|karte|map/.test(blob(rec)) ? "Fundorte/Karten" : "Interaktive Karten";
  if(k === "VIDEO") return "Video-Guides";
  if(k === "OFFLINE") return "Offline-Kodex";
  if(k === "QUEST") return eurogamerBucket(rec);
  return "Alle Quellen";
}

function resourceSortWeight(rec){
  const sub = resourcesSub(rec);
  const h = blob(rec);
  let w = 100;
  if(sub==="Eurogamer Übersicht") w=10;
  if(sub==="Eurogamer Tipps") w=20;
  if(sub==="Eurogamer Hauptquests") w=30;
  if(sub==="Eurogamer Nebenquests") w=40;
  if(sub==="Eurogamer Aktivitäten") w=50;
  if(sub==="Eurogamer Spezialthemen") w=60;
  if(sub==="DLC/Schmiede") w=65;
  if(sub==="Alchemie-Tools") w=66;
  if(sub==="Fundorte/Karten") w=68;
  if(sub==="Interaktive Karten") w=70;
  if(sub==="Video-Guides") w=80;
  if(sub==="Offline-Kodex") w=90;
  if(/tödlicher pinselstrich|toedlicher pinselstrich|alle hauptquests|alle nebenquests|allgemeine tipps/.test(h)) w-=5;
  return w;
}


function rawText(rec){
  const f=rec.fields||{};
  return [rec.name,rec.section,rec.group,rec.cheat,rec.info,rec.status,rec.source,rec.url,rec.kind,rec.sheet,...Object.keys(f),...Object.values(f)].map(safe).join(" ");
}
function parseNumberDE(v){
  const m=safe(v).replace(/\./g,"").replace(/,/g,".").match(/-?\d+(?:\.\d+)?/);
  return m ? Number(m[0]) : NaN;
}
function numericField(rec, keys){
  const f=rec.fields||{};
  for(const k of keys){
    if(safe(f[k]).trim()){
      const n=parseNumberDE(f[k]);
      if(Number.isFinite(n)) return n;
    }
  }
  return NaN;
}
function metricFromText(rec, names){
  const text=rawText(rec);
  for(const name of names){
    const re=new RegExp(name+"(?:schaden|schutz)?\\s*[:=]?\\s*(-?\\d+(?:[,.]\\d+)?)","i");
    const m=text.match(re);
    if(m){ const n=parseNumberDE(m[1]); if(Number.isFinite(n)) return n; }
  }
  return NaN;
}
function statusGroup(rec){
  const f=rec.fields||{};
  const t=norm([rec.status, f.Status, f.Datenstand, rec.source, rec.info].map(safe).join(" "));
  if(/fehlgeschlagen|failed|fail|funktioniert nicht|falsch/.test(t)) return "fehlgeschlagen";
  if(/teilpositiv|teil-positiv/.test(t)) return "teilpositiv";
  if(/spielstandsabhaengig|spielstandsabhängig|save-abhaengig|save abhängig/.test(t)) return "spielstandsabhängig möglich";
  if(/questrelevant|quest relevant/.test(t)) return "questrelevant";
  if(/humor|flair/.test(t)) return "Humor / Flair";
  if(/getestet/.test(t)) return "getestet";
  if(/pruefen|prüfen|unklar|offen|testen|test offen|id offen/.test(t)) return "prüfen";
  if(/bestaetigt|bestätigt|funktioniert/.test(t)) return "bestätigt";
  if(/ok_name|logdaten|datenbasiert|raw|roh|lb |loesungsbuch|lösungsbuch|pdf|quelle/.test(t)) return "datenbasiert";
  return "unklar";
}
function statusRank(rec){
  const g=statusGroup(rec);
  const map={"getestet":0,"bestätigt":1,"questrelevant":2,"datenbasiert":3,"Humor / Flair":4,"teilpositiv":5,"spielstandsabhängig möglich":6,"prüfen":7,"unklar":8,"fehlgeschlagen":9};
  return map[g] ?? 8;
}
function statusGroupClass(rec){
  const g=norm(statusGroup(rec));
  if(/ramon|getestet|bestätigt|bestaetigt|datenbasiert|questrelevant/.test(g)) return "ok";
  if(/fehlgeschlagen/.test(g)) return "bad";
  if(/prüfen|pruefen|unklar|teilpositiv|spielstands/.test(g)) return "warn";
  return "";
}
const SORT_METRICS = {
  weapons:[
    ["attack_desc","Stärkste zuerst"],["stab_desc","Stich hoch"],["slash_desc","Schlag hoch"],["blunt_desc","Wucht hoch"],["weight_asc","Gewicht niedrig"],["price_desc","Preis/Wert hoch"]
  ],
  armor:[
    ["protect_desc","Schutz hoch"],["charisma_desc","Charisma hoch"],["noise_asc","Geräusch niedrig"],["visibility_asc","Sichtbarkeit niedrig"],["conspicuous_asc","Auffälligkeit niedrig"],["weight_asc","Gewicht niedrig"],["price_desc","Preis/Wert hoch"]
  ],
  animals:[["protect_desc","Schutz hoch"],["weight_asc","Gewicht niedrig"],["price_desc","Preis/Wert hoch"]],
  food:[["nourishment_desc","Nahrung hoch"],["energy_desc","Energie hoch"],["health_desc","Gesundheit hoch"],["alcohol_desc","Alkohol hoch"],["weight_asc","Gewicht niedrig"],["price_desc","Preis/Wert hoch"]],
  potions:[["duration_desc","Dauer hoch"],["health_desc","Wirkung/Gesundheit hoch"],["price_desc","Preis/Wert hoch"],["weight_asc","Gewicht niedrig"]],
  materials:[["price_desc","Preis/Wert hoch"],["weight_asc","Gewicht niedrig"]],
  skills:[["level_desc","Stufe hoch"]],
  buffs:[["duration_desc","Dauer hoch"]]
};
function sortValue(rec, key){
  if(key==="attack_desc") return numericField(rec,["Angriff","Schaden","Schutz/Wert"]);
  if(key==="stab_desc") return metricFromText(rec,["Stich"]);
  if(key==="slash_desc") return metricFromText(rec,["Schlag"]);
  if(key==="blunt_desc") return metricFromText(rec,["Wucht"]);
  if(key==="protect_desc") return numericField(rec,["Schutz/Wert","Schutz","Verteidigung"]);
  if(key==="charisma_desc") return numericField(rec,["Charisma"]);
  if(key==="noise_asc") return numericField(rec,["Geräusch","Geraeusch"]);
  if(key==="visibility_asc") return numericField(rec,["Sichtbarkeit"]);
  if(key==="conspicuous_asc") return numericField(rec,["Auffälligkeit","Auffaelligkeit"]);
  if(key==="weight_asc") return numericField(rec,["Gewicht"]);
  if(key==="nourishment_desc") return numericField(rec,["Nahrung","Nourishment"]);
  if(key==="energy_desc") return numericField(rec,["Energie","Energy"]);
  if(key==="health_desc") return numericField(rec,["Gesundheit","Health"]);
  if(key==="alcohol_desc") return numericField(rec,["Alkohol","Alcohol"]);
  if(key==="price_desc") return numericField(rec,["Preis ca.","Preis","Wert"]);
  if(key==="duration_desc") return numericField(rec,["Dauer","Wirkdauer","Zeit","Duration"]);
  if(key==="level_desc") return numericField(rec,["Stufe","Level","Fertigkeitsstufe"]);
  return NaN;
}
function originalIndex(rec){ return Number.isFinite(rec&&rec.__idx) ? rec.__idx : Number.MAX_SAFE_INTEGER; }
function compareName(a,b){ return safe(a.name).localeCompare(safe(b.name),"de",{sensitivity:"base",numeric:true}); }

const HOS_MAIN_STANDARD_ORDER = MAIN_NAV.filter(n=>n.key!=="all").map(n=>n.key);
const HOS_STATUS_OPTIONS = [
  {value:"all",label:"Alle Status"},
  {value:"safe",label:"Bestätigt / sicher"},
  {value:"review",label:"Prüfen / offen"},
  {value:"failed",label:"Fehlgeschlagen"}
];
const HOS_VIEW_OPTIONS = [["cards","Karten"]];
function statusFilterBucket(rec){
  const g=statusGroup(rec);
  if(g==="fehlgeschlagen") return "failed";
  if(g==="getestet"||g==="bestätigt"||g==="questrelevant"||g==="datenbasiert") return "safe";
  return "review";
}
function statusMatches(rec,key=state.status){ return !key||key==="all"||statusFilterBucket(rec)===key; }
function mainOrderIndex(rec){
  const key=rec&&rec.__main||"workshop";
  const i=HOS_MAIN_STANDARD_ORDER.indexOf(key);
  return i<0?HOS_MAIN_STANDARD_ORDER.length+1:i;
}
function orderSubLabel(rec,mainKeyValue){
  if(mainKeyValue==="animals") return animalSub(rec);
  return safe(rec&&rec.__sub||"");
}
function subOrderIndex(rec,mainKeyValue){
  const ordered=SUBFILTERS[mainKeyValue]||[];
  const label=orderSubLabel(rec,mainKeyValue);
  const i=ordered.indexOf(label);
  return i<0?ordered.length+1:i;
}
function meaningfulStandardCompare(a,b){
  if(state.main==="all"){
    const mainDelta=mainOrderIndex(a)-mainOrderIndex(b);
    if(mainDelta) return mainDelta;
    const key=a.__main||"workshop";
    const subDelta=subOrderIndex(a,key)-subOrderIndex(b,key);
    if(subDelta) return subDelta;
  }else{
    if(state.main==="dice") return originalIndex(a)-originalIndex(b);
    if(state.main==="quick"){
      const quickDelta=(HOS_PLAYER_QUICK_FINAL_RANK.get(safe(a&&a.id))??Number.MAX_SAFE_INTEGER)-(HOS_PLAYER_QUICK_FINAL_RANK.get(safe(b&&b.id))??Number.MAX_SAFE_INTEGER);
      if(quickDelta) return quickDelta;
    }
    const subDelta=subOrderIndex(a,state.main)-subOrderIndex(b,state.main);
    if(subDelta) return subDelta;
  }
  const activeMain=state.main==="all"?(a&&a.__main):state.main;
  if((activeMain==="potions"||activeMain==="recipes") && a&&b&&a.__main===b.__main){
    const alchemyDelta=hosAlchemyV4Compare(a,b);
    if(alchemyDelta) return alchemyDelta;
  }
  return originalIndex(a)-originalIndex(b);
}
function currentSortLabel(){
  const opt=sortOptionsForCurrent(selectionBase()).find(([key])=>key===state.sort);
  return opt?opt[1]:"Sinnvolle Reihenfolge";
}
function currentStatusLabel(){
  return (HOS_STATUS_OPTIONS.find(opt=>opt.value===state.status)||HOS_STATUS_OPTIONS[0]).label;
}
function sortOptionsForCurrent(list){
  const selected=Array.isArray(list)?list:selectionBase();
  const options=[["standard","Sinnvolle Reihenfolge"],["name","Name A–Z"],["name_desc","Name Z–A"]];
  const metricDefs=SORT_METRICS[state.main]||[];
  metricDefs.forEach(def=>{
    if(selected.some(rec=>Number.isFinite(sortValue(rec,def[0])))) options.push(def);
  });
  return options;
}
function hosV151PinAlchemyBuddyFirst(list){
  if(state.main!=="resources") return list;
  const index=list.findIndex(rec=>safe(rec&&rec.id)===HOS_V151_ALCHEMY_BUDDY_ID);
  if(index<=0) return list;
  const out=list.slice();
  const pinned=out.splice(index,1)[0];
  out.unshift(pinned);
  return out;
}
function applySorting(list){
  const options=sortOptionsForCurrent(list);
  if(!options.some(([key])=>key===state.sort)) state.sort="standard";
  const key=state.sort||"standard";
  const arr=list.slice();
  if(key==="standard") return hosV151PinAlchemyBuddyFirst(arr.sort(meaningfulStandardCompare));
  if(key==="name") return hosV151PinAlchemyBuddyFirst(arr.sort((a,b)=>compareName(a,b)||originalIndex(a)-originalIndex(b)));
  if(key==="name_desc") return hosV151PinAlchemyBuddyFirst(arr.sort((a,b)=>compareName(b,a)||originalIndex(a)-originalIndex(b)));
  if(key==="status") return hosV151PinAlchemyBuddyFirst(arr.sort((a,b)=>statusRank(a)-statusRank(b)||originalIndex(a)-originalIndex(b)));
  const asc=/_asc$/.test(key);
  return hosV151PinAlchemyBuddyFirst(arr.sort((a,b)=>{
    const av=sortValue(a,key), bv=sortValue(b,key);
    const am=Number.isFinite(av), bm=Number.isFinite(bv);
    if(am&&bm){
      const delta=asc ? av-bv : bv-av;
      return delta||originalIndex(a)-originalIndex(b);
    }
    if(am&&!bm) return -1;
    if(!am&&bm) return 1;
    return originalIndex(a)-originalIndex(b);
  }));
}
function displayDedupeKey(rec,mainKeyValue=state.main){
  const name = norm(displayRecordName(rec)||rec.name||"").replace(/[^a-z0-9]+/g," ").trim();
  if(!name) return "";
  const cmd = norm(primaryCommand(rec)).replace(/\s+/g," ").trim();
  const main=mainKeyValue||rec.__main||"";
  if(main==="books" && cmd) return "books|"+cmd;
  if(main==="sets"){
    if(safe(rec.kind)==="hos_set_member_patch") return "set-member|"+norm(field(rec,"Set-Familie"))+"|"+(cmd||name);
    if(/^set(?:ordner|outfit|-)/.test(norm(rec.id))) return "set-anchor|"+norm(rec.id);
    return "sets|"+name+"|"+(cmd||safe(rec.__sub));
  }
  if(main==="skills" && cmd) return "skills|"+name+"|"+cmd;
  if((main==="weapons" || main==="armor" || main==="animals" || main==="food") && cmd){
    return main+"|"+name+"|"+cmd;
  }
  if(main==="weapons" || main==="armor" || main==="food" || main==="books") return main+"|"+name+"|"+(rec.__sub||"");
  return "";
}
function dedupeForDisplay(list,mainKeyValue=state.main){
  const main=mainKeyValue||state.main;
  if(main==="potions"||main==="recipes"){
    return hosAlchemyV5DedupeExactCommands(list,main);
  }
  if(!["weapons","armor","animals","food","books","sets","skills"].includes(main)) return list;
  const out=[]; const seen=new Set();
  for(const rec of list){
    const key=displayDedupeKey(rec,main);
    if(key && seen.has(key)) continue;
    if(key) seen.add(key);
    out.push(rec);
  }
  return out;
}
function customSelectHtml(id,label,icon,options,value,disabled=false){
  const normalized=options.map(opt=>Array.isArray(opt)?{value:opt[0],label:opt[1],meta:""}:opt);
  const current=normalized.find(opt=>opt.value===value)||normalized[0]||{value:"",label:"–",meta:""};
  const iconHtml=/^(?:\.\.?\/)/.test(safe(icon))?`<img src="${esc(icon)}" alt="">`:esc(icon);
  return `<div class="hos-register-select-control hos-custom-select ${disabled?"is-disabled":""}" data-hos-dropdown="${esc(id)}">
    <span class="hos-register-control-icon" aria-hidden="true">${iconHtml}</span>
    <span class="hos-register-control-label">${esc(label)}</span>
    <button type="button" class="hos-custom-select-trigger" id="hos-${esc(id)}-trigger" aria-haspopup="listbox" aria-expanded="false" ${disabled?"disabled":""}>
      <span class="hos-custom-select-value"><span>${esc(current.label)}</span>${current.meta?`<small>${esc(current.meta)}</small>`:""}</span><span class="hos-custom-select-arrow" aria-hidden="true">▾</span>
    </button>
    <div class="hos-custom-select-menu" id="hos-${esc(id)}-menu" role="listbox" aria-labelledby="hos-${esc(id)}-trigger">
      <div class="hos-custom-select-scroll">${normalized.map(opt=>`<button type="button" class="hos-custom-select-option ${opt.value===value?"active":""}" role="option" aria-selected="${opt.value===value?"true":"false"}" data-value="${esc(opt.value)}"><span>${esc(opt.label)}</span>${opt.meta?`<small>${esc(opt.meta)}</small>`:""}<i aria-hidden="true">✓</i></button>`).join("")}</div>
    </div>
  </div>`;
}
function sortControlHtml(list){
  const opts=sortOptionsForCurrent(list);
  if(!opts.some(([key])=>key===state.sort)) state.sort="standard";
  return customSelectHtml("sort","Sortierung","⇅",opts,state.sort,opts.length<=1);
}


/* =====================================================================
   TEST25_32 – LOGIK-/SORTIERPATCH
   - f116_data.js bleibt unverändert.
   - Setkarten werden ausschließlich aus den gepflegten „Enthält“-Listen
     der bestätigten Setanker erzeugt; keine Volltextsuche über die App.
   - Schmiedesatz: alter belegter Arbeitsstand; bevorzugter runder roter Hut
     bleibt als offener Altstand-Hinweis dokumentiert und wird nicht geraten.
   ===================================================================== */
const HOS_PATCH_SET_FAMILIES=["Schleich-Set","Legaten","Brunswiek/Löwenwappen","Jägermeister","Wanderer","Taschendieb","Schmiede-Set"];
const HOS_PATCH_SET_ANCHORS={
  "Brunswiek/Löwenwappen":"set-brunswiek-loewenwappen-v09",
  "Legaten":"setordner-legaten-v0114",
  "Jägermeister":"setoutfit-jaegermeister-komplett-v0124f",
  "Wanderer":"setoutfit-wanderer-komplett-public-v0124f",
  "Taschendieb":"setordner-taschendiebs-v0114",
  "Schmiede-Set":"hos-komplettset-schmiede-test25-32"
};
const HOS_PATCH_SMITH_ANCHOR={
  id:"hos-komplettset-schmiede-test25-32", section:"Komplettsets", sheet:"TEST25_32 app.js Patch", icon:"⚒",
  name:"Heinrichs Kuttenberger Schmiedesatz", group:"Schmiede-Set / Outfit-Kompass", cheat:"",
  info:"Wiederhergestellter Schmiede-Outfitanker aus dem belegten Altstand. Materialien, Anleitungen und Waffen gehören nicht in dieses Outfit.",
  status:"Altstand belegt; Kopfteil Arbeitstuch belegt. Später bevorzugter runder vermutlich roter Hut bleibt bis zum ID-Abgleich offen.",
  source:"v0.12.5f92 Screenshot/Altstand + Bestätigung 18.07.2026", kind:"hos_set_anchor_patch",
  fields:{
    "Set-Familie":"Schmiede-Set","Set-Typ":"HeinrichOS-Komplettset / Schmiede-Outfit",
    "Enthält":"- Wappenrock von Heinrichs Schmiede (Oberkörper) — wh_cheat_addItem Waffenrock09_mPros\n- Heinrichs Schmiedeschürze (Oberkörper / Schürze) — wh_cheat_addItem TunicShort05_mPros\n- Heinrichs Schmiedehandschuhe (Hände) — wh_cheat_addItem Gloves05_mPros\n- Arbeitstuch für den Kopf (Kopf; älterer belegter Stand) — wh_cheat_addItem Cap11_m06_D\n- Arbeitsstiefel (Schuhe) — wh_cheat_addItem BootsAnkle01_m01_C\n- Gesteppte Hose – dunkel (Beine) — wh_cheat_addItem LegsPadded01_m08_C3",
    "Alle Cheats einzeln":"wh_cheat_addItem Waffenrock09_mPros\nwh_cheat_addItem TunicShort05_mPros\nwh_cheat_addItem Gloves05_mPros\nwh_cheat_addItem Cap11_m06_D\nwh_cheat_addItem BootsAnkle01_m01_C\nwh_cheat_addItem LegsPadded01_m08_C3",
    "Kopfteil-Hinweis":"Der später bevorzugte runde, vermutlich rote Hut wird erst nach sicherem Altstand-/ID-Beleg eingesetzt; keine ID geraten.",
    "Block-Regel":"Nur Outfitteile. Keine Schmiedematerialien, Schmiedeanleitungen oder Schwerter."
  }
};
if(!RECORDS.some(r=>safe(r.id)===HOS_PATCH_SMITH_ANCHOR.id)) RECORDS.push(HOS_PATCH_SMITH_ANCHOR);
function hosPatchSetLines(raw){ return safe(raw).split(/\r?\n|\\r?\\n/).map(s=>s.trim()).filter(Boolean); }
function hosPatchSetItems(anchor,family){
  const raw=field(anchor,"Enthält")||field(anchor,"Enthaelt");
  return hosPatchSetLines(raw).map((line,index)=>{
    const clean=line.replace(/^[-•]\s*/,"");
    const match=clean.match(/wh_cheat_addItem\s+[^\s]+/i);
    const command=match?match[0].trim():"";
    const before=clean.split(/\s+—\s+/)[0].trim();
    const name=before.replace(/\s*\([^)]*\)\s*$/,"").trim()||`Setteil ${index+1}`;
    const slotMatch=before.match(/\(([^)]*)\)\s*$/);
    return {name,command,slot:slotMatch?slotMatch[1]:"Setteil"};
  }).filter(item=>item.command);
}
function hosPatchBuildSetMemberRecords(){
  const out=[];
  Object.entries(HOS_PATCH_SET_ANCHORS).forEach(([family,id])=>{
    const anchor=RECORDS.find(r=>safe(r.id)===id);
    if(!anchor) return;
    hosPatchSetItems(anchor,family).forEach((item,index)=>{
      const commandKey=norm(item.command).replace(/\s+/g," ").trim();
      const sourceRecord=RECORDS.filter(r=>safe(r.kind)!=="hos_set_member_patch" && norm(primaryCommand(r)).replace(/\s+/g," ").trim()===commandKey)
        .sort((a,b)=>{
          const score=r=>{
            const mk=mainKey(r);
            const categoryBonus=["armor","weapons","recipes","materials"].includes(mk)?100:(mk==="sets"?20:0);
            const valueKeys=["Angriff","Schaden","Schutz/Wert","Schutz","Verteidigung","Stich","Schlag","Schnitt","Wucht","Charisma","Sichtbarkeit","Geräusch","Geraeusch","Gewicht","Preis ca.","Preis","Wert"];
            const values=valueKeys.filter(k=>safe(field(r,k)).trim()).length;
            return categoryBonus+values*20+Object.keys(r.fields||{}).length;
          };
          return score(b)-score(a);
        })[0]||null;
      const inherited=sourceRecord?Object.assign({},sourceRecord):{};
      const inheritedFields=sourceRecord?Object.assign({},sourceRecord.fields||{}):{};
      out.push(Object.assign(inherited,{
        id:`hos-set-member-${norm(family).replace(/[^a-z0-9]+/g,"-")}-${String(index+1).padStart(2,"0")}`,
        section:"Sets / Loadouts", sheet:"TEST25_32 Setlogik-Patch", icon:safe(sourceRecord&&sourceRecord.icon)||"🎒", name:item.name, group:family,
        cheat:item.command, info:safe(sourceRecord&&sourceRecord.info)||`Exaktes Mitglied von ${family}; aus dem gepflegten Setanker übernommen.`,
        status:safe(sourceRecord&&sourceRecord.status)||safe(anchor.status)||"Setanker geprüft",
        source:safe(sourceRecord&&sourceRecord.source)||safe(anchor.source)||safe(anchor.sheet), kind:"hos_set_member_patch",
        fields:Object.assign(inheritedFields,{"Set-Familie":family,"Set":family,"Slot/Rolle":item.slot,"Cheat zum Kopieren":item.command,"Ursprungsanker":id,"Patch-Regel":"Keine Volltextzuordnung; exakte Ankerliste."})
      }));
    });
  });
  return out;
}
const HOS_PATCH_SET_MEMBER_RECORDS=hosPatchBuildSetMemberRecords();
RECORDS.push(...HOS_PATCH_SET_MEMBER_RECORDS);


/* =====================================================================
   HEINRICHOS KCD2 – TEST25_33 ALCHEMIE FINAL (freigegeben 19.07.2026)
   - 82 vollständig belegte Trank-/Giftzeilen: reine Zusatzfelder
   - 18 offene Sonder-/Quest-/Aliaszeilen: ausschließlich sichtbarer Prüfstatus
   - 22 freigegebene Alchemie-Rezept-/Perkzeilen: reine Zusatzfelder
   - 9 offene/konfliktbehaftete Rezept-/Perkzeilen: unverändert
   - stabile Zielschlüssel: Befehl + interner Name + UUID bzw. Befehl + UUID
