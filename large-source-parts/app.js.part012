function hosPlayerQuickPatchRecord(rec){
  const patch=HOS_PLAYER_QUICK_PATCHES.get(safe(rec&&rec.id));
  if(!patch) return rec;
  return Object.assign({},rec,patch,{fields:Object.assign({},rec.fields||{},patch.fields||{})});
}
