function $(s){return document.querySelector(s);}
function $all(s){return Array.from(document.querySelectorAll(s));}
function $$(s){return $all(s);}
function safe(v){return v==null?"":String(v);}
function esc(v){return safe(v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"}[c]));}
function norm(v){return safe(v).toLowerCase().replace(/ä/g,"ae").replace(/ö/g,"oe").replace(/ü/g,"ue").replace(/ß/g,"ss");}

// TEST25_35_PLAYER_EDITION_SICHTBARKEIT_01:
// Interne Prüf-, Audit-, Quellen- und interne Vermerke bleiben in der geschützten
// Datenbasis erhalten, werden in der Player Edition aber weder angezeigt noch durchsucht.
const HOS_PLAYER_INTERNAL_TEXT_RE=/(?:\bramon\b|ramon[- ]?(?:test|getestet)|\bqc\b|audit|intern(?:e|er|es)?\b|save[- ]?kontext|spieltest|pruefstatus|prüfstatus|statusgruppe|datenstand|quellengeprueft|quellengeprüft|nicht\s+quellengeprueft|nicht\s+quellengeprüft|\bpruefen\b|\bprüfen\b|\bgeprueft\b|\bgeprüft\b|test\s+offen|id\s+offen|aliaspruefung|aliasprüfung|fehlgeschlagen|failed|datenbasiert|rohdaten|game[- ]?log)/i;
const HOS_PLAYER_INTERNAL_KEY_RE=/(?:ramon|qc|audit|intern|save[- ]?kontext|spieltest|pruef|prüf|statusregel|statusgruppe|datenstand|abgleich|patch[- ]?regel|kuratiert|uuid|rohname|rohdaten|modellpfad|ui[- ]?rohname|technisch|fehlt|befehl\s+pruefen|befehl\s+prüfen)/i;
function playerSafeText(value){
  const text=safe(value).replace(/\s+/g," ").trim();
  if(!text) return "";
  return HOS_PLAYER_INTERNAL_TEXT_RE.test(text)?"":text;
}
function playerFieldIsVisible(key,value){
  const rawKey=safe(key).trim();
  const keyNorm=norm(rawKey);
  const rawValue=safe(value).trim();
  if(!rawValue) return false;
  if(HOS_PLAYER_INTERNAL_KEY_RE.test(rawKey)) return false;
  if((/(^|[\s/()-])quelle(?:$|[\s/()-])/.test(keyNorm)||/^source$/.test(keyNorm)) && !/fundort/.test(keyNorm)) return false;
  if(/^status$/.test(keyNorm)) return !!playerSafeText(rawValue);
  return !!playerSafeText(rawValue);
}
function playerFieldEntries(rec){
  return Object.entries((rec&&rec.fields)||{}).filter(([key,value])=>playerFieldIsVisible(key,value));
}
function playerFieldValue(rec,key){
  const value=field(rec,key);
  return playerFieldIsVisible(key,value)?playerSafeText(value):"";
}

function field(rec,k){return safe((rec.fields||{})[k]);}
function blob(rec){
  const f=rec.fields||{};
  return norm([rec.name,rec.section,rec.group,rec.cheat,rec.info,rec.status,rec.source,rec.url,rec.kind,rec.sheet,...Object.keys(f),...Object.values(f)].join(" "));
}
function rawGroup(rec){ return safe(rec.group || field(rec,"Gruppe") || field(rec,"Bereich") || field(rec,"Kategorie") || field(rec,"Typ")); }
function rawSection(rec){ return safe(rec.section || field(rec,"Section") || field(rec,"Bereich")); }
function isDiceRecord(rec){
  return safe(rec&&rec.kind)==="dice_farkle" || norm(rawSection(rec))==="wuerfel / farkle-kompass";
}
function diceGroups(rec){
  const list=Array.isArray(rec&&rec.compass_groups)?rec.compass_groups:[];
  return list.map(safe).filter(Boolean);
}


function isExternalFoodSource(rec){ return safe(rec.kind)==="source_food" || safe(rec.sheet)==="Quelle_Fextralife_Food"; }
function isGameLogFoodSource(rec){ return safe(rec.kind)==="gamelog_food" || safe(rec.sheet)==="GameLog_Food_2026_06_11"; }
// TEST51 Sortierwächter: Quellen/Guides und Game-Log-Testbeutel dürfen nicht durch
// Wörter wie „Wein“, „Blut“, „Fleisch“, „Apfel“ usw. in normale Nahrung rutschen.
function isResourceGuideRecord(rec){
  if(isExternalFoodSource(rec) || isGameLogFoodSource(rec)) return false;
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec));
  const native=/^(schnellzugriff|suchbefehle|attribute & skills|attribute & fertigkeiten|buffs & zustaende|buffs & zustände|waffen|nahkampf|fernkampf|munition|ruestung|rüstung|outfit-werte|traenke|tränke|gifte|rezepte|nahrung & jagd|material|kraeuter|kräuter|skillbuecher|skillbücher|sets \/ loadouts|top-empfehlungen|komplettsets|pferd & koeter|pferd & köter|quests & belohnungen|karten & fundorte|werkstatt \/ pruefung|werkstatt \/ prüfung)$/;
  if(native.test(s)) return false;
  if(/^(hilfe & komplettloesung|hilfe & komplettlösung|video-guides)$/.test(s) || /^lb[- ]/.test(s)) return true;
  if(/eurogamer|mapgenie|interaktive karte|interactive map|online-link|quelle eurogamer|youtube|video-guide|pdf-loesungsbuch|pdf-lösungsbuch/.test(s+" "+g)) return true;
  const title=norm(displayRecordName(rec));
  return /^(guide|wegweiser|komplettloesung|komplettlösung|online-hilfe|loesungsbuch|lösungsbuch)/.test(title);
}
function isGameLogTestPlaceholder(rec){
  if(!isGameLogFoodSource(rec)) return false;
  const n=norm(rec.name || field(rec,"Name"));
  const h=blob(rec);
  return /ein verdaechtiger beutel|ui_nm_warning|ui_in_warning|trafficcone|_test\b|test_inventory_|test potion/.test(n+" "+h);
}
function foodName(rec){ return norm(rec.name || field(rec,"Name")); }
function isHorseGear(rec){
  const h=blob(rec);
  return /sattel|saddle|zaumzeug|\bzaum\b|bridle|hufeisen|horseshoe|schabracke|caparison|pferdeausruestung|pferdeausrüstung/.test(h);
}
function isKnownDogFood(rec){
  if(isAnimalExcluded(rec)) return false;
  const t=dogFoodText(rec), title=norm(displayRecordName(rec)), g=norm(rawGroup(rec));
  if(/^(hund|koter|koeter|köter|pferd|pebbles)$/.test(title) && !/futter|wurst|sausage|krakauer|fleisch|meat/.test(title+" "+g)) return false;
  if(/krakauer\s+sattel|warsaddle|\bsattel\b|\bsaddle\b/.test(t) && !/futter|hundefutter|koeter-futter|köter-futter|smoked sausage|geraeucherte krakauer|geräucherte krakauer/.test(t)) return false;
  return /29a4f58e-6e00-4f9c-9273-1a76e0eccff0|koeter-futter|köter-futter|hundefutter|futter fuer den hund|futter für den hund|geraeucherte krakauer|geräucherte krakauer|smoked sausage|dog food/.test(t);
}
function isFoodRelatedRecord(rec){
  // TEST51: echte Quellen/Guides zuerst aussperren; sonst landet z.B.
  // „Wein, Weib und Blut“ wegen „Wein“ in Nahrung & Jagd.
  if(isResourceGuideRecord(rec)) return false;
  // TEST51: Dev-/Warnbeutel aus dem Game-Log nicht als normale Nahrung einsortieren.
  if(isGameLogTestPlaceholder(rec)) return false;
  if(isExternalFoodSource(rec) || isGameLogFoodSource(rec)) return true;
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec)), h=blob(rec), n=foodName(rec);
  // Harte Ausschlüsse: Wortähnlichkeit darf keine falschen Nahrungstreffer erzeugen.
  if(/axt des fleischers|fleischerschuerze|fleischerschürze|haselnuss|hoefische|höfische|langschwert|schwert|bogen|helm|hundsgugel|sattel|warsaddle|katerbier|hair_o_dog|hairodog|potion|trank|rezept/.test(n+" "+h)){
    if(!isKnownDogFood(rec)) return false;
  }
  if(/nahrung|food|jagdbeute|koeter-futter|köter-futter/.test(s+" "+g)) return true;
  if(isKnownDogFood(rec)) return true;
  // Nur echte Nahrungsbegriffe, keine zufälligen Teilworte.
  if(/\b(brot|bread|apfel|apple|birne|pear|obst|fruit|gemuese|gemüse|karotte|carrot|kohl|cabbage|ruebe|rübe|turnip|beet|fisch|fish|trout|forelle|wurst|sausage|salami|speck|bacon|fleisch|meat|venison|wildbret|hase|hare|kaninchen|rabbit|ente|duck|schwein|pork|boar|rind|beef|kaese|käse|cheese|honig|honey|pilz|mushroom|suppe|soup|eintopf|broth|bier|beer|wein|wine|moonshine|wasser|water|kolach|pancake|bagel)\b/.test(n+" "+g)) return true;
  return false;
}
function foodSub(rec){
  if(isGameLogFoodSource(rec)) return field(rec,"Unterkategorie") || rawGroup(rec) || "Game-Log Nahrung";
  if(isKnownDogFood(rec)) return "Köter geeignet – prüfen";
  if(isExternalFoodSource(rec)){
    const n=foodName(rec);
    if(/smoked\s+sausage|sausage/.test(n)) return "Köter geeignet – prüfen";
  }
  const n=foodName(rec), h=blob(rec);
  if(isExternalFoodSource(rec) && !n) return "Fextralife Food-Quelle";
  if(/beer|bier|wine|wein|moonshine|water|wasser|alcohol|schnaps|vinegar/.test(n)) return "Getränke/Alkohol";
  if(/smoked|geraeuchert|geräuchert|sausage|wurst|salami|bacon|speck/.test(n)) return "Wurst/Geräuchertes";
  if(/meat|fleisch|venison|wildbret|hare|hase|rabbit|boar|schwein|pork|beef|rind|wolf|deer|roe|kidney|liver|tenderloin|rump|heart/.test(n)) return "Fleisch/Jagdbeute";
  if(/bread|brot|roll|bagel|pancake|kolach|pastry|cake/.test(n)) return "Brot/Gebäck";
  if(/apple|apfel|pear|birne|watermelon|melon|fruit|plum|cherry|berry|walnut|nuts/.test(n)) return "Obst";
  if(/cabbage|kohl|carrot|karotte|beet|turnip|ruebe|rübe|onion|garlic|vegetable/.test(n)) return "Gemüse";
  if(/trout|fish|fisch|crayfish/.test(n)) return "Fisch";
  if(/vorrat|trocknen|verkauf|trade|händler|haendler|kaufen/.test(h)) return "Vorrat/Verkauf";
  if(isExternalFoodSource(rec)) return "Fextralife Food-Quelle";
  return "Prüfen/Unsortiert";
}



function isStarterComfortRecord(rec){
  const s = norm(rawSection(rec));
  const g = norm(rawGroup(rec));
  const h = blob(rec);
  const setName = norm(field(rec,"Set") || field(rec,"Setname") || field(rec,"Loadout"));
  if(!/sets|loadouts|outfit|kompass/.test(s+" "+g+" "+setName+" "+h)) return false;
  // Starter-Komfort gehört in Schnellzugriff/Komfort, nicht in Outfit-Kompass.
  return /starter-komfort|komforttrank|schnellzugriff|bestätigter ramon-komforttrank|bestaetigter ramon-komforttrank|retterschnaps|ringelblum|katerbier|saviour|marigold|hair.*dog|feuer.*cursor|treffer.*cursor/.test(setName+" "+g+" "+h);
}

function isPotionMisfiledInSets(rec){
  const s = norm(rawSection(rec));
  const g = norm(rawGroup(rec));
  const h = blob(rec);
  const title = norm(displayRecordName(rec));
  const id = norm(rec && rec.id);
  const setName = norm(field(rec,"Set") || field(rec,"Setname") || field(rec,"Loadout") || field(rec,"Set-Familie"));
  const context = s+" "+g+" "+setName+" "+h;
  // TEST25_32: echte Outfit-/Setanker dürfen nicht wegen eines Humorhinweises
  // wie „Jägermeister-Schnaps“ in Tränke & Gifte umsortiert werden.
  if(safe(rec && rec.kind)==="hos_set_member_patch") return false;
  if(/setordner-jaegermeister|setoutfit-jaegermeister/.test(id)) return false;
  if(/^(komplettsets|sets \/ loadouts)$/.test(s) && /jaegermeister.*(?:set|outfit)|(?:set|outfit).*jaegermeister/.test(title+" "+setName)) return false;
  if(!/sets|loadouts|outfit|kompass|jaegermeister|wanderer|brunswiek|bruncvik|loewenwappen|taschendieb|schmiede-set/.test(context)) return false;
  return /trank|potion|gift|poison|schnaps|bier|aufguss|geist|wermut|fuchs|fux|fuchstrank|fuxtrank|retterschnaps|ringelblum|katerbier|bard|artemisia|saviour|marigold|hair.*dog|heilsud|sud/.test(h);
}

function isComfortPotionMisfiledInSets(rec){
  return isStarterComfortRecord(rec) || isPotionMisfiledInSets(rec);
}

function cleanCardHint(rec){
  let txt = safe(rec.info || rec.kind_label || rec.kind || rec.status || rec.source || "").trim();
  // Keine sichtbaren Befehle/UUIDs/IDs mitten auf der Karte.
  txt = txt.replace(/\b(?:wh_cheat_addItem|cheat_add_buff|cheat_add_perk|cheat_set_skill_level|cheat_add_skill_levels|#player\.[^\s]+)\b[^.\n;]*/gi, "").trim();
  txt = txt.replace(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/gi, "").trim();
  if(!txt || /^(wh_|cheat_|#)/i.test(txt)) txt = safe(rec.status || rec.source || rawGroup(rec) || "").trim();
  return txt;
}
function displaySubForCard(sub){
  const n = norm(sub);
  if(!sub) return "";
  if(n === "cheats/befehle" || n === "cheats befehle" || n === "alle daten") return "";
  return sub;
}


/* =====================================================================
   HEINRICHOS KCD2 – TEST25_34 FINAL-AUDIT GESAMTPATCH
   Reine Laufzeit-Zuordnung: f116_data.js bleibt unverändert.
   - 10 vorhandene Karten-/Wegweiser-Datensätze nach Lösungen & Karten
   - KCD3-/Warhorse-News aus der aktiven Nutzeransicht
   - bestehender Schmiede-PDF-Auszug zusätzlich am Online-Guide
   ===================================================================== */
const HOS_FINAL_AUDIT_RESOURCE_REMAP_IDS=new Set([
  "map-kuttenberg-de",
  "map-kuttenberg-wand",
  "map-kuttenberg-inara",
  "map-kuttenberg-mapgenie",
  "map-trosky-de",
  "map-trosky-wand",
  "map-trosky-inara",
  "map-trosky-mapgenie",
  "map-gamestar-filter-erklaert",
  "quest-hub-eurogamer-v09"
]);
const HOS_FINAL_AUDIT_HIDDEN_IDS=new Set(["eurogamer-208"]);
const HOS_FINAL_AUDIT_LINKED_PDF_IDS=new Set(["eurogamer-51"]);
function hosFinalAuditResourceSub(rec){
  const id=safe(rec&&rec.id);
  if(id==="quest-hub-eurogamer-v09") return "Wegweiser";
  if(/^(?:map-(?:kuttenberg|trosky)-(?:inara|mapgenie))$/.test(id)) return "Interaktive Karten";
  if(HOS_FINAL_AUDIT_RESOURCE_REMAP_IDS.has(id)) return "Fundorte/Karten";
  return "";
}
function hosFinalAuditHasLinkedPdf(rec){
  return HOS_FINAL_AUDIT_LINKED_PDF_IDS.has(safe(rec&&rec.id));
}

const HOS_ALCHEMY_V6_HERB_COMMANDS=new Set([
  "wh_cheat_additem herb_urticaria",
  "wh_cheat_additem herb_comfrey",
  "wh_cheat_additem herb_dried_dandelion",
  "wh_cheat_additem herb_dried_hypericum",
  "wh_cheat_additem herb_dried_mint",
  "wh_cheat_additem herb_dried_salvia"
]);
function hosAlchemyV6Command(rec){
  return norm(hosAlchemyV3Command(rec)||primaryCommand(rec)||rec&&rec.cheat||"").replace(/\s+/g," ").trim();
}
function hosAlchemyV6IsHerbMaterial(rec){
  const cmd=hosAlchemyV6Command(rec);
  const group=norm(rawGroup(rec));
  const section=norm(rawSection(rec));
  return HOS_ALCHEMY_V6_HERB_COMMANDS.has(cmd)
    || /^(kraut\/zutat|kraeuter|kräuter|alchemiezutat)$/.test(group)
    || (/^sets \/ loadouts$/.test(section) && /kraut|zutat|herb/.test(group));
}

function mainKey(rec){
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec));
  const title=norm(displayRecordName(rec));
  const command=norm(primaryCommand(rec)||rec.cheat||"");
  const core=norm([title,g,command,rec.kind,rec.sheet].join(" "));

  if(isDiceRecord(rec)) return "dice";
  if(rec&&rec.__hosAlchemyV3Status) return "potions";
  if(rec&&rec.__hosAlchemyV3RecipeReady) return "recipes";
  if(rec&&rec.__hosAlchemyPhysicalRecipe) return "recipes";
  if(hosAlchemyV6IsHerbMaterial(rec)) return "materials";
  if(HOS_FINAL_AUDIT_RESOURCE_REMAP_IDS.has(safe(rec&&rec.id))) return "resources";

  const sourceTab=norm(field(rec,"Reiter")||field(rec,"Originalbereich")||"");
  // TEST51-Abgleich + Quellenliste: Der vollständige Skillbuch-Bestand liegt im QC-Reiter 11_Skillbuecher.
  // Diese echten Buch-Items müssen vor der Werkstatt-Quarantäne in Bücher einsortiert werden.
  if(/(^|[^0-9])11[_ -]?skillbuecher|(^|[^0-9])11[_ -]?skillbücher/.test(sourceTab) || /(?:^|[^a-z])skillbook[_:.-]/.test(command)) return "books";
  if(isGameLogTestPlaceholder(rec)) return "workshop";
  if(/werkstatt \/ pruefung|werkstatt \/ prüfung|cheat-id-check|qc \/ pruefung|qc \/ prüfung/.test(s+" "+g)) return "workshop";
  if(/^schnellzugriff$|^suchbefehle$/.test(s)) return "quick";
  if(/^(attribute & skills|attribute & fertigkeiten)$/.test(s)) return "skills";
  if(/^buffs & zustaende$|^buffs & zustände$/.test(s)) return "buffs";
  if(/^(waffen|nahkampf|fernkampf|munition)$/.test(s)) return "weapons";
  if(/^(ruestung|rüstung|outfit-werte)$/.test(s)) return "armor";
  if(/^(traenke|tränke|gifte)$/.test(s)) return "potions";
  if(/^rezepte$/.test(s)) return "recipes";
  if(/^nahrung & jagd$/.test(s)){
    if(/traenke|tränke|medizinisch|potion/.test(g)) return "potions";
    return "food";
  }
  if(/^(material|kraeuter|kräuter)$/.test(s)) return "materials";
  if(/^skillbuecher$|^skillbücher$/.test(s)) return "books";
  if(/^pferd & koeter$|^pferd & köter$/.test(s)) return "animals";
  if(/^(quests & belohnungen|karten & fundorte)$/.test(s)) return "quests";
  if(/^(hilfe & komplettloesung|hilfe & komplettlösung|video-guides)$/.test(s) || /^lb[- ]/.test(s)) return "resources";

  if(/^(sets \/ loadouts|top-empfehlungen|komplettsets)$/.test(s)){
    if(isStarterComfortRecord(rec)) return "quick";
    if(isPotionMisfiledInSets(rec)) return "potions";
    return "sets";
  }

  if(isResourceGuideRecord(rec)) return "resources";
  if(isStarterComfortRecord(rec)) return "quick";
  if(isPotionMisfiledInSets(rec)) return "potions";
  if(isFoodRelatedRecord(rec)) return "food";

  if(/longsword|shortsword|schwert|axt|axe|bogen|bow|armbrust|crossbow|munition|pfeil|bolzen|speer|stangenwaffe|hammer|knueppel|knüppel|schild/.test(core)) return "weapons";
  if(/helm|kopf|kappe|hut|gugel|kapuze|kettenhaube|brust|cuirass|handschuhe|bein|schuhe|stiefel|schmuck|ring|ruestung|rüstung/.test(core)) return "armor";
  if(/potion|trank|gift|poison/.test(core)) return "potions";
  if(/recipe|rezept/.test(core)) return "recipes";
  if(/skillbook|skillbuch/.test(core)) return "books";
  if(/quest|fundort|karte/.test(core)) return "quests";
  if(/pferd|horse|hund|dog|hound|koeter|köter/.test(core)) return "animals";
  return "workshop";
}

function weaponSub(rec){
  const g=norm(rawGroup(rec)), t=norm(rec.name||field(rec,"Name")), cmd=norm(primaryCommand(rec)||rec.cheat||"");
  const tc=t+" "+cmd;
  // Interne Itemcodes sind für die Waffenart verlässlicher als ein verkürzter deutscher Titel.
  if(/huntingsword|falchion/.test(cmd) || /jagdschwert|falchion/.test(t)) return "Jagdschwerter/Falchions";
  if(/longsword/.test(cmd)) return "Langschwerter";
  if(/shortsword/.test(cmd)) return "Kurzschwerter/Schwerter";
  if(/^(?:.*\s)?wh_cheat_additem\s+mace/i.test(primaryCommand(rec)||"") || /streitkolben|keule|knueppel|knüppel|morgenstern/.test(t)) return "Streitkolben/Keulen";
  if(/excalibur|durendal|langschwert|duellierlangschwert|heinrich.*schwert|menhard.*schwert|meinhard.*schwert|lenhard.*schwert/.test(tc)) return "Langschwerter";
  if(/kurzschwert/.test(t)) return "Kurzschwerter/Schwerter";
  if(/saebel|sabel|säbel|saber/.test(tc)) return "Säbel";
  if(/dolch|messer|dagger|knife/.test(tc)) return "Dolche/Messer";
  if(/armbrust|crossbow/.test(tc)) return "Armbrüste";
  if(/(^|[^a-z])bogen([^a-z]|$)|langbogen|jagdbogen|(^|[^a-z])bow([^a-z]|$)/.test(tc)) return "Bögen";
  if(/pfeil|arrow/.test(tc)) return "Pfeile";
  if(/bolzen|bolt/.test(tc)) return "Bolzen";
  if(/schiessbuechse|schussbuechse|donnerbuechse|handkanone|pistole|feuerwaffe|arquebus|arkebuse|musket|hookgun/.test(tc)) return "Feuerwaffen";
  if(/schild|shield/.test(tc)) return "Schilde";
  if(/stangenwaffe|speer|hellebarde|guisarme|polearm|spear|halberd|lanze/.test(tc)) return "Stangenwaffen";
  if(/kriegshammer|hammer/.test(tc) && !/schmied/.test(tc)) return "Hämmer";
  if(/axt|beil|fokos|breitaxt|henkersaxt|reiterax|zimmermannsax|axe/.test(tc)) return "Äxte";

  // Eindeutige gepflegte Gruppe vor dem generischen Wort „Schwert“ verwenden.
  if(/schild/.test(g)) return "Schilde";
  if(/langschwert/.test(g)) return "Langschwerter";
  if(/jagdschwert|falchion/.test(g)) return "Jagdschwerter/Falchions";
  if(/kurzschwert|schwert/.test(g)) return "Kurzschwerter/Schwerter";
  if(/saebel|säbel/.test(g)) return "Säbel";
  if(/dolch|messer/.test(g)) return "Dolche/Messer";
  if(/axt/.test(g)) return "Äxte";
  if(/streitkolben|keule|knueppel|knüppel/.test(g)) return "Streitkolben/Keulen";
  if(/hammer/.test(g)) return "Hämmer";
  if(/stangenwaffe|speer/.test(g)) return "Stangenwaffen";
  if(/armbrust/.test(g)) return "Armbrüste";
  if(/bogen/.test(g)) return "Bögen";
  if(/pfeile/.test(g)) return "Pfeile";
  if(/bolzen/.test(g)) return "Bolzen";
  if(/feuerwaffe/.test(g)) return "Feuerwaffen";
  if(/munition/.test(g)) return "Pfeile";
  if(/schwert|sword/.test(tc)) return "Kurzschwerter/Schwerter";
  return "Sonstige Waffen";
}

function armorSub(rec){
  const g=norm(rawGroup(rec));
  const title=norm(displayRecordName(rec)||rec.name||field(rec,"Name"));
  const command=norm(primaryCommand(rec)||rec.cheat||"");
  const code=(command.replace(/^.*?wh_cheat_additem\s+/,"").split(/\s+/)[0]||"");
  if(isActualHorseGear(rec)) return "Pferdeausrüstung";

  // Eindeutige interne Itemfamilien zuerst. Kurze Wörter wie cap/hat/hut niemals frei im ganzen Befehl suchen.
  if(/^(gauntlets|gloves)/.test(code) || /handschuh|panzerhandschuh/.test(title)) return "Handschuhe";
  if(/^(boots|shoes)/.test(code) || /stiefel|schuhe/.test(title)) return "Stiefel/Schuhe";
  if(/^(legs|hose|chausse)/.test(code) || /beinpanzer|beinlinge|beinschutz|\bhose\b/.test(title)) return "Beine";
  if(/^(armplate|brigandinearm|armsleeve|sleeves)/.test(code) || /armschutz|armschiene|armzeug|armplatte|armschützer/.test(title)) return "Arme";
  if(/^hood/.test(code) || /gugel|kapuze/.test(title) || /gugel|kapuze/.test(g)) return "Gugel/Kapuze";
  if(/collar/.test(code) || /kragen|nackenschutz/.test(title) || /kragen/.test(g)) return "Kragen";
  if(/^(ring|necklace|amulet|jewel)/.test(code) || /schmuck|\bring\b|amulett|amulet|halskette|skapulier/.test(title)) return "Schmuck";
  if(/^(bascinet|kettlehat|helmet|cap[0-9a-z_]|coif|hat[0-9a-z_])/.test(code) || /helm|beckenhaube|eisenhut|kettenhaube|\bkappe\b|\bhut\b|\bmütze\b|stirnreif|stirnband/.test(title)) return "Helm/Kopf";
  if(/^(waffenrock|tunic|gambeson|shirt|coat|jupon|pourpoint)/.test(code) || /wappenrock|tunika|gambeson|mantel|oberteil|hemd/.test(title)) return "Kleidung/Oberteil";
  if(/^(cuirass|brigandine(?!arm|legs)|mail(long|short)|body|chest)/.test(code) || /kürass|kuerass|brustpanzer|brigantine|kettenhemd/.test(title)) return "Kürass/Brust";

  // Gepflegte Gruppe als sichere Rückfallebene.
  if(/helm|kopf/.test(g)) return "Helm/Kopf";
  if(/gugel|kapuze/.test(g)) return "Gugel/Kapuze";
  if(/kragen/.test(g)) return "Kragen";
  if(/kleidung|oberteil/.test(g)) return "Kleidung/Oberteil";
  if(/kuerass|kürass|brust/.test(g)) return "Kürass/Brust";
  if(/^arme$/.test(g) || / arms? /.test(" "+g+" ")) return "Arme";
  if(/handschuhe/.test(g)) return "Handschuhe";
  if(/beine/.test(g)) return "Beine";
  if(/stiefel|schuhe/.test(g)) return "Stiefel/Schuhe";
  if(/schmuck/.test(g)) return "Schmuck";
  if(/pferde/.test(g)) return "Pferdeausrüstung";
  return "Sonstige Rüstung";
}

function potionSub(rec){
  const curated=hosAlchemyPotionSub(rec);
  if(curated) return curated;
  const section=norm(rawSection(rec));
  const group=norm(rawGroup(rec));
  const title=norm(displayRecordName(rec)||rec&&rec.name||field(rec,"Name"));
  const command=hosAlchemyV6Command(rec);
  const questValue=norm(field(rec,"Questitem")||field(rec,"Quest-Item")||"");
  const text=[title,command,group].join(" ");

  if(/gifte/.test(section)||/gift|poison|bane|lullaby|puppenmacher|schlaftrunk|verderben/.test(text)) return "Gifte";
  if(/bier|schnaps|alcohol|hooch|spirits|booze|geist/.test(text)) return "Alkohol/Flair";
  if(/^(1|true|ja|yes)$/.test(questValue)||/quest|sonder|alias_|kucharskakniha|aranka|katharina|peschek|otto|rochus|unkrautvernichter/.test(text)) return "Quest/Sondertränke";
  if(/heil|heal|marigold|ringelblume|schmerz|pain|kamille|chamomile|aqua.?vitalis|verdauung|gegenmittel|antidot|antidote/.test(text)) return "Heilung";
  if(/buff|ausdauer|stamina|reiten|hound|nachtfalke|night|schuetze|schütze|fuchs|fox|flinke|finger|salbe|artemisia|wermut/.test(text)) return "Buffs";
  return "Quest/Sondertränke";
}
function recipeSub(rec){
  const title=norm(displayRecordName(rec)||rec.name||field(rec,"Name"));
  const cmd=norm(primaryCommand(rec)||rec.cheat||"");
  const g=norm(rawGroup(rec));
  if(rec&&rec.__hosAlchemyPhysicalRecipe) return /fiebertonikum|sud gegen schmerzen/.test(title)?"Quest/Sonderrezepte":"Alchemie";
  if(/^schmiedeanleitung/.test(title) || /recipe_(?:axe|longsword|shortsword|huntingsword|sabre|horseshoe|polearm)/.test(cmd) || /schmied|forge|smith/.test(g)) return "Schmieden";
  if(/fiebertonikum|sud gegen schmerzen/.test(title) || /quest|sonder/.test(g)) return "Quest/Sonderrezepte";
  return "Alchemie";
}
function materialSub(rec){
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec)), tab=norm(field(rec,"Reiter")||rec.sheet||"");
  if(hosAlchemyV6IsHerbMaterial(rec) || /09[_ -]?kraeuter|09[_ -]?kräuter/.test(tab) || /^(kraeuter|kräuter)$/.test(s) || /kraut|kraeuter|kräuter|herb/.test(g)) return "Kräuter";
  const title=norm(displayRecordName(rec));
  const cmd=norm(primaryCommand(rec)||rec.cheat||"");
  const tc=title+" "+cmd;
  // Sicher belegte Häute/Leder aus dem aktuellen 52er-Materialbestand.
  if(/dornhaihaut|kuhleder|rehleder|rindleder|schweinsleder|sharkskin|cowskin|deerskin|cowhide|pigskin/.test(tc)) return "Leder/Stoff";
  // Alchemie-/Sonderzutaten, die keine Schmiedekomponenten sind.
  if(/alraunenwurzel|bezoar|fliegenpilz|frischwasserperle|galle|hoehlenpilz|höhlenpilz|salpeter|salzsaeure|salzsäure|schwefel|spinnennetz|weihrauch|mandrakeroot|mushroom|freshwaterpearl|saltpeter|acidumchloridum|sulfur|cobweb|olibanum|special_bilin/.test(tc)) return "Alchemiezutaten";
  // Echte Metall-, Holz-, Kohle- und Waffenbau-Komponenten.
  if(/bsmt_|altmetall|befestigungsmaterial|eisen|stahl|kupfer|farbgold|emaillepulver|borax|tinkal|holzkohle|gelaugte kohle|fremdlaendisches holz|fremdländisches holz|parierstange|schwertknauf|jaspis|steinpech|asfalt|hardware|charcoal|woodexotic|guard|pommel/.test(tc)) return "Schmiedematerial";
  return "Sonstiges";
}
function bookSub(rec){const s=norm(rawSection(rec)),h=blob(rec); if(/skillbuecher|skillbücher/.test(s)||/skillbuch|skillbook/.test(h))return"Skillbücher"; if(/recipe|rezept/.test(h))return"Rezepte"; if(/lb-|loesungsbuch|lösungsbuch|hilfe|komplett|video|guide|tipp/.test(h)||/hilfe|komplett|lb-/.test(s))return"Lösungsbuch"; return"Lore/Hilfe";}
function setSub(rec){ return setFamily(rec); }
function questSub(rec){
  if(safe(rec&&rec.id)==="quest-bavor-schwert-v09") return "Unsortiert/prüfen";
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec)), h=blob(rec);
  const all=s+" "+g+" "+h;
  if(/hauptquest|main quest|mainquest/.test(all)) return "Hauptquests";
  if(/nebenquest|side quest|sidequest/.test(all)) return "Nebenquests";
  if(/aktivitaet|aktivität|auftrag|activity|activities/.test(all)) return "Aktivitäten/Aufträge";
  if(/schatz|treasure/.test(all)) return "Schatzkarten";
  if(/karten/.test(s)||/karte|map/.test(all))return"Karten";
  if(/fundorte/.test(s)||/fundort|location|ort/.test(all))return"Fundorte";
  if(/kuttenberg|gilde|guild/.test(all))return"Kuttenberg/Gilde";
  if(/dlc|forge|schmiede|legacy of the forge/.test(all))return"DLC/Schmiede";
  if(/belohnung|reward/.test(all)) return "Questbelohnungen";
  return"Unsortiert/prüfen";
}


function resourceKind(rec){
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec)), h=blob(rec);
  if(/youtube|youtu\.be|video/.test(h) || /video-guides/.test(s)) return "VIDEO";
  if(/mapgenie|interaktive karte|interactive map|karte interaktiv|fundortkarte/.test(h)) return "KARTE";
  if(/eurogamer|https?:\/\/www\.eurogamer/.test(h)) return "ONLINE";
  if(/nebenquest|hauptquest|questlösung|questloesung|alle quests|alle hauptquests|alle nebenquests|tödlicher pinselstrich|toedlicher pinselstrich/.test(h)) return "QUEST";
  if(/lb-|loesungsbuch|lösungsbuch|pdf|spielgrundlage|lb-kampf|lb-ruestung|lb-rüstung|lb-alchemie|lb-schmiede|lb-kraeuter|lb-kräuter|lb-tipps/.test(s+" "+g+" "+h)) return "OFFLINE";
  if(/http/.test(h)) return "ONLINE";
  return "OFFLINE";
}

function resourcesSub(rec){
  const k = resourceKind(rec);
  const h = blob(rec);
  if(k === "ONLINE") return "Eurogamer Online";
  if(k === "KARTE") return /fundort|location|karte|map/.test(blob(rec)) ? "Fundorte/Karten" : "Interaktive Karten";
  if(k === "VIDEO") return "Video-Guides";
  if(k === "QUEST") return "Quests";
  if(k === "OFFLINE") return "Offline-Kodex";
  return "Alle Quellen";
}




function resourceKind(rec){
  const s=norm(rawSection(rec)), g=norm(rawGroup(rec)), h=blob(rec);
  if(/youtube|youtu\.be|video/.test(h) || /video-guides/.test(s)) return "VIDEO";
  if(/mapgenie|interaktive karte|interactive map|karte interaktiv|fundortkarte/.test(h)) return "KARTE";
  if(/eurogamer|https?:\/\/www\.eurogamer/.test(h)) return "ONLINE";
  if(/nebenquest|hauptquest|questlösung|questloesung|alle quests|alle hauptquests|alle nebenquests|tödlicher pinselstrich|toedlicher pinselstrich/.test(h)) return "QUEST";
  if(/lb-|loesungsbuch|lösungsbuch|pdf|spielgrundlage|lb-kampf|lb-ruestung|lb-rüstung|lb-alchemie|lb-schmiede|lb-kraeuter|lb-kräuter|lb-tipps/.test(s+" "+g+" "+h)) return "OFFLINE";
  if(/http/.test(h)) return "ONLINE";
  return "OFFLINE";
}

function resourcesSub(rec){
  const k = resourceKind(rec);
  const h = blob(rec);
  if(k === "ONLINE") return "Eurogamer Online";
  if(k === "KARTE") return /fundort|location|karte|map/.test(blob(rec)) ? "Fundorte/Karten" : "Interaktive Karten";
  if(k === "VIDEO") return "Video-Guides";
  if(k === "QUEST") return "Quests";
  if(k === "OFFLINE") return "Offline-Kodex";
  return "Alle Quellen";
}


function extractLinksStrict(rec){
  const f = rec.fields || {};
  const sources = [
    ["URL", rec.url],
    ["Info", rec.info],
    ["Quelle", rec.source],
    ["Cheat", rec.cheat],
    ...Object.entries(f)
  ];
  const found = [];
  const seen = new Set();
  const re = /https?:\/\/[^\s<>'")\]]+/gi;
  sources.forEach(([label, value]) => {
    const text = safe(value);
    let m;
    while((m = re.exec(text))){
      let url = m[0].replace(/[.,;:]+$/,"");
      if(!seen.has(url)){
        seen.add(url);
        found.push({label:safe(label)||"Link", url});
      }
    }
  });
  return found;
}

function linkButtonText(url, label){
  const u = norm(url + " " + label);
  if(/pdf|loesungsbuch|lösungsbuch/.test(u)) return "PDF / Lösungsbuch öffnen";
  if(/eurogamer|komplettloesung|komplettlösung|walkthrough/.test(u)) return "Lösung öffnen";
  if(/mapgenie|interactive map|interaktive karte|map/.test(u)) return "Karte öffnen";
  if(/quest/.test(u)) return "Questlösung öffnen";
  if(/youtube|youtu\.be|video/.test(u)) return "Video öffnen";
  return "Link öffnen";
}

function linkKindStrict(url, label){
  const u = norm(url + " " + label);
  if(/eurogamer/.test(u)) return "Eurogamer / Komplettlösung";
  if(/pdf|loesungsbuch|lösungsbuch/.test(u)) return "PDF / Lösungsbuch";
  if(/mapgenie|interactive map|interaktive karte|map/.test(u)) return "Interaktive Karte";
  if(/youtube|youtu\.be/.test(u)) return "Video-Guide";
  if(/wiki|fandom/.test(u)) return "Wiki / Quelle";
  if(/reddit|steam/.test(u)) return "Community-Quelle";
  return label || "Quelle";
}

function linksPanelHtmlStrict(rec){
  const links = extractLinksStrict(rec);
  if(!links.length){
    if(rec.__main === "resources" || rec.__main === "quests"){
      return `<div class="hos-link-panel"><div class="hos-link-title">Links / Karten / Lösungen</div><div class="hos-link-empty">In diesem Datensatz wurde kein direkter http-Link gefunden. Möglich: Quelle steht nur als Text oder der Link sitzt in einem Nachbar-Datensatz.</div></div>`;
    }
    return "";
  }
  return `<div class="hos-link-panel">
    <div class="hos-link-title"><span>Links / Karten / Lösungen</span><span class="hos-link-count">${links.length}</span></div>
    <div class="hos-link-actions">
      ${links.map(l => `<div class="hos-link-row">
        <div class="hos-link-label">${esc(linkKindStrict(l.url,l.label))}<span class="hos-link-url">${esc(l.url)}</span></div>
        <button class="hos-link-open-btn" data-url="${esc(l.url)}">${esc(linkButtonText(l.url,l.label))}</button>
      </div>`).join("")}
    </div>
  </div>`;
}

function bindLinksPanelStrict(){
  $all(".hos-link-open-btn").forEach(btn => {
    btn.addEventListener("click", (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      const url = btn.getAttribute("data-url") || "";
      if(url) window.open(url, "_blank", "noopener,noreferrer");
    });
  });
}

function animalPrimaryText(rec){
  const title = norm(rec.name || field(rec,"Name"));
  const group = norm(rawGroup(rec));
  const section = norm(rawSection(rec));
  const sheet = norm(rec.sheet || "");
  const cheat = norm(primaryCommand(rec) || rec.cheat || field(rec,"Cheat zum Kopieren") || field(rec,"Befehl") || field(rec,"Befehl zum Kopieren"));
  const slot = norm(field(rec,"Slot/Rolle"));
  const setName = norm(field(rec,"Set") || field(rec,"Setname") || field(rec,"Loadout"));
  return {title, group, section, sheet, cheat, slot, setName};
}
