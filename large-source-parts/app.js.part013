const HOS_ALCHEMY_PLAYER_FIELD_ORDER=["Rolle im Spiel","Zugehörige Trank-/Giftfamilie","Abgrenzung","Wirkung","Qualitätsstufe","Exakter bestätigter Wert","Dauer","Nebenwirkung/Wechselwirkung","Einsatzgebiet","Grundflüssigkeit","Zutaten","Zutaten / Material","Kurze Brauanleitung"];
const HOS_ALCHEMY_INTERNAL_FIELDS=new Set(["Qualitätslogik","Rezept-/Zutatenverweis","Alchemie-Quelle","Alchemie-Prüfstatus","Statusregel","Abgleich","Kuratiert 04","Spieleransicht","Patch-Regel","Gift-Buff-QC","Bestätigte Gift-Dauer"]);
function hosAlchemyIsDetailRecord(rec){ return !!(rec&&(rec.__hosAlchemyV3Status||rec.__hosAlchemyV3RecipeReady||rec.__hosAlchemyPhysicalRecipe||rec.__hosAlchemyExtra)); }
function hosAlchemyPlayerStatusText(rec){
  return "";
}
function hosAlchemyFieldLabel(key){ return key==="Nebenwirkung/Wechselwirkung"?"Nebenwirkung":key; }
function hosAlchemyFieldRows(entries){
  return `<div class="hos-detail-board-fields">${entries.map(([k,v])=>`<div class="hos-detail-board-field"><b>${esc(hosAlchemyFieldLabel(k))}</b><span>${esc(v)}</span></div>`).join("")}</div>`;
}
function detailBoardAllFields(rec){
  const fields=rec.fields||{};
  if(hosAlchemyIsDetailRecord(rec)){
    const rows=[];
    if(rec.__hosAlchemyV3Status!=="open" && !rec.__hosAlchemyExtra){
      for(const key of HOS_ALCHEMY_PLAYER_FIELD_ORDER){
        const value=safe(fields[key]).trim();
        if(value && !rows.some(row=>row[0]===key)) rows.push([key,value]);
      }
    }
    if(!rows.length) rows.push(["Hinweis","Keine zusätzlichen Spielerinformationen vorhanden."]);
    return hosAlchemyFieldRows(rows);
  }
  const entries=playerFieldEntries(rec);
  if(!entries.length) return `<div class="hos-detail-board-empty">Keine zusätzlichen Spielerinformationen vorhanden.</div>`;
  return `<div class="hos-detail-board-fields">${entries.slice(0,80).map(([k,v])=>`<div class="hos-detail-board-field"><b>${esc(norm(k)==="status"?"Merkmal":k)}</b><span>${esc(playerSafeText(v))}</span></div>`).join("")}</div>`;
}
function detailBoardTechnicalFields(rec){
  return `<div class="hos-detail-board-empty">Technische Prüf- und Rohdaten sind in der Player Edition ausgeblendet.</div>`;
}

function detailBoardCheatBox(rec){
  const cmd=primaryCommand(rec);
  if(!cmd) return `<div class="hos-detail-board-empty">Kein direkter Cheat/Befehl in diesem Datensatz. Bei Sets bitte Komfortblock/Zusatzfelder prüfen.</div>`;
  return `<div class="hos-detail-board-command"><button class="hos-action-btn hos-detail-board-copy" data-copy="${esc(cmd)}">Befehl kopieren</button><pre>${esc(cmd)}</pre><div class="hos-detail-board-copy-state" id="hos-detail-board-copy-state"></div></div>`;
}

// PUSH17 K6: Der bewährte TEST51-Link-/PDF-Zugriff wird in die große
// Detailtafel übernommen. Daten und Zuordnungen bleiben unverändert.
function detailBoardResourceBox(rec){
  if(!isResourceDetail(rec)) return detailBoardCheatBox(rec);
  const links=extractLinksForce(rec);
  const pdf=(typeof resourceKind==="function" && (resourceKind(rec)==="OFFLINE" || hosFinalAuditHasLinkedPdf(rec)))?pdfFileForRecord(rec):null;
  const parts=[];
  links.forEach((link,index)=>{
    parts.push(`<div class="hos-detail-board-linkrow" style="margin:0 0 12px;padding:10px;border:1px solid rgba(116,72,24,.28);border-radius:6px;background:rgba(255,237,185,.28)"><a class="hos-action-btn hos-detail-board-link" style="display:inline-flex;align-items:center;text-decoration:none;margin-right:8px" href="${esc(link.url)}" target="_blank" rel="noopener noreferrer">${esc(linkButtonTextForce(link.url,link.label))}</a><button class="hos-action-btn hos-detail-board-link-copy" style="margin-right:8px" data-copy-link="${esc(link.url)}">URL kopieren</button><div class="hos-detail-board-linkurl" style="margin-top:8px;overflow-wrap:anywhere;font-family:Consolas,monospace;font-size:12px;opacity:.82">${esc(link.url)}</div></div>`);
  });
  if(pdf){
    parts.push(`<div class="hos-detail-board-linkrow" style="margin:0 0 12px;padding:10px;border:1px solid rgba(116,72,24,.28);border-radius:6px;background:rgba(255,237,185,.28)"><a class="hos-action-btn hos-detail-board-link" style="display:inline-flex;align-items:center;text-decoration:none;margin-right:8px" href="${esc(pdf.rel)}" target="_blank" rel="noopener" data-pdf="${esc(pdf.rel)}">PDF öffnen</a><button class="hos-action-btn hos-detail-board-link-copy" style="margin-right:8px" data-copy-link="${esc(pdf.rel)}">PDF-Pfad kopieren</button><div class="hos-detail-board-linkurl" style="margin-top:8px;overflow-wrap:anywhere;font-family:Consolas,monospace;font-size:12px;opacity:.82">${esc(pdf.file)}</div></div>`);
  }
  if(!parts.length) return `<div class="hos-detail-board-empty">Für diesen Lösungs-/Karteneintrag ist kein direkter externer Link hinterlegt. Die lokalen Kodexdaten bleiben in der Detailansicht verfügbar.</div>`;
  return `<div class="hos-detail-board-resourcebox">${parts.join("")}<div class="hos-detail-board-copy-state" id="hos-detail-board-link-state"></div></div>`;
}

function detailBoardStatusRows(rec){
  const meta=detailBoardMeta(rec);
  const rows=[
    ["Bereich",meta.nav.label],
    ["Untergruppe",meta.sub],
    ["Primärwert",primaryValue(rec)]
  ].filter(x=>safe(x[1]).trim());
  return `<table class="hos-detail-board-table">${rows.map(([k,v])=>`<tr><td>${esc(k)}</td><td>${esc(v)}</td></tr>`).join("")}</table>`;
}

function detailBoardBodyHtml(rec,tab){
  const cmd=primaryCommand(rec);
  const info=detailInfoText(rec);
  const tip=detailDistinctNoteStatusText(rec);
  const img=detailHeroAsset(rec);
  const meta=detailBoardMeta(rec);
  if(tab==="values"){
    return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Werte</h3>${detailBoardMetricTable(rec)}</div><div class="hos-detail-board-card"><h3>Alle Zusatzfelder</h3>${detailBoardAllFields(rec)}</div></section>`;
  }
  if(tab==="locations"){
    return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Fundorte / Hinweise</h3><p>${esc(info||"Kein Fundort/Hinweis im Datensatz sichtbar.")}</p>${isResourceDetail(rec)?detailBoardResourceBox(rec):""}</div><div class="hos-detail-board-card"><h3>Einordnung</h3>${detailBoardStatusRows(rec)}</div></section>`;
  }
  if(tab==="cheats"){
    if(isResourceDetail(rec)){
      return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Lösung / Link / PDF</h3>${detailBoardResourceBox(rec)}</div><div class="hos-detail-board-card"><h3>Einordnung</h3>${detailBoardStatusRows(rec)}</div></section>`;
    }
    return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Cheat / ID</h3>${detailBoardCheatBox(rec)}</div><div class="hos-detail-board-card"><h3>${hosAlchemyIsDetailRecord(rec)?"Zusatzinformationen":"Set / Komfortblock"}</h3>${hosAlchemyIsDetailRecord(rec)?detailBoardAllFields(rec):(setPanelHtmlStrict(rec)||"<p>Kein Set-Komfortblock für diesen Datensatz.</p>")}</div></section>`;
  }
  if(tab==="notes"){
    return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Notizen</h3><p>${esc(tip||"Keine zusätzliche Notiz im Datensatz.")}</p></div><div class="hos-detail-board-card"><h3>Einordnung</h3>${detailBoardStatusRows(rec)}</div></section>`;
  }
  return `<section class="hos-detail-board-overview">
    <div class="hos-detail-board-art"><img src="${esc(img)}" alt=""></div>
    <div class="hos-detail-board-card hos-detail-board-main">
      <h3>${esc(displayRecordName(rec))}</h3>
      <div class="hos-detail-board-type">${esc(meta.nav.label)} · ${esc(meta.sub||"")}</div>
      <div class="hos-detail-board-mini-grid">
        <div><h4>Werte</h4>${detailBoardMetricTable(rec)}</div>
        <div><h4>${isResourceDetail(rec)?"Lösung / Link / PDF":"Cheat / Befehl"}</h4>${isResourceDetail(rec)?detailBoardResourceBox(rec):detailBoardCheatBox(rec)}</div>
      </div>
    </div>
    <div class="hos-detail-board-card"><h3>Fundort / Hinweis</h3><p>${esc(info||"Kein Fundort/Hinweis im Datensatz sichtbar.")}</p></div>
    <div class="hos-detail-board-card"><h3>Spielhinweis</h3><p>${esc(tip||"Kein zusätzlicher Spielhinweis vorhanden.")}</p></div>
  </section>`;
}

function bindDetailBoard(rec){
  const overlay=$("#hos-detail-board-overlay");
  if(!overlay) return;
  overlay.querySelectorAll("[data-board-close]").forEach(btn=>btn.addEventListener("click",()=>overlay.remove()));
  overlay.addEventListener("click",ev=>{ if(ev.target===overlay) overlay.remove(); });
  overlay.querySelectorAll(".hos-detail-board-tab").forEach(btn=>btn.addEventListener("click",()=>{
    const tab=btn.getAttribute("data-tab")||"overview";
    const body=$("#hos-detail-board-body");
    if(body) body.innerHTML=detailBoardBodyHtml(rec,tab);
    overlay.querySelectorAll(".hos-detail-board-tab").forEach(b=>b.classList.toggle("active",b===btn));
    bindDetailBoardCopy();
    bindDetailBoardLinks();
    bindSetPanelStrict(rec);
  }));
  bindDetailBoardCopy();
  bindDetailBoardLinks();
  bindSetPanelStrict(rec);
}

function bindDetailBoardLinks(){
  $$(".hos-detail-board-link-copy").forEach(btn=>btn.addEventListener("click",()=>{
    const txt=btn.getAttribute("data-copy-link")||"";
    copyText(txt).then(ok=>{
      const fb=$("#hos-detail-board-link-state");
      if(fb) fb.textContent=ok?"✅ Link/Pfad kopiert!":"Kopieren nicht möglich – bitte manuell markieren.";
    });
  }));
}

function bindDetailBoardCopy(){
  $$(".hos-detail-board-copy").forEach(btn=>btn.addEventListener("click",()=>{
    const txt=btn.getAttribute("data-copy")||"";
    copyText(txt).then(ok=>{
      const fb=$("#hos-detail-board-copy-state");
      if(fb) fb.textContent=ok?"✅ Kopiert!":"Kopieren nicht möglich – bitte manuell markieren.";
    });
  }));
}

function openDetailBoard(id){
  const rec=enriched.find(r=>r.id===id); if(!rec) return;
  selectRecord(id,false);
  const old=$("#hos-detail-board-overlay"); if(old) old.remove();
  const meta=detailBoardMeta(rec);
  const overlay=document.createElement("div");
  overlay.id="hos-detail-board-overlay";
  overlay.className="hos-detail-board-overlay";
  overlay.innerHTML=`<article class="hos-detail-board" data-main="${esc(rec.__main||state.main||"")}" data-sub="${esc(meta.sub||"")}" role="dialog" aria-modal="true" aria-label="Grosse Detailansicht">
    <header class="hos-detail-board-head">
      <div class="hos-detail-board-titleline">
        <div class="hos-detail-board-small-icon"><img src="${esc(subIcon(rec))}" alt=""></div>
        <div><h2>${esc(displayRecordName(rec))}</h2><div>${esc(meta.nav.label)} · ${esc(meta.sub||"")}</div></div>
      </div>
      <div class="hos-detail-board-head-actions"><button class="hos-detail-board-back" data-board-close>Zurück zur Liste</button><button class="hos-detail-board-x" data-board-close aria-label="Schließen">×</button></div>
    </header>
    <nav class="hos-detail-board-tabs">${detailBoardTabs(rec).map(([key,label],i)=>`<button class="hos-detail-board-tab ${i===0?"active":""}" data-tab="${esc(key)}">${esc(label)}</button>`).join("")}</nav>
    <div class="hos-detail-board-body" id="hos-detail-board-body">${detailBoardBodyHtml(rec,"overview")}</div>
  </article>`;
  document.body.appendChild(overlay);
  bindDetailBoard(rec);
}

window.addEventListener("keydown",ev=>{
  if(ev.key==="Escape"){
    const overlay=$("#hos-detail-board-overlay");
    if(overlay) overlay.remove();
  }
});


// P02J_VISUAL_PROPORTION_AUSHANG_01: Aushang als Spieler-Nachrichtenbrett, nicht als Dev-Ticker.
// Texte bleiben vorläufige Optik-/Flair-Platzhalter; finale Textrettung kommt später separat.
// Projektregel: Witztexte nicht einkürzen. Layout muss Text tragen, nicht umgekehrt.
const HOS_SCHREIBSTUBE_SPRUECHE = [
  "VERMISST: Ein linker Stiefel, ein rechter Handschuh und die Würde des Besitzers.",
  "EILMELDUNG: Im Wirtshaus wurde ein leerer Krug gefunden. Zeugen schweigen.",
  "MARKTGERÜCHT: Ein Händler versprach faire Preise. Die Stadtwache lachte höflich.",
  "WACHSTUBE: Wer mit gezogenem Schwert stolpert, nennt es bitte nicht Taktik.",
  "AUSHANG: Gesucht wird ein Mann mit Hut. Beschreibung: trägt Hut.",
  "SCHREIBSTUBE: Wer lesen kann, irrt wenigstens mit System.",
  "RÜSTKAMMER: Helme sitzen fest. Frisuren wurden nicht befragt.",
  "WIRTSHAUS: Suppe warm, Bier kalt, Geschichten vermutlich gelogen.",
  "VERMISST: Ein Esel namens ‚Komm sofort zurück‘. Hört auf nichts.",
  "STADTRAT: Rennen in voller Rüstung bleibt unklug, aber beeindruckend."
];
const HOS_REGION_WETTER = [
  {region:"KUTTENBERG", icon:"🌦", text:"14° · Regen. Kapuzen gewinnen heute."},
  {region:"TROSKY", icon:"🌫", text:"9° · Nebel. Wer den Weg kennt, lügt."},
  {region:"SUCHDOL", icon:"☁", text:"12° · Wolken. Esel bleiben skeptisch."},
  {region:"SEMIN", icon:"☀", text:"18° · Sonne. Händler werfen Schatten."},
  {region:"RÜSTKAMMER", icon:"⛅", text:"16° · Trocken. Helme drücken wetterunabhängig."},
  {region:"WIRTSHAUS", icon:"🌙", text:"7° · Kühl. Krüge verschwinden trotzdem."},
  {region:"SCHMIEDE", icon:"⚒", text:"20° · Warm. Nicht auf den Amboss setzen."},
  {region:"MARKTPLATZ", icon:"🌧", text:"11° · Pflaster nass. Stolz langsam tragen."}
];
const HOS_KUTTENBERG_WETTER = HOS_REGION_WETTER;
function aushangTypeFor(text){
  const t=safe(text).split(":")[0].trim();
  return t || "AUSHANG";
}
function renderSchreibstubeBoard(){
  const spruch = HOS_SCHREIBSTUBE_SPRUECHE[0];
  const spruch2 = HOS_SCHREIBSTUBE_SPRUECHE[1];
  return `<section class="hos-schreibstube-board" aria-label="Aushang der Schreibstube">
    <div class="hos-board-head"><span class="hos-board-seal">✦</span><strong>Aushang der Schreibstube</strong><small>Kuttenberger Nachrichtenbrett</small></div>
    <div class="hos-board-notes">
      <article class="hos-board-note hos-board-note-main"><b id="hos-board-tag">${esc(aushangTypeFor(spruch))}</b><p id="hos-board-aushang-text">${esc(spruch.replace(/^[^:]+:\s*/,""))}</p></article>
      <article class="hos-board-note hos-board-note-news"><b id="hos-board-second-tag">${esc(aushangTypeFor(spruch2))}</b><p id="hos-board-second-text">${esc(spruch2.replace(/^[^:]+:\s*/,""))}</p></article>
    </div>
  </section>`;
}
function ensureSchreibstubeBoardDock(){
  const middle = document.querySelector(".hos-real-main") || document.querySelector(".middle-pane") || document.querySelector("main");
  if(!middle) return;
  let dock = document.getElementById("hos-schreibstube-dock");
  if(!dock){
    dock = document.createElement("div");
    dock.id = "hos-schreibstube-dock";
    dock.className = "hos-schreibstube-dock";
    const head = middle.querySelector(".hos-main-head") || (document.querySelector("#hos-search")||document.querySelector(".search-input"))?.closest(".hos-main-head") || middle.firstElementChild;
    if(head && head.parentElement === middle) middle.insertBefore(dock, head);
    else middle.insertBefore(dock, middle.firstChild);
  }
  if(!dock.querySelector(".hos-schreibstube-board")) dock.innerHTML = renderSchreibstubeBoard();
}
function initSchreibstubeTicker(){
  let i = 0;
  if(window.__hosSchreibstubeTicker) clearInterval(window.__hosSchreibstubeTicker);
  function tick(){
    const spruch = HOS_SCHREIBSTUBE_SPRUECHE[i % HOS_SCHREIBSTUBE_SPRUECHE.length];
    const spruch2 = HOS_SCHREIBSTUBE_SPRUECHE[(i + 3) % HOS_SCHREIBSTUBE_SPRUECHE.length];
    const wetter = HOS_REGION_WETTER[(i + 2) % HOS_REGION_WETTER.length];
    const typ = aushangTypeFor(spruch);
    const typ2 = aushangTypeFor(spruch2);
    const cleanSpruch = spruch.replace(/^[^:]+:\s*/,"");
    const cleanSpruch2 = spruch2.replace(/^[^:]+:\s*/,"");
    const typEl = $("#hos-aushang-typ");
    if(typEl) typEl.textContent = typ;
    const boardTag=$("#hos-board-tag");
    if(boardTag) boardTag.textContent=typ;
    const boardTag2=$("#hos-board-second-tag");
    if(boardTag2) boardTag2.textContent=typ2;
    [
      [$("#hos-schreibstube-spruch"), spruch],
      [$("#hos-board-aushang-text"), cleanSpruch],
      [$("#hos-board-second-text"), cleanSpruch2]
    ].filter(pair=>pair[0]).forEach(([el,text])=>{
      el.classList.remove("hos-ticker-pop");
      void el.offsetWidth;
      el.textContent = text;
      el.classList.add("hos-ticker-pop");
    });
    [$("#hos-wetterdienst-meldung")].filter(Boolean).forEach(el=>{
      const weatherObj = (typeof wetter === "string") ? {region:"KUTTENBERG", icon:(wetter||"☁").trim().slice(0,2).trim()||"☁", text:String(wetter||"").replace(/^\S+\s*/,"")} : wetter;
      const weatherLine = `${weatherObj.icon || "☁"} ${weatherObj.text || ""}`.trim();
      el.classList.remove("hos-ticker-pop");
      void el.offsetWidth;
      el.textContent = weatherLine;
      el.classList.add("hos-ticker-pop");
      const weatherPanel = el.closest ? el.closest(".hos-wetter-panel") : null;
      if(weatherPanel){
        weatherPanel.setAttribute("data-weather-icon", weatherObj.icon || "☁");
        const regionLabel = weatherPanel.querySelector ? weatherPanel.querySelector(".hos-aushang-label") : null;
        if(regionLabel) regionLabel.textContent = weatherObj.region || "WETTER";
      }
    });
    const board=$(".hos-schreibstube-board");
    if(board){
      board.classList.remove("hos-board-flash");
      void board.offsetWidth;
      board.classList.add("hos-board-flash");
    }
    i++;
  }
  tick();
  window.__hosSchreibstubeTicker = setInterval(tick, 6800);
}

function setResourceModeBody(rec){
  try{
    const on = !!((rec && isResourceDetail(rec)) || state.main==="resources");
    document.body.classList.toggle("hos-resource-mode", on);
  }catch(e){}
}

function quickSetSummaryHtml(rec){
  if(!isSetContext(rec)) return "";
  return `<div class="hos-kodex-section hos-quick-set-summary"><h4>Set / Komfortblock</h4><div>Die vollständigen Set-Befehle stehen im großen Detailfenster. Die Schnellansicht bleibt bewusst kompakt.</div></div>`;
}
function selectRecord(id,scrollDetail=true){
  const rec=enriched.find(r=>r.id===id); if(!rec)return; state.selectedId=id;
  $all(".item-card.is-selected").forEach(el=>el.classList.remove("is-selected"));
  const activeCard=document.querySelector(`.item-card[data-id="${CSS.escape(String(id))}"]`); if(activeCard)activeCard.classList.add("is-selected");
  setResourceModeBody(rec);
  const animalContext = state.main==="animals" && isAnimalRelated(rec);
  const nav=animalContext?currentNav():(MAIN_NAV.find(n=>n.key===rec.__main)||MAIN_NAV[0]), sub=animalContext?animalSub(rec):(state.main==="all"?rec.__allSub:rec.__sub);
  const cmd=primaryCommand(rec);
  const detail=$("#details-content");
  if(detail){
    const rows=[
      ["Bereich",nav.label],
      ["Untergruppe",sub],
      ["Primärwert",primaryValue(rec)]
    ].filter(x=>safe(x[1]).trim());
    detail.innerHTML=`<article class="hos-kodex-entry hos-detail-stage" data-id="${esc(rec.id)}" data-main="${esc(rec.__main||state.main||"")}" data-sub="${esc(sub||"")}">
      <div class="hos-kodex-head">
        <div class="hos-kodex-icon"><img src="${subIcon(rec)}" alt=""></div>
        <div><h2 class="hos-kodex-title">${esc(displayRecordName(rec))}</h2><div class="hos-kodex-type">${esc(nav.label)} · ${esc(sub||"")}</div></div>
      </div>
      ${detailHeroHtml(rec)}
      ${detailCommandHtml(rec,cmd)}
      ${quickSetSummaryHtml(rec)}
      ${detailContextPanelsHtml(rec)}
      <div class="hos-kodex-section hos-detail-status-section"><h4>Einordnung</h4><table class="stats-table">${rows.map(([k,v])=>`<tr><td>${esc(k)}</td><td class="val">${esc(v)}</td></tr>`).join("")}</table></div>
      <div class="hos-kodex-section hos-detail-extra-section"><h4>Zusatzinformationen</h4>${isResourceDetail(rec)?`${linksPanelHtmlForce(rec)}${pdfPanelHtml(rec)}${resourceDetailPanelHtml(rec)}`:`${linksPanelHtmlForce(rec)}${offlineKodexPanelHtml(rec)}${detailFieldRowsLimited(rec)}`}</div>
    </article>`;
    const codexScroll=document.querySelector(".hos-codex-scroll"); if(codexScroll) codexScroll.scrollTop=0;
  }
  const cb=$("#hos-command-box"); if(cb&&cmd&&!isResourceDetail(rec))cb.addEventListener("click",()=>copyText(cmd).then(ok=>{const fb=$("#hos-copy-feedback"); if(fb)fb.textContent=ok?"✅ Kopiert!":"Kopieren nicht möglich – bitte manuell markieren."; }));
  const mainCopyBtn=$("#hos-copy-main-command"); if(mainCopyBtn&&cmd&&!isResourceDetail(rec))mainCopyBtn.addEventListener("click",()=>copyText(cmd).then(ok=>{const fb=$("#hos-copy-feedback"); if(fb)fb.textContent=ok?"✅ Befehl kopiert!":"Kopieren nicht möglich – bitte manuell markieren."; }));
  bindLinksPanelStrict(); bindLinksPanelForce(); bindPdfPanel(); bindSetPanelStrict(rec);
  if(scrollDetail&&window.innerWidth<900)document.querySelector(".right-pane")?.scrollIntoView({behavior:"smooth"});
}
function initSearch(){
  const input=$("#hos-search")||$(".search-input"); if(!input)return;
  const box=input.closest?input.closest(".search-box"):null;
  let clearX=$("#hos-search-clear-x");
  if(box && !clearX){
    clearX=document.createElement("button");
    clearX.id="hos-search-clear-x";
    clearX.className="hos-search-clear-x";
    clearX.type="button";
    clearX.setAttribute("aria-label","Suche leeren");
    clearX.title="Suche leeren";
    clearX.textContent="×";
    box.appendChild(clearX);
  }
  function syncClearX(){ if(clearX) clearX.classList.toggle("active", !!(state.query||input.value)); }
  if(clearX) clearX.addEventListener("click",()=>{input.value="";state.query="";state.visible=HOS_VISIBLE_STEP;state.selectedId=null;renderGrid();syncClearX();input.focus();});
  input.addEventListener("input",()=>{state.query=input.value||"";state.visible=HOS_VISIBLE_STEP;state.selectedId=null;renderGrid();syncClearX();});
  input.addEventListener("keydown",e=>{if(e.key==="Enter")renderGrid(); if(e.key==="Escape"){input.value="";state.query="";state.visible=HOS_VISIBLE_STEP;renderGrid();syncClearX();}});
  syncClearX();
}
function addMarker(){
  const old=$(".hos-test-marker"); if(old)old.remove();
  document.body.dataset.hosAlchemyFinal=`${HOS_ALCHEMY_V3_AUDIT.itemReadyMatches}-82_${HOS_ALCHEMY_V3_AUDIT.itemOpenMatches}-18_${HOS_ALCHEMY_V3_AUDIT.recipeReadyMatches}-22`;
}
function renderAll(navToo=true){ if(navToo)renderNav(); renderGrid(); }
// TEST25_35_PLAYER_EDITION_SICHTBARKEIT_01 AKTIV
function boot(){ state.sub=SUBFILTERS[state.main][0]; state.status="all"; state.view="cards"; initSearch(); initSchreibstubeTicker(); addMarker(); renderAll(true); $all(".bottom-actions [data-jump]").forEach(btn=>btn.addEventListener("click",()=>{state.main=btn.getAttribute("data-jump")||"all";state.sub=SUBFILTERS[state.main]?.[0]||"Alle";state.status="all";state.visible=HOS_VISIBLE_STEP;state.sort="standard";state.selectedId=null;renderAll(true);})); window.heinrichOSStruktur07={state,records:enriched,visibleRecords:UI_RECORDS,uiAudit:HOS_UI_AUDIT,filtered,subfilters:SUBFILTERS,sortOptions:sortOptionsForCurrent,selectionBase,subCount,statusCount,meaningfulStandardCompare,recordsForMainKey,isAnimalRelated,isAnimalExcluded,isActualHorseGear,horseGearKind,animalSub,isDogTreat,isKnownDogFood,isPreferredDogTreat,queryMatches,subIcon,displayRecordName,mainKey,isResourceGuideRecord}; }
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot,{once:true}); else boot();
})();

/* =====================================================================
   HEINRICHOS KCD2 - TEST25_21 FIX5 SUCHREGISTER FOKUS / FILTER FINISH
   Freigegebene UI-Anordnung: stabile Suche im Registerkopf und exakt
   zwei Player-Steuerelemente in der zweiten Zeile. Keine Datenlogik, IDs oder Cheats.
   ===================================================================== */
;(() => {
  'use strict';

  const FIX_MARKER = 'TEST25_21_FIX5_SEARCH_FOCUS_FILTER_FINISH';
  const GRID_SELECTOR = '.cards-grid';
  const TARGET_SELECTOR = '.hos-register-heading, .hos-register-commandbar';
  const FILTER_TYPES = ['subfilter', 'sort'];
  let scheduled = false;
  let preserveSearchFocus = false;

  function directChildByClass(parent, className) {
    if (!parent) return null;
    for (const child of parent.children) {
      if (child.classList && child.classList.contains(className)) return child;
    }
    return null;
  }

  function cleanFilterbar(commandbar) {
    const controls = FILTER_TYPES.map((type) =>
      commandbar.querySelector(`[data-hos-dropdown="${type}"]`)
    );
    if (controls.some((control) => !control)) return false;

    // Bestehende Steuerelemente selbst verschieben: Listener bleiben erhalten.
    controls.forEach((control) => commandbar.appendChild(control));

    // Player Edition: Die Filterzeile besitzt danach exakt Untergruppe und Sortierung.
    for (const child of [...commandbar.children]) {
      if (!controls.includes(child)) child.remove();
    }

    commandbar.setAttribute('data-hos-filterbar', 'fix5');
    commandbar.setAttribute('data-hos-player-filterbar', '04');
    return commandbar.children.length === 2;
  }

  function applySearchRegisterLayout() {
    document.querySelectorAll(GRID_SELECTOR).forEach((grid) => {
      const heading = directChildByClass(grid, 'hos-register-heading') || grid.querySelector('.hos-register-heading');
      const commandbar = directChildByClass(grid, 'hos-register-commandbar') || grid.querySelector('.hos-register-commandbar');
      if (!heading || !commandbar) return;

      const search = heading.querySelector('.hos-register-search-control') || commandbar.querySelector('.hos-register-search-control');
      if (!search) return;

      // Nur versetzen, wenn es wirklich noch nicht im Kopf sitzt. Kein erneutes
      // insertBefore bei Karten-Updates: dadurch bleibt der Eingabefokus stabil.
      if (search.parentElement !== heading) {
        const resultCount = heading.querySelector('.hos-register-result-count');
        heading.insertBefore(search, resultCount || null);
      }

      heading.querySelectorAll('.hos-register-heading-copy, .hos-register-heading-tags').forEach((node) => node.remove());
      cleanFilterbar(commandbar);

      heading.setAttribute('data-hos-search-register', 'fix5');
      grid.setAttribute('data-hos-test25-21', 'fix5');
    });
  }

  function scheduleApply(keepFocus = false) {
    preserveSearchFocus = preserveSearchFocus || keepFocus;
    if (scheduled) return;
    scheduled = true;

    requestAnimationFrame(() => {
      scheduled = false;
      const active = document.activeElement;
      const hadSearchFocus = preserveSearchFocus || (active && active.id === 'hos-register-search');
      const start = hadSearchFocus && typeof active.selectionStart === 'number' ? active.selectionStart : null;
      const end = hadSearchFocus && typeof active.selectionEnd === 'number' ? active.selectionEnd : null;
      preserveSearchFocus = false;

      applySearchRegisterLayout();

      if (hadSearchFocus) {
        const input = document.getElementById('hos-register-search');
        if (input && document.activeElement !== input) {
          input.focus({ preventScroll: true });
          if (start !== null && end !== null && typeof input.setSelectionRange === 'function') {
            const max = input.value.length;
            input.setSelectionRange(Math.min(start, max), Math.min(end, max));
          }
        }
      }
    });
  }

  function addedNodeNeedsLayout(node) {
    if (!node || node.nodeType !== 1) return false;
    if (node.matches && (node.matches(GRID_SELECTOR) || node.matches(TARGET_SELECTOR))) return true;
    return Boolean(node.querySelector && node.querySelector(`${GRID_SELECTOR}, ${TARGET_SELECTOR}`));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => scheduleApply(false), { once: true });
  } else {
    scheduleApply(false);
  }

  window.addEventListener('load', () => scheduleApply(false), { once: true });

  // Nur neue Register-/Toolbar-Strukturen beachten. Neue Ergebniskarten beim
  // Tippen lösen bewusst kein erneutes Verschieben des Suchfeldes aus.
  new MutationObserver((records) => {
    let relevant = false;
    for (const record of records) {
      for (const node of record.addedNodes) {
        if (addedNodeNeedsLayout(node)) {
          relevant = true;
          break;
        }
      }
      if (relevant) break;
    }
    if (relevant) scheduleApply(document.activeElement && document.activeElement.id === 'hos-register-search');
  }).observe(document.documentElement, { childList: true, subtree: true });

  window[FIX_MARKER] = true;
})();

/* =====================================================================
   HOS PLAYER/USB V3 CLEAN – STICKY SUCHREGISTER
   Das bereits vorhandene FIX5-Suchregister bleibt beim Scrollen sichtbar.
   ===================================================================== */
;(() => {
  'use strict';
  const STYLE_ID='hos-player-usb-v3-clean-sticky-search';
  function install(){
    if(document.getElementById(STYLE_ID)) return;
    const style=document.createElement('style');
    style.id=STYLE_ID;
    style.textContent=`
      body.hos-v11-puzzle-02i .cards-grid > .hos-register-heading,
      .cards-grid > .hos-register-heading{
        position:sticky!important;
        top:0!important;
        z-index:45!important;
      }
    `;
    (document.head||document.documentElement).appendChild(style);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',install,{once:true});
  else install();
})();


/* =====================================================================
   HOS PLAYER/USB - SCROLLPOSITION PRO HAUPTKATEGORIE
   Merkt waehrend der laufenden Sitzung die letzte vertikale Position
   des Ergebnisbereichs fuer jede Hauptkategorie separat.
   ===================================================================== */
;(() => {
  'use strict';

  const MARKER='HOS_PLAYER_USB_SCROLL_MEMORY_20260822';
  const positions=new Map();
  let host=null;
  let restoring=false;

  function activeMainKey(){
    const active=document.querySelector('.nav-item.active[data-main]');
    return (active && active.getAttribute('data-main')) || 'all';
  }

  function gridElement(){
    return document.getElementById('hos-item-grid') || document.querySelector('.cards-grid, .item-grid');
  }

  function findScrollHost(){
    const grid=gridElement();
    if(!grid) return null;

    let node=grid;
    while(node && node!==document.body && node!==document.documentElement){
      const style=window.getComputedStyle ? window.getComputedStyle(node) : null;
      const overflowY=style ? String(style.overflowY || '') : '';
      if(/auto|scroll|overlay/i.test(overflowY) && node.scrollHeight>node.clientHeight+1){
        return node;
      }
      node=node.parentElement;
    }

    // In der aktuellen Player-Oberflaeche ist das Kartenregister der
    // vorgesehene Scrollbereich. Der Fallback bleibt deshalb bewusst dort.
    return grid;
  }

  function onScroll(){
    if(restoring || !host) return;
    positions.set(activeMainKey(), Number(host.scrollTop)||0);
  }

  function bindHost(){
    const next=findScrollHost();
    if(!next || next===host) return host;
    if(host) host.removeEventListener('scroll',onScroll);
    host=next;
    host.addEventListener('scroll',onScroll,{passive:true});
    return host;
  }

  function saveCurrent(){
    const current=bindHost();
    if(!current) return;
    positions.set(activeMainKey(), Number(current.scrollTop)||0);
  }

  function restoreFor(key){
    if(!key) return;
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      const current=bindHost();
      if(!current) return;
      restoring=true;
      current.scrollTop=positions.has(key) ? positions.get(key) : 0;
      requestAnimationFrame(()=>{restoring=false;});
    }));
  }

  // Capture-Phase: zuerst alte Position sichern, danach darf die vorhandene
  // HeinrichOS-Navigation den Registerinhalt normal neu zeichnen.
  document.addEventListener('click',ev=>{
    const target=ev.target && ev.target.closest
      ? ev.target.closest('.nav-item[data-main], [data-jump]')
      : null;
    if(!target) return;

    const nextKey=target.getAttribute('data-main') || target.getAttribute('data-jump');
    if(!nextKey) return;

    saveCurrent();
    restoreFor(nextKey);
  },true);

  function install(){
    bindHost();
    window[MARKER]={
      active:true,
      positions,
      saveCurrent,
      restoreFor
    };
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',install,{once:true});
  }else{
    install();
  }
})();
