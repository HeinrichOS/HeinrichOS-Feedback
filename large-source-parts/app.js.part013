function sourceBadgeHtml(rec){
  const k = resourceKind(rec);
  if(k==="ONLINE") return `<span class="hos-source-badge hos-source-online">ONLINE</span>`;
  if(k==="OFFLINE") return `<span class="hos-source-badge hos-source-offline">OFFLINE</span>`;
  if(k==="KARTE") return `<span class="hos-source-badge hos-source-map">KARTE</span>`;
  if(k==="QUEST") return `<span class="hos-source-badge hos-source-quest">QUEST</span>`;
  if(k==="VIDEO") return `<span class="hos-source-badge hos-source-video">VIDEO</span>`;
  return `<span class="hos-source-badge hos-source-other">QUELLE</span>`;
}


