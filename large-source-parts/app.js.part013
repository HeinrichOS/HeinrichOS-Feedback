}



const HOS_PDF_FILES = [];

function isResourceDetail(rec){
  return rec.__main === "resources" || state.main === "resources" || rec.__main === "quests" || state.main === "quests";
}

function pdfKeyForRecord(rec){
  const exact=HOS_V151_RESOURCE_PDF_BY_ID.get(safe(rec&&rec.id));
  if(exact) return exact;
  const h = blob(rec);
  const name = norm(rec.name||"") + " " + norm(rec.group||"") + " " + norm(rawSection(rec)||"") + " " + h;
  if(/alchemie|braumeister|labor/.test(name)) return "LB_Alchemie_Grundlagen_S54-56.pdf";
  if(/kampf|waffen|nahkampf|fernkampf|schwert|bogen|armbrust|taktik/.test(name)) return "LB_Kampf_Waffen_S26-31.pdf";
  if(/kraeuter|kräuter|kraut|kraeuterkunde|kräuterkunde|pflanze/.test(name)){
    if(/58|loewenzahn|löwenzahn|mohn|salbei|wermut|fliegenpilz|minze|ringelblume|tollkirsche/.test(name)) return "LB_Kraeuter_S58.pdf";
    return "LB_Kraeuter_S57.pdf";
  }
  if(/pferd|koeter|köter|reiten|pebbles|sattel|hund/.test(name)) return "LB_Pferd_Koeter_S37-38.pdf";
  if(/ruestung|rüstung|kleidung|outfit|helm|kürass|kuerass|handschuh|stiefel|schmuck/.test(name)) return "LB_Ruestung_Kleidung_S34-36.pdf";
  if(/schmiede.*grund|heisse eisen|heiße eisen|grundlagen|amboss|rohling|hammer/.test(name)) return "LB_Schmiede_Grundlagen_S62-63.pdf";
  if(/schmiede|schmiederezepte|material|schwert|axt|säbel|saebel|dolch|langschwert|rezept/.test(name)) return "LB_Schmiede_Waffen_Material_S64-67.pdf";
  if(/gift|gifte|puppenmacher|schlaftrunk|verderben|seife|schuetzentrunk|schützentrunk|schmerz/.test(name)) return "LB_Traenke_Gifte_S61.pdf";
  if(/traenke|tränke|trank|retterschnaps|schnaps|kater|kamille|salbe|ringelblume|loewenzahn|löwe|minz|hahnenschrei/.test(name)){
    if(/60|kamille|kater|loewe|löwe|minz|retterschnaps|salbe|ringelblume|schnaps/.test(name)) return "LB_Traenke_S60.pdf";
    return "LB_Traenke_S59.pdf";
  }
  if(/lb-tipps|spielgrundlage|speichern|reden|alchemie|kraeuter/.test(name)) return "LB_Alchemie_Grundlagen_S54-56.pdf";
  return "";
}

function pdfFileForRecord(rec){
  const key = pdfKeyForRecord(rec);
  if(!key) return null;
  return HOS_PDF_FILES.find(p => p.file === key) || null;
}

/* =====================================================================
   TEST23 – UI-NUTZWERTFILTER A
   Daten bleiben vollständig im Speicher und in f116_data.js erhalten.
   Gerendert werden nur Datensätze mit einem echten Nutzwert:
   - kopierbarer Konsolenbefehl / Cheat
   - direkter http/https-Link
   - tatsächlich erreichbare lokale PDF in Quests oder Lösungen
   - Würfel-/Farkle-Funktion
   - Set-Komfortblock mit mindestens einem echten Befehl

   Keine IDs, UUIDs, Cheats, Werte, Fundorte oder Quelldaten werden gelöscht.
   ===================================================================== */

function runtimeValueReason(rec){
  if(HOS_FINAL_AUDIT_HIDDEN_IDS.has(safe(rec&&rec.id))) return "";
  if(isDiceRecord(rec)) return "dice";

  const command=primaryCommand(rec);
  if(command) return "command";

  if(extractLinks(rec).length) return "link";

  const main=safe(rec.__main||"");
  if((main==="resources"||main==="quests") && resourceKind(rec)==="OFFLINE"){
    return "offline-kodex";
  }

  if(main==="sets" && setFamilyStrict(rec) && setBlockForStrict(rec)){
    return "set-block";
  }

  return "";
}

const HOS_UI_AUDIT={
  sourceRecords:enriched.length,
  visibleRecords:0,
  archivedRecords:0,
  reasons:{command:0,link:0,"offline-kodex":0,dice:0,"set-block":0},
  archivedByMain:{},
  archivedExamples:[]
};

const UI_RECORDS=enriched.filter(rec=>{
  const reason=runtimeValueReason(rec);
  if(reason){
    HOS_UI_AUDIT.visibleRecords++;
    HOS_UI_AUDIT.reasons[reason]=(HOS_UI_AUDIT.reasons[reason]||0)+1;
    rec.__runtimeValueReason=reason;
    return true;
  }

  HOS_UI_AUDIT.archivedRecords++;
  const main=safe(rec.__main||"unbekannt");
  HOS_UI_AUDIT.archivedByMain[main]=(HOS_UI_AUDIT.archivedByMain[main]||0)+1;
  if(HOS_UI_AUDIT.archivedExamples.length<80){
    HOS_UI_AUDIT.archivedExamples.push({
      id:safe(rec.id),
      name:safe(rec.name),
      main,
      section:safe(rec.section),
      group:safe(rec.group)
    });
  }
  return false;
});

const HOS_PLAYER_HORSE_COMMANDS=new Set(
  UI_RECORDS
    .filter(rec=>rec.__main!=="workshop" && isHorseGearCandidate(rec))
    .map(horseCommandKey)
    .filter(Boolean)
);
function isHorseWorkshopMirror(rec){
  if(rec.__main!=="workshop" || !isHorseGearCandidate(rec)) return false;
  const cmd=horseCommandKey(rec);
  return !!cmd && HOS_PLAYER_HORSE_COMMANDS.has(cmd);
}
function dedupeHorseCommands(list){
  const out=[];
  const seen=new Set();
  for(const rec of list){
    if(!isHorseGearCandidate(rec)){
      out.push(rec);
      continue;
    }
    const cmd=horseCommandKey(rec);
    if(cmd && seen.has(cmd)) continue;
    if(cmd) seen.add(cmd);
    out.push(rec);
  }
  return out;
}

window.HEINRICHOS_UI_AUDIT=Object.freeze(HOS_UI_AUDIT);
console.info("[HEINRICHOS TEST23] UI-Nutzwertfilter",HOS_UI_AUDIT);
window.HEINRICHOS_FINAL_AUDIT_PATCH=Object.freeze({
  remappedResourceIds:Array.from(HOS_FINAL_AUDIT_RESOURCE_REMAP_IDS),
  hiddenIds:Array.from(HOS_FINAL_AUDIT_HIDDEN_IDS),
  linkedPdfIds:Array.from(HOS_FINAL_AUDIT_LINKED_PDF_IDS)
});

function resourceCleanFieldRows(rec){
  const f = rec.fields || {};
  const skip = /^(cheat|befehl|code|item-id|uuid|id|key|konsole|command|befehl zum kopieren)$/i;
  const pairs = [];
  if(safe(rec.info).trim()) pairs.push(["Notiz / Inhalt", rec.info]);
  if(safe(rec.source).trim()) pairs.push(["Quelle", rec.source]);
  if(safe(rec.group).trim()) pairs.push(["Bereich", rec.group]);
  Object.entries(f).forEach(([k,v]) => {
    const key = safe(k).trim();
    const val = safe(v).trim();
    if(!val) return;
    if(skip.test(key)) return;
    if(/^url$/i.test(key)) return;
    if(/^https?:\/\//i.test(val)) return;
    if(val.length > 1200) return;
    pairs.push([key, val]);
  });
  const seen = new Set();
  const clean = pairs.filter(([k,v]) => {
    const sig = k+"|"+v;
    if(seen.has(sig)) return false;
    seen.add(sig);
    return true;
  }).slice(0, 12);
  if(!clean.length) return "";
  return `<div class="hos-resource-clean-fields">${clean.map(([k,v]) => `<div class="hos-field-row"><div class="hos-field-key">${esc(k)}</div><div class="hos-field-val">${esc(v)}</div></div>`).join("")}</div>`;
}

function pdfPanelHtml(rec){
  // PUBLIC T04: fremde Lösungsbuch-PDFs werden nicht mitverteilt.
  return "";
}

function resourceDetailPanelHtml(rec){
  if(!isResourceDetail(rec)) return "";
  const kind = typeof resourceKind === "function" ? resourceKind(rec) : "ONLINE";
  const sub = rec.__sub || "";
  const badge = typeof sourceBadgeHtml === "function" ? sourceBadgeHtml(rec) : "";
  let title = "Lösung / Quelle";
  let text = "Hier stehen Link, Notiz und Quelle im Vordergrund. Cheat-Key und Konsolenbefehl werden in diesem Bereich bewusst ausgeblendet.";
  if(kind === "OFFLINE"){
    title = "Offline-Kodex";
    text = "Die aufbereiteten Kodexdaten sind direkt im HeinrichOS-Paket vorhanden und funktionieren ohne Internetzugriff.";
  }else if(kind === "ONLINE"){
    title = sub || "Eurogamer Online";
    text = "Online-Lösung: Öffnen über den Linkbutton. Cheat-/Codefelder werden hier bewusst ausgeblendet.";
  }else if(kind === "KARTE"){
    title = "Interaktive Karte / Fundort";
    text = "Karten- oder Fundortquelle. Öffnen über den Karten-/Linkbutton.";
  }else if(kind === "VIDEO"){
    title = "Video-Guide";
    text = "Videoquelle. Öffnen über den Videobutton.";
  }
  return `<div class="hos-resource-detail-panel">
    <div class="hos-resource-detail-title">${badge}${esc(title)}</div>
    <div class="hos-resource-detail-text">${esc(text)}</div>
    ${resourceCleanFieldRows(rec)}
  </div>`;
}


function bindPdfPanel(){
  $$(".hos-pdf-open").forEach(btn=>btn.addEventListener("click",()=>{
    const old=btn.textContent;
    btn.textContent="PDF wird geöffnet…";
    setTimeout(()=>btn.textContent=old||"PDF öffnen",1200);
  }));
  $$(".hos-pdf-copy").forEach(btn=>btn.addEventListener("click",()=>copyText(btn.getAttribute("data-pdf")||"").then(ok=>{
    btn.textContent=ok?"✅ PDF-Pfad kopiert":"Nicht kopiert";
    setTimeout(()=>btn.textContent="PDF-Pfad kopieren",1400);
  })));
}




function detailFieldRowsLimited(rec){
  const entries=playerFieldEntries(rec);
  if(!entries.length) return `<div class="hos-field-row"><b class="hos-field-key">Hinweis</b><span class="hos-field-value">Keine zusätzlichen Spielerinformationen vorhanden.</span></div>`;
  return entries.slice(0,8).map(([k,v])=>{
    let val=playerSafeText(v);
    if(val.length>260) val=val.slice(0,259)+"…";
    const cmd=/wh_cheat_addItem|cheat_|#player|wh_/i.test(val);
    const label=norm(k)==="status"?"Merkmal":k;
    return `<div class="hos-field-row ${cmd?'hos-field-row-command':''}"><b class="hos-field-key">${esc(label)}</b><span class="hos-field-value">${esc(val)}</span></div>`;
  }).join("");
}
function detailCommandHtml(rec, cmd){
  if(isResourceDetail(rec)) return `<div class="hos-kodex-section"><h4>Quelle / Link</h4><div>Für Lösungen und Karten stehen Link-/PDF-Bereiche unten im Kodex.</div></div>`;
  if(!cmd){
    return `<div class="hos-kodex-section hos-no-command-section"><h4>Cheat / Befehl</h4><div class="hos-no-command-box">Kein direkter Cheat/Befehl in diesem Datensatz. Bei Sets bitte den Set-Komfortblock darunter prüfen.</div></div>`;
  }
  return `<div class="hos-kodex-section"><h4>Cheat / Befehl</h4><div class="hos-detail-button-row"><button class="hos-action-btn" id="hos-copy-main-command">Befehl kopieren</button></div><div class="hos-command-text" id="hos-command-box">${esc(cmd)}</div><div id="hos-copy-feedback" class="hos-copy-feedback"></div></div>`;
}


function detailHeroAsset(rec){
  // P02J_DETAIL_HERO_REVEAL_01: vorhandene V11-Grossassets im Detail groesser nutzen.
  // Keine Datenlogik, keine f116-Aenderung; nur Darstellung/Assetwahl aus bestehenden Slots.
  return resolvedRecordAsset(rec);
}

function detailMetricRows(rec){
  const f=rec.fields||{};
  if(isDiceRecord(rec)){
    return [
      ["Englischer Rohname",field(rec,"Englischer Rohname")||rec.english_name],
      ["HeinrichOS-Wertung",field(rec,"HeinrichOS-Wertung")],
      ["Praktische Tendenz",field(rec,"Praktische Tendenz / Nutzen")],
      ["Würfeltendenz",playerFieldValue(rec,"Würfeltendenz")]
    ].filter(row=>safe(row[1]).trim());
  }
  const aliases=[
    ["Angriff",["Angriff","Schaden","Schaden (Stich)","Schaden (Schlag)","Schaden (Schnitt)"]],
    ["Verteidigung",["Verteidigung","Schutz/Wert","Schutz"]],
    ["Stich",["Stich","Schaden (Stich)"]],
    ["Schlag",["Schlag","Schaden (Schlag)"]],
    ["Schnitt",["Schnitt","Schaden (Schnitt)"]],
    ["Wucht",["Wucht","Wuchtschutz"]],
    ["Charisma",["Charisma"]],
    ["Sichtbarkeit",["Sichtbarkeit"]],
    ["Geräusch",["Geräusch","Geraeusch"]],
    ["Gewicht",["Gewicht"]],
    ["Wert",["Preis ca.","Preis","Wert"]]
  ];
  const rows=[];
  const used=new Set();
  for(const [label,keys] of aliases){
    for(const k of keys){
      const v=playerFieldValue(rec,k);
      if(v){ rows.push([label,v]); used.add(k); break; }
    }
  }
  if(!rows.length && primaryValue(rec)) rows.push(["Primärwert", primaryValue(rec)]);
  return rows.slice(0,10);
}

function detailInfoText(rec){
  const candidates=[
    ["Fundort / Quellenhinweis",field(rec,"Fundort / Quellenhinweis")],
    ["Info / Fundort / Händler / Quest",field(rec,"Info / Fundort / Händler / Quest")],
    ["Fundort",field(rec,"Fundort")],
    ["Fundorte",field(rec,"Fundorte")],
    ["Hinweis",field(rec,"Hinweis")]
  ];
  for(const [key,value] of candidates){
    if(playerFieldIsVisible(key,value)) return playerSafeText(value);
  }
  return playerSafeText(rec&&rec.info);
}

function detailTipText(rec){
  const candidates=[
    ["HeinrichOS-Einschätzung",field(rec,"HeinrichOS-Einschätzung")],
    ["HeinrichOS-Tipp",field(rec,"HeinrichOS-Tipp")],
    ["Tipp",field(rec,"Tipp")],
    ["Notiz",field(rec,"Notiz")]
  ];
  for(const [key,value] of candidates){
    if(playerFieldIsVisible(key,value)) return playerSafeText(value);
  }
  return "";
}

// TEST25_34_FINALKORREKTUR_02: Identische Hinweise nur einmal anzeigen.
// Daten bleiben unverändert; nur die sichtbare Wiederholung in Kodex/Detailtafel wird vermieden.
