alias_loot_catherinelovepotion|alias_loot_catherinelovepotion|cbac5af5-ce2a-43fc-acf9-e979fda27915":{"name":"Katharinas Liebestrank","family":"Katharinas Liebestrank","quality":"Normal / Sonder","rank":2,"status":"MUSS","sub":"Quest/Sondertränke"},"wh_cheat_additem alias_loot_pesekpotion|alias_loot_pesekpotion|556de5e7-350a-4b85-963d-6d6753f0ced9":{"name":"Pescheks Trank","family":"Pescheks Trank","quality":"Normal / Sonder","rank":2,"status":"MUSS","sub":"Quest/Sondertränke"},"wh_cheat_additem alias_loot_lorecherbicide|alias_loot_lorecherbicide|b7ff26f3-24a4-46c2-97b8-655da1827190":{"name":"Unkrautvernichter vom Weingut","family":"Unkrautvernichter vom Weingut","quality":"Normal / Sonder","rank":2,"status":"MUSS","sub":"Quest/Sondertränke"}}));
const HOS_ALCHEMY_V6_META_BY_COMMAND=new Map();
HOS_ALCHEMY_V4_ITEM_META.forEach((meta,key)=>{
  const command=safe(key).split("|")[0];
  if(command && !HOS_ALCHEMY_V6_META_BY_COMMAND.has(command)) HOS_ALCHEMY_V6_META_BY_COMMAND.set(command,meta);
});

const HOS_ALCHEMY_V4_TARGET_DISPLAY_NAMES=new Set();
const HOS_ALCHEMY_V4_ITEM_DROP_FIELDS=new Set(["Statusregel","Abgleich","Kuratiert 04","Spieleransicht","Variante","Wirkung kurz","Wirkung / Info","Info / Wirkung","Kurzformel","HeinrichOS-Tipp","Name"]);
const HOS_ALCHEMY_V4_OPEN_CONTENT_FIELDS=new Set(["Wirkung","Qualitätsstufe","Qualitätslogik","Exakter bestätigter Wert","Dauer","Nebenwirkung/Wechselwirkung","Einsatzgebiet","Grundflüssigkeit","Zutaten","Zutaten / Material","Kurze Brauanleitung","Rezept-/Zutatenverweis"]);
const HOS_ALCHEMY_V4_RECIPE_DROP_FIELDS=new Set(["Statusregel","Abgleich","Kuratiert 04","Spieleransicht","Befehl prüfen","Automatisch lernbar","Sichtbarkeit","Stufe","Fertigkeits-Selector","UI-Priorität","Vorteil-UI-Name","Deutscher Anzeigename"]);
const HOS_ALCHEMY_V4_PHYSICAL_RECIPE_DROP_FIELDS=new Set();
const HOS_ALCHEMY_V7_PROTECTED_FIELDS=new Set(["Preis ca.","Preis","Wert","Cheat zum Kopieren","Befehl zum Kopieren","Befehl","Interner Name","UUID","UUID-Fallback","Nahrung","Gesundheit","Energie","Alkohol","Gewicht","Haltbarkeit","IconID","UI-Name-Key","UI-Info-Key","Questitem","Quest-Item"]);
const HOS_ALCHEMY_V7_TECHNICAL_COPY_FIELDS=["Interner Name","UUID","UUID-Fallback","Game-Kategorie","Unterkategorie","Nahrung","Gesundheit","Energie","Alkohol","Gewicht","Haltbarkeit","IconID","UI-Name-Key","UI-Info-Key","Questitem","Quest-Item"];
function hosAlchemyV3Norm(value){ return safe(value).replace(/\s+/g," ").trim().toLowerCase(); }
function hosAlchemyV3Command(rec){
  const candidates=[rec&&rec.cheat,field(rec,"Befehl zum Kopieren"),field(rec,"Cheat zum Kopieren"),field(rec,"Befehl prüfen"),field(rec,"Befehl")];
  for(const value of candidates){
    const clean=safe(value).replace(/\s+/g," ").trim();
    if(/^(?:wh_|cheat_|#)/i.test(clean)) return clean;
  }
  return primaryCommand(rec);
}
function hosAlchemyV3ItemKey(rec){ return [hosAlchemyV3Norm(hosAlchemyV3Command(rec)),hosAlchemyV3Norm(field(rec,"Interner Name")),hosAlchemyV3Norm(field(rec,"UUID"))].join("|"); }
function hosAlchemyV3RecipeKey(rec){ return [hosAlchemyV3Norm(hosAlchemyV3Command(rec)),hosAlchemyV3Norm(field(rec,"UUID"))].join("|"); }
function hosAlchemyV4IsStaleHint(value){
  return /später|spaeter|prüfen|pruefen|fextralife|log-dump|stichprobe|item-id|reiter 18|kuratierungsstart|einbau fachlich/.test(norm(value));
}
function hosAlchemyV4CleanFields(rec,extra,mode){
  const current=(rec&&rec.fields&&typeof rec.fields==="object")?rec.fields:{};
  const out=Object.assign({},extra||{});
  Object.entries(current).forEach(([key,value])=>{
    if(HOS_ALCHEMY_V7_PROTECTED_FIELDS.has(key)){
      out[key]=value; // vorhandene Preise, Cheats, IDs und Spielwerte bleiben verbindlich.
      return;
    }
    if(Object.prototype.hasOwnProperty.call(out,key)) return;
    if(mode==="recipe-ready" && HOS_ALCHEMY_V4_RECIPE_DROP_FIELDS.has(key)) return;
    if((mode==="item-ready"||mode==="item-open") && HOS_ALCHEMY_V4_ITEM_DROP_FIELDS.has(key)) return;
    if(mode==="item-open" && HOS_ALCHEMY_V4_OPEN_CONTENT_FIELDS.has(key)) return;
    if(mode==="physical-recipe" && HOS_ALCHEMY_V4_PHYSICAL_RECIPE_DROP_FIELDS.has(key)) return;
    if((key==="Hinweis"||key==="HeinrichOS-Tipp") && hosAlchemyV4IsStaleHint(value)) return;
    out[key]=value;
  });
  rec.fields=out;
}
function hosAlchemyV3PrependFields(rec,extra,mode="item-ready"){
  hosAlchemyV4CleanFields(rec,extra,mode);
}
function hosAlchemyV4IsPhysicalRecipeRecord(rec){
  const title=norm(displayRecordName(rec)||rec&&rec.name||field(rec,"Name"));
  const cmd=norm(primaryCommand(rec)||rec&&rec.cheat||"");
  return /^rezept fuer\b/.test(title) && /^wh_cheat_additem\b/.test(cmd);
}
function hosAlchemyV4PreparePhysicalRecipe(rec){
  if(!hosAlchemyV4IsPhysicalRecipeRecord(rec)) return false;
  const family=safe(displayRecordName(rec)||rec.name||"").replace(/^Rezept für\s+/i,"").trim();
  const extra={
    "Rolle im Spiel":"Physischer Rezeptgegenstand",
    "Zugehörige Trank-/Giftfamilie":family,
    "Abgrenzung":"Schaltet das zugehörige Alchemie-Rezept frei; dies ist nicht der fertige Trank und nicht der Rezept-erlernen-Perk.",
    "Alchemie-Prüfstatus":"V4 geprüft – Spielrolle sauber getrennt"
  };
  hosAlchemyV4CleanFields(rec,extra,"physical-recipe");
  rec.__hosAlchemyPhysicalRecipe=true;
  rec.__hosAlchemyFamily=family;
  rec.__hosAlchemyQualityRank=0;
  rec.__hosAlchemyRoleRank=1;
  rec.info=`Physischer Rezeptgegenstand: Schaltet das Rezept für ${family} frei; dies ist nicht der fertige Trank.`;
  rec.status="Physischer Rezeptgegenstand – Rolle geprüft";
  return true;
}
function hosAlchemyV5TechnicalCode(rec){
  return norm(field(rec,"Interner Name")||primaryCommand(rec)||rec&&rec.cheat||"").replace(/^.*?wh_cheat_additem\s+/,"").split(/\s+/)[0]||"";
}
function hosAlchemyV5LabelTechnicalVariants(rec){
  const code=hosAlchemyV5TechnicalCode(rec);
  const labels={
    "kucharskakniha_knownpotion":"Kubas Trank (bekannte Variante)",
    "kucharskakniha_suspiciouspotion":"Kubas Trank (verdächtige Variante)",
    "kucharskakniha_unknownpotion":"Kubas Trank (unbekannte Variante)",
    "hooch":"Schnaps (hooch)",
    "spirits":"Schnaps (spirits)"
  };
  if(labels[code]) rec.name=labels[code];
}
function hosAlchemyV5ExactCommandKey(rec,main="potions"){
  const cmd=norm(primaryCommand(rec)||rec&&rec.cheat||"").replace(/\s+/g," ").trim();
  return cmd?`${main}|command|${cmd}`:"";
}
function hosAlchemyV5PreferenceScore(rec){
  let score=0;
  if(rec&&rec.__hosAlchemyV3Status) score+=100000;
  if(rec&&rec.__hosAlchemyV3RecipeReady) score+=100000;
  if(rec&&rec.__hosAlchemyPhysicalRecipe) score+=50000;
  if(rec&&rec.__hosAlchemyExtra) score+=20000;
  const sheet=norm(rec&&rec.sheet);
  if(/^07_traenke$/.test(sheet)||/^08_gifte$/.test(sheet)) score+=10000;
  if(/gamelog/i.test(safe(rec&&rec.kind)+" "+safe(rec&&rec.sheet))) score-=1000;
  score+=Object.keys((rec&&rec.fields)||{}).length;
  if(primaryCommand(rec)) score+=100;
  return score;
}
function hosAlchemyV5DedupeExactCommands(list,main="potions"){
  const out=[], positions=new Map();
  let hidden=0;
  for(const rec of list){
    const key=hosAlchemyV5ExactCommandKey(rec,main);
    if(!key){ out.push(rec); continue; }
    if(!positions.has(key)){
      positions.set(key,out.length);
      out.push(rec);
      continue;
    }
    hidden++;
    const idx=positions.get(key), kept=out[idx];
    if(hosAlchemyV5PreferenceScore(rec)>hosAlchemyV5PreferenceScore(kept)) out[idx]=rec;
  }
  HOS_ALCHEMY_V3_AUDIT.exactCommandDuplicatesHidden=Math.max(HOS_ALCHEMY_V3_AUDIT.exactCommandDuplicatesHidden||0,hidden);
  return out;
}
function hosAlchemyV6TargetScore(rec,entry){
  let score=0;
  const sheet=norm(rec&&rec.sheet), section=norm(rawSection(rec)), kind=norm(rec&&rec.kind);
  if(/^07_traenke$/.test(sheet)||/^08_gifte$/.test(sheet)) score+=1000000;
  if(hosAlchemyV3ItemKey(rec)===safe(entry&&entry.key)) score+=100000;
  if(field(rec,"UUID")) score+=20000;
  if(field(rec,"Interner Name")) score+=10000;
  if(/gamelog/.test(sheet+" "+kind)) score-=5000;
  if(/sets|top-empfehlungen/.test(section)) score-=50000;
  score+=Object.keys((rec&&rec.fields)||{}).length;
  return score;
}
function hosAlchemyV7ApplyStableKeyFields(target,entry){
  if(!target||!entry) return;
  target.fields=(target.fields&&typeof target.fields==="object")?target.fields:{};
  const parts=safe(entry.key).split("|");
  const internal=safe(parts[1]).trim();
  const uuid=safe(parts[2]).trim();
  if(internal && !safe(target.fields["Interner Name"]).trim()) target.fields["Interner Name"]=internal;
  if(uuid && !safe(target.fields["UUID"]).trim()) target.fields["UUID"]=uuid;
  if(uuid && !safe(target.fields["UUID-Fallback"]).trim()) target.fields["UUID-Fallback"]=`wh_cheat_addItem ${uuid}`;
}
function hosAlchemyV7MergeTechnicalFields(target,candidates){
  if(!target) return;
  target.fields=(target.fields&&typeof target.fields==="object")?target.fields:{};
  const sources=(candidates||[]).filter(rec=>rec&&rec!==target).sort((a,b)=>{
    const ae=/gamelog/.test(norm(a.sheet)+" "+norm(a.kind))?1:0;
    const be=/gamelog/.test(norm(b.sheet)+" "+norm(b.kind))?1:0;
    return be-ae;
  });
  for(const key of HOS_ALCHEMY_V7_TECHNICAL_COPY_FIELDS){
    if(safe(target.fields[key]).trim()) continue;
    for(const source of sources){
      const value=field(source,key);
      if(value){ target.fields[key]=value; break; }
    }
  }
}
function hosAlchemyV6SelectItemTargets(){
  const candidates=new Map();
  RECORDS.forEach((rec,index)=>{
    const command=hosAlchemyV6Command(rec);
    if(!HOS_ALCHEMY_V6_ITEM_BY_COMMAND.has(command)) return;
    if(!candidates.has(command)) candidates.set(command,[]);
    candidates.get(command).push({rec,index,score:hosAlchemyV6TargetScore(rec,HOS_ALCHEMY_V6_ITEM_BY_COMMAND.get(command))});
  });
  const selected=new Map();
  HOS_ALCHEMY_V6_ITEM_BY_COMMAND.forEach((entry,command)=>{
    const rows=(candidates.get(command)||[]).sort((a,b)=>b.score-a.score||a.index-b.index);
    if(rows.length) selected.set(command,{rec:rows[0].rec,candidates:rows.map(row=>row.rec)});
  });
  return selected;
}
function hosAlchemyV4Compare(a,b){
  const af=norm(a&&a.__hosAlchemyFamily), bf=norm(b&&b.__hosAlchemyFamily);
  if(af||bf){
    if(!af) return 1;
    if(!bf) return -1;
    const familyDelta=af.localeCompare(bf,"de");
    if(familyDelta) return familyDelta;
    const ar=Number.isFinite(Number(a.__hosAlchemyQualityRank))?Number(a.__hosAlchemyQualityRank):99;
    const br=Number.isFinite(Number(b.__hosAlchemyQualityRank))?Number(b.__hosAlchemyQualityRank):99;
    if(ar!==br) return ar-br;
    const roleA=Number.isFinite(Number(a.__hosAlchemyRoleRank))?Number(a.__hosAlchemyRoleRank):9;
    const roleB=Number.isFinite(Number(b.__hosAlchemyRoleRank))?Number(b.__hosAlchemyRoleRank):9;
    if(roleA!==roleB) return roleA-roleB;
  }
  return 0;
}
const HOS_ALCHEMY_V3_AUDIT={
  expectedItemReady:82, expectedItemOpen:18, expectedRecipeReady:22,
  itemReadyMatches:0, itemOpenMatches:0, recipeReadyMatches:0,
  duplicateItemKeys:[], duplicateRecipeKeys:[], resourceAdded:false,
  physicalRecipeRecords:0, legacyPotionDuplicatesHidden:0, exactCommandDuplicatesHidden:0,
  fallbackItemMatches:0, excludedHerbMaterials:0,
  expectedVisiblePotionCards:108, expectedUnderlyingPotionRecords:206,
  subfilters:{"Heilung":28,"Buffs":36,"Gifte":12,"Alkohol/Flair":14,"Quest/Sondertränke":18}
};
function hosAlchemyApplyV3(){
  const itemSeen=new Set(), recipeSeen=new Set();
  const selectedItems=hosAlchemyV6SelectItemTargets();

  RECORDS.forEach(rec=>{
    hosAlchemyV5LabelTechnicalVariants(rec);
    const command=hosAlchemyV6Command(rec);
    const selectedEntry=selectedItems.get(command);
    const selected=selectedEntry&&selectedEntry.rec;
    if(selected===rec){
      hosAlchemyV7MergeTechnicalFields(rec,selectedEntry.candidates);
      const entry=HOS_ALCHEMY_V6_ITEM_BY_COMMAND.get(command);
      hosAlchemyV7ApplyStableKeyFields(rec,entry);
      const status=HOS_ALCHEMY_V6_ITEM_STATUS_BY_COMMAND.get(command);
      const ready=status==="ready";
      const meta=HOS_ALCHEMY_V6_META_BY_COMMAND.get(command)||{};
      const mode=ready?"item-ready":"item-open";
      if(itemSeen.has(command)) HOS_ALCHEMY_V3_AUDIT.duplicateItemKeys.push(command);
      itemSeen.add(command);
      if(hosAlchemyV3ItemKey(rec)!==safe(entry&&entry.key)) HOS_ALCHEMY_V3_AUDIT.fallbackItemMatches++;
      hosAlchemyV3PrependFields(rec,entry.fields,mode);
      rec.__hosAlchemyPotionSub=safe(meta.sub||entry.sub);
      rec.__hosAlchemyV3Status=ready?"ready":"open";
      rec.__hosAlchemyFamily=safe(meta.family);
      rec.__hosAlchemyQuality=safe(meta.quality);
      rec.__hosAlchemyQualityRank=Number(meta.rank||9);
      rec.__hosAlchemyRoleRank=1;
      if(meta.name && !/^Kubas Trank$/i.test(meta.name)) rec.name=meta.name;
      hosAlchemyV5LabelTechnicalVariants(rec);
      const targetName=norm(meta.name||displayRecordName(rec)||rec.name||"").replace(/\s+/g," ").trim();
      if(targetName) HOS_ALCHEMY_V4_TARGET_DISPLAY_NAMES.add(targetName);
      if(ready){
        rec.status="Quellengeprüft";
        rec.info=safe(entry.fields&&entry.fields["Wirkung"])||"Wirkung und Rezeptdaten sind quellengeprüft ergänzt.";
        HOS_ALCHEMY_V3_AUDIT.itemReadyMatches++;
      }else{
        const hold=safe(meta.status)==="HALTEN";
        rec.status=hold?"Aliasprüfung offen":"Prüfstatus offen";
        rec.info=hold
          ?"Cheat und technische Kennung sind vorhanden. Die Aliaszuordnung ist noch offen; Wirkung und Zutaten werden nicht behauptet."
          :"Cheat und technische Kennung sind vorhanden. Wirkung, Zutaten oder Questbezug sind noch nicht sicher belegt.";
        HOS_ALCHEMY_V3_AUDIT.itemOpenMatches++;
      }
    }

    const recipeKey=hosAlchemyV3RecipeKey(rec);
    const recipe=HOS_ALCHEMY_V3_RECIPE_READY_MAP.get(recipeKey);
    if(recipe){
      if(recipeSeen.has(recipeKey)) HOS_ALCHEMY_V3_AUDIT.duplicateRecipeKeys.push(recipeKey);
      recipeSeen.add(recipeKey);
      hosAlchemyV3PrependFields(rec,recipe.fields,"recipe-ready");
      rec.__hosAlchemyV3RecipeReady=true;
      rec.__hosAlchemyFamily=safe(recipe.fields&&recipe.fields["Zugehörige Trank-/Giftfamilie"]);
      rec.__hosAlchemyQualityRank=0;
      rec.__hosAlchemyRoleRank=2;
      rec.status="Rezept-Perk quellengeprüft";
      rec.info=`Rezept-erlernen-Perk für ${rec.__hosAlchemyFamily||"Alchemie"}. Dies ist nicht der physische Rezeptgegenstand und nicht der fertige Trank.`;
      HOS_ALCHEMY_V3_AUDIT.recipeReadyMatches++;
    }

    if(hosAlchemyV4PreparePhysicalRecipe(rec)) HOS_ALCHEMY_V3_AUDIT.physicalRecipeRecords++;
    if(HOS_ALCHEMY_V6_EXTRA_SUB_BY_COMMAND.has(command) && !rec.__hosAlchemyV3Status){
      rec.__hosAlchemyExtra=true;
      rec.__hosAlchemyPotionSub=HOS_ALCHEMY_V6_EXTRA_SUB_BY_COMMAND.get(command);
      rec.status="Bestandskarte – Inhalt nicht quellengeprüft";
      rec.info="Vorhandener technischer Trank-/Getränkeeintrag. Name und Befehl bleiben erhalten; Wirkung und Zuordnung wurden in V3 nicht inhaltlich geprüft.";
      hosAlchemyV5LabelTechnicalVariants(rec);
    }
    if(hosAlchemyV6IsHerbMaterial(rec)) HOS_ALCHEMY_V3_AUDIT.excludedHerbMaterials++;
  });
  if(!RECORDS.some(rec=>safe(rec&&rec.id)===HOS_ALCHEMY_V3_RESOURCE.id)){
    RECORDS.push(HOS_ALCHEMY_V3_RESOURCE);
    HOS_ALCHEMY_V3_AUDIT.resourceAdded=true;
  }
  if(HOS_ALCHEMY_V3_AUDIT.itemReadyMatches!==82 || HOS_ALCHEMY_V3_AUDIT.itemOpenMatches!==18 || HOS_ALCHEMY_V3_AUDIT.recipeReadyMatches!==22 || HOS_ALCHEMY_V3_AUDIT.duplicateItemKeys.length || HOS_ALCHEMY_V3_AUDIT.duplicateRecipeKeys.length){
    console.warn("HEINRICHOS TEST25_33 Alchemie-V6-Zielprüfung weicht von der Freigabematrix ab.",HOS_ALCHEMY_V3_AUDIT);
  }
}
function hosAlchemyPotionSub(rec){
  if(safe(rec&&rec.__hosAlchemyPotionSub)) return safe(rec.__hosAlchemyPotionSub);
  const command=hosAlchemyV6Command(rec);
  const target=HOS_ALCHEMY_V6_ITEM_BY_COMMAND.get(command);
  if(target) return safe(target.sub);
  const extra=HOS_ALCHEMY_V6_EXTRA_SUB_BY_COMMAND.get(command);
  if(extra) return extra;
  return "";
}
function hosAlchemyRecipePatchKey(rec){
  if(rec&&rec.__hosAlchemyV3RecipeReady) return true;
  return HOS_ALCHEMY_V3_RECIPE_READY_MAP.has(hosAlchemyV3RecipeKey(rec));
}
hosAlchemyApplyV3();
window.HEINRICHOS_ALCHEMIE_V3_PATCH_AUDIT=HOS_ALCHEMY_V3_AUDIT;

/* =====================================================================
   HEINRICHOS KCD2 – PLAYER/USB FEEDBACK HOTFIX V3 – 16.08.2026
   FB-01/02/03/05/07 – Player-Sichtlogik auf Fixpunktstand.
   Roh-/Quelldaten bleiben unangetastet; f116_data.js wird nicht veraendert.
   Marker: HOS_PLAYER_USB_FEEDBACK_HOTFIX_V3_20260816
   ===================================================================== */
const HOS_PLAYER_USB_FEEDBACK_HOTFIX_V3_20260816 = true;

SUBFILTERS.workshop=["Alle","Prüfen","Prüfhilfe/Fallback","Versteckte Skills","Codex/Wissen","Game-Log Perks prüfen","Fehlgeschlagen","getestet","Raw/Log","Suchbefehle"];

function hosUsbV3SkillQcOnly(rec){
  const section=norm(rawSection(rec));
  if(!/^(attribute & skills|attribute & fertigkeiten)$/.test(section)) return false;
  const meta=norm([rawGroup(rec),rec&&rec.status].join(" "));
  return /pruefhilfe|fallback|altvariante|nicht als hauptbefehl/.test(meta);
}

const hosUsbV3BaseMainKey=mainKey;
mainKey=function(rec){
  const kind=safe(rec&&rec.kind);
  if(kind==="gamelog_skill"){
    const hidden=norm(field(rec,"Hidden")||field(rec,"Versteckt"));
    const sub=norm(field(rec,"Unterkategorie"));
    return (/^(ja|yes|true|1)$/.test(hidden)||sub==="versteckte fertigkeiten") ? "workshop" : "skills";
  }
  if(kind==="gamelog_perk"){
    const sub=norm(field(rec,"Unterkategorie"));
    if(sub==="alchemie-rezepte" || sub==="schmiede-rezepte" || sub==="rezepte/sonstige") return "recipes";
    if(sub==="spieler-perks/skillbezug" || sub==="spieler-perks/autolearnable") return "skills";
    return "workshop";
  }
  if(hosUsbV3SkillQcOnly(rec)) return "workshop";
  return hosUsbV3BaseMainKey(rec);
};

const hosUsbV3BaseArmorSub=armorSub;
armorSub=function(rec){
  const title=norm(displayRecordName(rec)||rec.name||field(rec,"Name"));
  const command=norm(primaryCommand(rec)||rec.cheat||"");
  const code=(command.replace(/^.*?wh_cheat_additem\s+/,"").split(/\s+/)[0]||"");
  if(/^(gauntlets|gloves|handwrap)/.test(code) || /handschuh|panzerhandschuh|\bbandage\b/.test(title)) return "Handschuhe";
  if(/^(hood|f_veil|veil|scarf)/.test(code) || /gugel|kapuze|schleier|kopftuch|\btuch\b/.test(title)) return "Gugel/Kapuze";
  if(/^(ring|necklace|amulet|jewel)/.test(code) || /schmuck|\bring\b|amulett|amulet|halskette|skapulier|galgenschlinge/.test(title)) return "Schmuck";
  if(/^(bascinet|kettlehat|helmet|cap[0-9a-z_]|f_cap|coif|hat[0-9a-z_]|wreath|f_wreath|f_hairdecor|eyepatch)/.test(code) || /helm|beckenhaube|eisenhut|kettenhaube|\bkappe\b|\bhut\b|strohhut|\bmütze\b|stirnreif|stirnband|kranz|kopfbedeckung|kopfverband/.test(title)) return "Helm/Kopf";
  if(/^(waffenrock|tunic|gambeson|shirt|coat|jupon|pourpoint|caftan|f_cotehardie|f_surcote|habit)/.test(code) || /wappenrock|tunika|gambeson|mantel|oberteil|hemd|kaftan|cotehardie|habit/.test(title)) return "Kleidung/Oberteil";
  return hosUsbV3BaseArmorSub(rec);
};

const hosUsbV3BaseRecipeSub=recipeSub;
recipeSub=function(rec){
  if(safe(rec&&rec.kind)==="gamelog_perk"){
    const sub=norm(field(rec,"Unterkategorie"));
    if(sub==="schmiede-rezepte") return "Schmieden";
    if(sub==="alchemie-rezepte") return "Alchemie";
    if(sub==="rezepte/sonstige") return "Quest/Sonderrezepte";
  }
  return hosUsbV3BaseRecipeSub(rec);
};

const hosUsbV3BaseWorkshopSub=workshopSub;
workshopSub=function(rec){
  if(hosUsbV3SkillQcOnly(rec)) return "Prüfhilfe/Fallback";
  if(safe(rec&&rec.kind)==="gamelog_skill" && norm(field(rec,"Unterkategorie"))==="versteckte fertigkeiten") return "Versteckte Skills";
  if(safe(rec&&rec.kind)==="gamelog_perk"){
    const sub=norm(field(rec,"Unterkategorie"));
    if(sub==="codex/wissen") return "Codex/Wissen";
    if(sub==="sonstige perks/pruefen") return "Game-Log Perks prüfen";
  }
  return hosUsbV3BaseWorkshopSub(rec);
};

const hosUsbV3BaseDisplayDedupeKey=displayDedupeKey;
displayDedupeKey=function(rec,main){
  const cmd=norm(primaryCommand(rec)||rec.cheat||"").replace(/\s+/g," ").trim();
  const name=norm(displayRecordName(rec)||rec.name||"").replace(/[^a-z0-9]+/g," ").trim();
  if(main==="skills" && cmd) return "skills|"+cmd;
  if(main==="animals" && cmd) return "animals|"+cmd;
  if((main==="weapons" || main==="armor" || main==="food" || main==="materials") && cmd) return main+"|"+name+"|"+cmd;
  if(main==="materials") return "materials|"+name+"|"+safe(rec.__sub||"");
  return hosUsbV3BaseDisplayDedupeKey(rec,main);
};

const HOS_USB_PERF_COMMAND_KEY_CACHE=new WeakMap();
function hosUsbV3CommandKey(rec){
  if(rec&&typeof rec==="object"&&HOS_USB_PERF_COMMAND_KEY_CACHE.has(rec)) return HOS_USB_PERF_COMMAND_KEY_CACHE.get(rec);
  const key=norm(primaryCommand(rec)||rec&&rec.cheat||"")
    .replace(/\bexact:/g,"")
    .replace(/\s+/g," ")
    .trim();
  if(rec&&typeof rec==="object") HOS_USB_PERF_COMMAND_KEY_CACHE.set(rec,key);
  return key;
}
function hosUsbV3DedupeAll(list){
  // Player-Edition besitzt bereits die verbindliche 18er-Schnellzugriffsfolge.
  // In "Alles durchsuchen" duerfen deshalb nur genau diese Quick-Karten
  // teilnehmen; alte Quick-/Set-/Top-Spiegel bleiben intern erhalten.
  const finalQuickIds=new Set(HOS_PLAYER_QUICK_FINAL_ORDER.map(safe));
  const canonicalList=list.filter(rec=>rec.__main!=="quick" || finalQuickIds.has(safe(rec.id)));

  const playerCommands=new Set(
    canonicalList.filter(rec=>rec.__main!=="workshop").map(hosUsbV3CommandKey).filter(Boolean)
  );
  const withoutWorkshopMirrors=canonicalList.filter(rec=>{
    if(rec.__main!=="workshop") return true;
    const cmd=hosUsbV3CommandKey(rec);
    return !(cmd && playerCommands.has(cmd));
  });

  const groups=new Map();
  for(const rec of withoutWorkshopMirrors){
    const main=safe(rec.__main||"");
    if(!groups.has(main)) groups.set(main,[]);
    groups.get(main).push(rec);
  }
  const keep=new Set();
  for(const [main,group] of groups){
    const clean=dedupeForDisplay(group,main);
    clean.forEach(rec=>keep.add(rec));
  }

  const workshopSeen=new Set();
  return withoutWorkshopMirrors.filter(rec=>{
    if(!keep.has(rec)) return false;
    if(rec.__main!=="workshop") return true;
    const cmd=hosUsbV3CommandKey(rec);
    const name=norm(displayRecordName(rec)||rec.name||"").replace(/[^a-z0-9]+/g," ").trim();
    if(!cmd || !name) return true;
    const key=name+"|"+cmd;
    if(workshopSeen.has(key)) return false;
    workshopSeen.add(key);
    return true;
  });
}

const hosUsbV3BaseDedupeForDisplay=dedupeForDisplay;
dedupeForDisplay=function(list,mainKeyValue=state.main){
  const main=mainKeyValue||state.main;
  if(main==="all") return hosUsbV3DedupeAll(list);
  if(main==="materials"){
    const out=[],seen=new Set();
    for(const rec of list){
      const key=displayDedupeKey(rec,main);
      if(key && seen.has(key)) continue;
      if(key) seen.add(key);
      out.push(rec);
    }
    return out;
  }
  return hosUsbV3BaseDedupeForDisplay(list,main);
};

const enriched = RECORDS.map((r,i)=>Object.assign({},r,{__idx:i,__main:mainKey(r)}));
enriched.forEach(r=>{ r.__sub=subKey(r); r.__allSub=allSub(r); });


/* =====================================================================
   HOS PLAYER/USB FEEDBACK HOTFIX V3 CLEAN – PLAYER-SICHTSCHUTZ
   Interne Werkstatt-, QC-, Debug- und rohe Prüfdatensätze bleiben im
   Laufzeitspeicher erhalten, werden aber in der normalen Player-Ansicht
   nicht angeboten. Keine Quelldatei und insbesondere f116_data.js wird
   hierbei verändert.
   Marker: HOS_PLAYER_USB_FEEDBACK_HOTFIX_V3_CLEAN_20260816
   ===================================================================== */
const HOS_PLAYER_USB_FEEDBACK_HOTFIX_V3_CLEAN_20260816=true;
const HOS_PLAYER_USB_PERFORMANCE_FIX_20260822=true;

const HOS_USB_V3_CANONICAL_NON_GAMELOG_COMMANDS=new Set(
  enriched
    .filter(rec=>safe(rec&&rec.kind)!=="gamelog_buff")
    .map(hosUsbV3CommandKey)
    .filter(Boolean)
);

/* HOS_V2_PLAYER_FILTER_FIX01_20260907
   Der QC-Reiter 28_Cheat_ID_Check enthaelt 88 bereits bestaetigte Skillbuecher.
   Sie sind echte Spieler-Items und werden in der normalen Buchansicht benoetigt.
   Die Quelldaten bleiben unveraendert; freigegeben wird nur diese eng definierte
   Laufzeitgruppe. Debug-, Test-, GameLog- und offene QC-Faelle bleiben gesperrt. */
const HOS_V2_PLAYER_FILTER_FIX01_20260907=true;
function hosV2ConfirmedSkillBook(rec){
  if(!rec || safe(rec.__main)!=="books") return false;
  if(norm(rec.sheet)!=="28_cheat_id_check") return false;
  if(norm(field(rec,"Reiter"))!=="11_skillbuecher") return false;
  const status=norm(rec.status||field(rec,"Status"));
  if(status!=="ok_name_in_itemcodes" && status!=="ok_name_in_log") return false;
  const command=safe(primaryCommand(rec)||"").trim();
  if(!/^wh_cheat_addItem\s+[A-Za-z0-9_.:-]+(?:\s+\d+)?$/i.test(command)) return false;
  const uuid=safe(field(rec,"Gefundene UUID")||field(rec,"UUID")).trim();
  if(!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(uuid)) return false;
  return true;
}

function hosUsbV3IsInternalPlayerQc(rec){
  if(!rec) return true;
  // HOS_PLAYER_USB_DICE_FIX_20260822: Dice/Farkle records stay visible in Player view.
  if(isDiceRecord(rec)) return false;
  // FIX01: Nur bestaetigte echte Skillbuecher duerfen die allgemeine QC-Sperre passieren.
  if(hosV2ConfirmedSkillBook(rec)) return false;
  if(safe(rec.__main)==="workshop") return true;

  const kind=safe(rec.kind);
  const sheet=norm(rec.sheet);
  const section=norm(rawSection(rec));
  const group=norm(rawGroup(rec));
  const status=norm(rec.status);
  const source=norm(rec.source);
  const title=norm(displayRecordName(rec)||rec.name||field(rec,"Name"));
  const playerView=norm(field(rec,"Spieleransicht"));
  const meta=[sheet,section,group,status,source,title].join(" ");

  // Alte QC-Skillvarianten/Fallbacks: nur intern behalten.
  if(hosUsbV3SkillQcOnly(rec)) return true;

  // Der bekannte f116-QC-Reiter enthält sowohl freigegebene bestätigte Skills als
  // auch Kandidaten/Debug. Nur die ausdrücklich bestätigten/sicheren Karten
  // dürfen in der Player-Ansicht bleiben.
  if(sheet==="25_attribute_skills_buffs_qc"){
    const safeConfirmed=/getestet|vorhanden/.test(status)
      && !/altvariante|nicht als hauptbefehl|pruefhilfe|fallback|kritisch|debug|kandidat|noch nicht/.test(status);
    if(!safeConfirmed) return true;
  }

  // Andere explizite QC-/Prüfquellen in normalen Bereichen nur dann
  // ausblenden, wenn sie selbst einen offenen/technischen Status tragen.
  if(/(?:^|[_ -])(?:qc|pruef|prüf|cheat[_ -]?id[_ -]?check)(?:$|[_ -])/.test(sheet)
      && /pruef|prüf|debug|kritisch|fallback|altvariante|nicht normal|nicht benutzen|kandidat|roh|raw/.test(meta)
      && !/getestet/.test(status)) return true;

  if(/buff-qc|rohdaten|spieltest empfohlen/.test(source)
      && /pruef|prüf|debug|kritisch|kandidat|nicht normal|nicht benutzen/.test(status)) return true;

  // Rohe Game-Log-Buffs mit technischem Prüftitel gehören nicht in die
  // Spieleroberfläche. Lesbare, eigenständige Game-Log-Karten bleiben möglich.
  if(kind==="gamelog_buff"){
    const command=hosUsbV3CommandKey(rec);
    if(command && HOS_USB_V3_CANONICAL_NON_GAMELOG_COMMANDS.has(command)) return true;
    if(/technischer buff\/zustand|autotest\/debug|debug\/technisch|\(pruefen\)|\(prüfen\)/.test(title)) return true;
  }

  // Offene Game-Log-Rezept-/Perk-Karten mit sichtbarem "(prüfen)" sind
  // Werkstattmaterial, auch wenn ihre Familie intern bereits erkannt ist.
  if(kind==="gamelog_perk" && /\([^)]*(?:pruefen|prüfen)[^)]*\)/.test(title)) return true;

  // Explizite Metadaten "Nein / erst prüfen" allein sind kein pauschaler
  // Löschgrund: die V3-Klassifikation entscheidet vorher, welche Perks/Rezepte
  // bereits sinnvoll einsortiert sind. Nur verbleibende Werkstattfälle sind oben raus.
  void playerView;
  return false;
}

const HOS_USB_PERF_PLAYER_VISIBLE_CACHE=new WeakMap();
function hosUsbV3PlayerVisibleRecord(rec){
  if(rec&&typeof rec==="object"&&HOS_USB_PERF_PLAYER_VISIBLE_CACHE.has(rec)) return HOS_USB_PERF_PLAYER_VISIBLE_CACHE.get(rec);
  const visible=!hosUsbV3IsInternalPlayerQc(rec);
  if(rec&&typeof rec==="object") HOS_USB_PERF_PLAYER_VISIBLE_CACHE.set(rec,visible);
  return visible;
}

/* HOS_PLAYER_USB_FEEDBACK_HOTFIX_V3_20260816 – visuelle QC-Zuordnung */
const HOS_USB_V3_VISUAL_BY_COMMAND=new Map();
for(const candidate of enriched){
  if(candidate.__main==="workshop") continue;
  const key=hosUsbV3CommandKey(candidate);
  if(!key) continue;
  if(!HOS_USB_V3_VISUAL_BY_COMMAND.has(key)) HOS_USB_V3_VISUAL_BY_COMMAND.set(key,[]);
  HOS_USB_V3_VISUAL_BY_COMMAND.get(key).push(candidate);
}
function hosUsbV3VisualRecord(rec){
  if(!rec || rec.__main!=="workshop") return rec;
  const key=hosUsbV3CommandKey(rec);
  const candidates=key?HOS_USB_V3_VISUAL_BY_COMMAND.get(key):null;
  if(!candidates || !candidates.length) return rec;
  const sourceTab=norm(field(rec,"Reiter"));
  if(sourceTab){
    const exact=candidates.find(candidate=>norm(candidate.sheet)===sourceTab || norm(rawSection(candidate))===sourceTab);
    if(exact) return exact;
  }
  return candidates[0];
}
function hosUsbV3WorkshopVisualMain(rec){
  if(!rec || rec.__main!=="workshop") return safe(rec&&rec.__main||"");
  const source=(norm(rec.sheet)+" "+norm(rawSection(rec))+" "+norm(rawGroup(rec))+" "+norm(field(rec,"Unterkategorie"))+" "+norm(displayRecordName(rec))+" "+norm(primaryCommand(rec)||rec.cheat||""));
  if(/codex\/wissen|codex/.test(source)) return "books";
  if(/alchemie-rezepte|schmiede-rezepte|rezepte\/sonstige/.test(source)) return "recipes";
  if(/versteckte fertigkeiten|spieler-perks|gamelog_skills|gamelog_perks|skill|fertigkeit|perk|vorteil/.test(source)) return "skills";
  if(/tränk|medizinisch|potion/.test(source)) return "potions";
  if(/nahrung|jagd|food|meat|apple|pear|beer|mash|sausage|wurst/.test(source)) return "food";
  if(/langschwert|schwert|sword|axt|axe|streitkolben|mace|bogen|bow|armbrust|crossbow|pfeil|arrow|bolzen|bolt|waffe/.test(source)) return "weapons";
  if(/rüstung|ruest|armor|helm|hose|beinkleid|platten|pourpoint|gambeson|stiefel|schuh|handschuh|gauntlet|kürass|kuerass/.test(source)) return "armor";
  if(/kraut|kräuter|herb|material|zutat|ingredient/.test(source)) return "materials";
  if(/buch|skillbuch|book|schrift|codex/.test(source)) return "books";
  return "workshop";
}

function subIcon(rec){
  const contextMain=(state.main==="animals"&&isAnimalRelated(rec))?"animals":(rec.__main||state.main||"workshop");
  const contextSub=contextMain==="animals"?animalSub(rec):safe(rec.__sub||"");
  const title=norm(displayRecordName(rec)||field(rec,"Name"));
  const cmd=norm(primaryCommand(rec)||rec.cheat||"");
  const tc=title+" "+cmd;
  const q=(fn)=>ICON_QUICK+fn, c=(fn)=>ICON_CAT+fn, o=(fn)=>ICON_OBJ+fn;
  const old=(fn)=>"../02_ASSETS/v11_icons/"+fn;
  const playerAssetId=safe(rec&&rec.id);
  if(playerAssetId===HOS_V151_ALCHEMY_BUDDY_ID) return c("item_alchemy_mortar_herbs_potion_recipe_v11.png");
  if(HOS_PLAYER_HORSE_GUIDE_IDS.has(playerAssetId)) return HOS_PLAYER_HORSE_ASSET;
  if(playerAssetId===HOS_PLAYER_KRAKAUER_ID) return HOS_PLAYER_KRAKAUER_ASSET;
  if(HOS_PLAYER_DOG_CARE_IDS.has(playerAssetId)) return HOS_PLAYER_DOG_CARE_ASSET;

  if(isActualHorseGear(rec)){
    const kind=horseGearKind(rec);
    if(kind==="head") return c("item_horse_chanfron_head_armor_v11_inward_matte_transparent.png");
    if(kind==="harness") return c("item_horse_harness_crupper_v11_inward_matte_transparent.png");
    if(kind==="saddle") return c("item_horse_medieval_saddle_v11_inward_matte_transparent.png");
    if(kind==="bridle") return c("item_horse_medieval_bridle_v11_inward_matte_transparent.png");
    if(kind==="caparison") return c("item_horse_medieval_saddlecloth_v11_inward_matte_transparent.png");
    if(kind==="horseshoe") return old("v11_icon_horseshoe.svg");
    if(kind==="spurs") return old("v11_icon_spurs.svg");
    return old("v11_icon_horse.svg");
  }
  if(isDogTreat(rec)) return old("v11_icon_dog_bowl.svg");

  if(contextMain==="weapons"){
    const map={
      "Langschwerter":c("item_weapon_longsword_v11.png"),
      "Kurzschwerter/Schwerter":c("item_weapon_short_sword_dagger_v11_inward_matte_transparent.png"),
      "Jagdschwerter/Falchions":c("item_weapon_short_sword_dagger_v11_inward_matte_transparent.png"),
      "Säbel":c("item_weapon_short_sword_dagger_v11_inward_matte_transparent.png"),
      "Dolche/Messer":c("item_weapon_short_sword_dagger_v11_inward_matte_transparent.png"),
      "Äxte":c("item_weapon_axe_v11_inward_matte_transparent.png"),
      "Streitkolben/Keulen":c("item_weapon_hammer_mace_blunt_v11_inward_matte_transparent.png"),
      "Hämmer":c("item_weapon_hammer_mace_blunt_v11_inward_matte_transparent.png"),
      "Stangenwaffen":c("item_weapon_polearm_halberd_v11_inward_matte_transparent.png"),
      "Bögen":c("item_weapon_bow_v11_inward_matte_transparent.png"),
      "Armbrüste":c("item_weapon_crossbow_v11_inward_matte_transparent.png"),
      "Pfeile":c("item_weapon_ammunition_arrows_bolts_v11_inward_matte_transparent.png"),
      "Bolzen":c("item_weapon_ammunition_arrows_bolts_v11_inward_matte_transparent.png"),
      "Feuerwaffen":old("v11_icon_firearm.svg"),
      "Schilde":c("item_weapon_shield_v11_inward_matte_transparent.png"),
      "Sonstige Waffen":c("item_weapon_longsword_v11.png")
    };
    return map[weaponSub(rec)]||map[contextSub]||map["Sonstige Waffen"];
  }

  if(contextMain==="armor"){
    if(/stirnreif|stirnband|hairdecor/.test(tc)) return c("item_armor_helmet_head_v11_inward_matte_transparent.png");
    const map={
      "Helm/Kopf":c("item_armor_helmet_head_v11_inward_matte_transparent.png"),
      "Kleidung/Oberteil":c("item_armor_clothing_upper_gambeson_tunic_v11.png"),"Kürass/Brust":o("item_arm_chestplate_v11.png"),
      "Arme":c("item_armor_gauntlets_bracers_v11_inward_matte_transparent.png"),"Handschuhe":c("item_armor_gauntlets_bracers_v11_inward_matte_transparent.png"),
      "Beine":c("item_armor_leg_greaves_v11_inward_matte_transparent.png"),"Stiefel/Schuhe":c("item_armor_boots_footwear_v11_inward_matte_transparent.png"),
      "Gugel/Kapuze":c("item_armor_chainmail_coif_hood_v11_inward_matte_transparent.png"),"Schmuck":c("item_armor_jewelry_ring_amulet_v11_inward_matte_transparent.png"),
      "Kragen":c("item_armor_collar_gorget_v11_inward_matte_transparent.png"),"Sonstige Rüstung":old("v11_icon_unknown.svg")
    };
    return map[armorSub(rec)]||map[contextSub]||map["Sonstige Rüstung"];
  }

  if(contextMain==="animals"){
    const sub=animalSub(rec);
    if(sub==="Köter-Futter / Würste") return old("v11_icon_dog_bowl.svg");
    if(sub==="Hundeskill/Houndmaster") return old("v11_icon_houndmaster.svg");
    if(sub==="Köter/Hund") return old("v11_icon_dog.svg");
    return old("v11_icon_horse.svg");
  }
  if(contextMain==="quick"){
    if(/waschen|wash/.test(title)) return q("item_washing_basin_brush_v11.png");
    if(/heilen|heilung|heal/.test(title)) return q("item_healing_bandage_herbs_v11.png");
    if(/speichern|retter|schnaps|save/.test(title)) return q("item_quicksave_saviour_schnapps_v11.png");
    if(/groschen|geld|coin/.test(title)) return q("item_money_groschen_pouch_v11.png");
    if(/schloss|dietrich|lockpick/.test(title)) return q("item_lockpicks_lock_v11.png");
    if(/taschendieb|pickpocket/.test(title)) return q("item_pickpocket_thief_kit_v11.png");
    if(/unsichtbar|ghost|stealth/.test(title)) return q("item_invisibility_ghost_cloak_v11.png");
    return c("ui_nav_overview_home_v11_inward_matte_transparent.png");
  }
  if(contextMain==="potions") return c("item_alchemy_potion_v11.png");
  if(contextMain==="recipes") return contextSub==="Schmieden"?c("item_blacksmith_anvil_hammer_ingots_v11.png"):c("item_alchemy_mortar_herbs_potion_recipe_v11.png");
  if(contextMain==="materials"){
    if(contextSub==="Kräuter" || contextSub==="Alchemiezutaten") return c("item_material_herbs_plants_v11_inward_matte_transparent.png");
    if(contextSub==="Leder/Stoff") return c("item_material_leather_cloth_fur_v11_inward_matte_transparent.png");
    if(contextSub==="Sonstiges") return c("item_material_misc_crafting_v11_inward_matte_transparent.png");
    return c("item_material_smithing_metal_v11_inward_matte_transparent.png");
  }
  if(contextMain==="food") return c("item_material_food_supplies_v11_inward_matte_transparent.png");
  if(contextMain==="quests") return c("item_quest_location_map_compass_v11.png");
  if(contextMain==="resources") return /karte|fundort/i.test(contextSub)?c("item_quest_location_map_compass_v11.png"):c("item_tips_tricks_solutions_v11_inward_matte_transparent.png");
  if(contextMain==="books") return c("item_books_codex_recipe_scroll_v11.png");
  if(contextMain==="sets") return c("item_sets_outfit_loadout_v11.png");
  if(contextMain==="dice") return c("ui_category_dice_farkle_compass_v11_inward_matte_transparent.png");
  if(contextMain==="skills") return c("item_skills_training_medallion_v11.png");
  if(contextMain==="buffs") return c("item_buffs_charm_vial_talisman_v11.png");
  if(contextMain==="all") return c("ui_special_search_all_v11_inward_matte_transparent.png");
  if(contextMain==="workshop") return c("item_blacksmith_anvil_hammer_ingots_v11.png");
  return c("ui_special_search_all_v11_inward_matte_transparent.png");
}
/* HOS_PLAYER_USB_FEEDBACK_HOTFIX_V3_20260816 – Asset-Wrapper */
const hosUsbV3BaseSubIcon=subIcon;
subIcon=function(rec){
  let visualRec=hosUsbV3VisualRecord(rec)||rec;
  const inferred=(visualRec===rec && rec&&rec.__main==="workshop")?hosUsbV3WorkshopVisualMain(rec):safe(visualRec&&visualRec.__main||"");
  if(inferred && inferred!==safe(visualRec&&visualRec.__main||"")){
    visualRec=Object.assign({},visualRec,{__main:inferred});
    try{ visualRec.__sub=subKey(visualRec); }catch(_e){}
  }
  if(isActualHorseGear(visualRec)) return hosUsbV3BaseSubIcon(visualRec);
  const visualMain=safe(visualRec&&visualRec.__main||"");
  if(visualMain==="animals" || isAnimalRelated(visualRec)){
    const sub=animalSub(visualRec);
    if(sub==="Köter-Futter / Würste") return "../02_ASSETS/icons/v11_quickaccess/item_dog_food_bowl_bone_v11.png";
    if(sub==="Hundeskill/Houndmaster" || sub==="Köter/Hund") return "../02_ASSETS/icons/v11_quickaccess/ui_quick_dog_food_care_v11_inward_matte_transparent.png";
    return "../02_ASSETS/icons/v11_categories/item_horse_pebbles_medallion_v11_inward_matte_transparent.png";
  }
  return hosUsbV3BaseSubIcon(visualRec);
};

function resolvedRecordAsset(rec){
  return subIcon(rec);
}

function mainCount(key){
  if(key==="all") return recordsForMainKey("all").length;
  return dedupeForDisplay(recordsForMainKey(key),key).length;
} 
/* HOS_PLAYER_USB_FEEDBACK_HOTFIX_V3_20260816 – bereinigter Gesamtzaehler
   HOS_V2_PLAYER_FILTER_FIX01_20260907: Navigation und Ergebnisliste verwenden
   jetzt dieselbe Player-Sichtbarkeit. Interne QC-/Debug-Bestaende werden links
   nicht mehr mitgezaehlt, wenn sie in der Player-Mitte absichtlich verborgen sind. */
const hosUsbV3BaseMainCount=mainCount;
const HOS_USB_PERF_MAIN_COUNT_CACHE=new Map();
mainCount=function(key){
  if(key==="wardrobe") return Number(HOS_WARDROBE_DATA.lookCount||HOS_WARDROBE_PRESETS.length);
  if(key==="looks") return hosWardrobeFavoriteIds().length + hosWardrobeCustomLooks().length;
  if(HOS_USB_PERF_MAIN_COUNT_CACHE.has(key)) return HOS_USB_PERF_MAIN_COUNT_CACHE.get(key);
  const visible=recordsForMainKey(key).filter(hosUsbV3PlayerVisibleRecord);
  const count=dedupeForDisplay(visible,key).length;
  HOS_USB_PERF_MAIN_COUNT_CACHE.set(key,count);
  return count;
};

function currentNav(){return MAIN_NAV.find(n=>n.key===state.main)||MAIN_NAV[0];}

function recordsForMainKey(key){
  if(key==="quick"){
    const byId=new Map(UI_RECORDS.filter(r=>r.__main==="quick").map(r=>[safe(r.id),r]));
    return HOS_PLAYER_QUICK_FINAL_ORDER.map(id=>byId.get(id)).filter(Boolean);
  }
  if(key==="all") return dedupeHorseCommands(UI_RECORDS.filter(rec=>!isDiceRecord(rec) && !isHorseWorkshopMirror(rec) && safe(rec.kind)!=="hos_set_member_patch" && safe(rec.kind)!=="hos_set_anchor_patch"));
  if(key==="animals") return dedupeHorseCommands(UI_RECORDS.filter(isAnimalRelated));
  if(key==="food") return UI_RECORDS.filter(r=>(r.__main==="food"||isDogTreat(r))&&!isGameLogTestPlaceholder(r));
  let base=UI_RECORDS.filter(r=>r.__main===key);
  if(key==="armor") base=base.filter(r=>!isActualHorseGear(r));
  if(key==="sets") base=base.filter(r=>(!isActualHorseGear(r)||safe(r.kind)==="hos_set_member_patch")&&!isDogTreat(r)).filter(r=>{
    const fam=setFamilyStrict(r);
    if(fam && fam!=="Schleich-Set"){
      const id=norm(r.id), kind=safe(r.kind);
      return kind==="hos_set_member_patch" || kind==="hos_set_anchor_patch" || /^set(?:ordner|outfit|-)/.test(id);
    }
    return true;
  });
  if(key==="potions"){
    // V5: Gesamtbestand bleibt intern vollständig erhalten. Nur die Kartenansicht
    // fasst exakt gleiche Befehle zusammen; keine Namens- oder Volltextlöschung.
    HOS_ALCHEMY_V3_AUDIT.legacyPotionDuplicatesHidden=0;
  }
  if(key==="resources") base=base.filter(r=>!isEurogamerJunk(r));
  return base;
}
function recordsForCurrentMain(){
  return recordsForMainKey(state.main);
}
function subMatchesLabel(rec,label){
  const active=label||"";
  if(state.main==="all"){
    if(norm(active)==="alle daten") return true;
    return rec.__allSub===active;
  }
  if(active==="Wegweiser") return false;
  if(state.main==="dice"){
    if(active==="Alle Würfel") return true;
    const groups=diceGroups(rec);
    if(active==="Spawn prüfen") return groups.includes("Spawn prüfen") || /rohdaten vorhanden.*spawn pruefen/.test(norm(rec.status));
    return groups.includes(active) || diceSub(rec)===active;
  }
  if(active==="Alle Quellen" && state.main==="resources") return true;
  if(active==="Alle"||norm(active).startsWith("alle ")) return true;
  if(state.main==="animals") return animalSub(rec)===active;
  if(state.main==="food"){
    if(active==="Game-Log Nahrung") return isGameLogFoodSource(rec);
    if(active==="Game-Log neu/prüfen") return isGameLogFoodSource(rec) && /neu\s*\/\s*für heinrichos prüfen|neu_fuer_heinrichos_pruefung/i.test(field(rec,"Abgleich"));
    if(active==="Game-Log bereits erkannt") return isGameLogFoodSource(rec) && !/neu\s*\/\s*für heinrichos prüfen|neu_fuer_heinrichos_pruefung/i.test(field(rec,"Abgleich"));
    if(active==="F116 vorhandene Nahrung") return !isExternalFoodSource(rec) && !isGameLogFoodSource(rec);
    if(active==="Fextralife Food-Quelle") return isExternalFoodSource(rec);
    return foodSub(rec)===active;
  }
  return rec.__sub===active;
}
function queryMatches(rec){
  const q=norm(state.query).trim();
  if(!q) return true;
  const parts=q.split(/\s+/).filter(Boolean);
  const broad=querySearchIndex(rec);
  const rg=norm(rawGroup(rec));
  const narrowGroup=/^(hund|koeter|köter|dog|hound|houndmaster|hundeskill|hundemeister|hundefuehrung|hundeführung|koeter-futter|köter-futter)$/.test(rg)?rg:"";
  const animalStrong=norm([displayRecordName(rec),rec.name,primaryCommand(rec)||rec.cheat,field(rec,"Name/Thema"),field(rec,"Name"),narrowGroup].join(" "));
  return parts.every(part=>{
    if(state.main==="animals" && /^(hund|koeter|köter|dog|hound)$/.test(part)){
      return isDogTreat(rec)||/hund|koeter|köter|dog|hound/.test(animalStrong);
    }
    if(state.main==="animals" && /^(pferd|horse)$/.test(part)){
      return isActualHorseGear(rec)||/pferd|horse|pebbles/.test(animalStrong);
    }
    return broad.includes(part);
  });
}
function selectionBaseForSub(label,opts={}){
  let list=recordsForCurrentMain()
    .filter(hosUsbV3PlayerVisibleRecord)
    .filter(rec=>subMatchesLabel(rec,label))
    .filter(queryMatches);
  list=dedupeForDisplay(list,state.main);
  return list;
}
function statusBaseForCurrent(){ return selectionBaseForSub(state.sub,{ignoreStatus:true}); }
function subCount(label){
  return selectionBaseForSub(label).length;
}
function statusCount(value){
  const list=statusBaseForCurrent();
  return value==="all"?list.length:list.filter(rec=>statusMatches(rec,value)).length;
}
function subMatches(rec){ return subMatchesLabel(rec,state.sub); }
function selectionBase(){ return selectionBaseForSub(state.sub||SUBFILTERS[state.main]?.[0]||"Alle"); }
function filtered(){ return applySorting(selectionBase()); }

function primaryCommand(rec){
  const f = rec.fields || {};
  const kind = safe(rec.kind);

  function normalizeCommandText(txt){
    let s = safe(txt).replace(/\r/g," ").replace(/\n+/g," ").replace(/\s+/g," ").trim();
    s = s.replace(/^["'`]+|["'`]+$/g,"");
    return s;
  }

  function findCommandInText(txt){
    const t = safe(txt);
    if(!t.trim()) return "";

    const patterns = [
      /#player\.[^\r\n;|<>]+/i,
      /wh_cheat_addItem\s+[A-Za-z0-9_.:-]+(?:\s+\d+)?/i,
      /wh_cheat_addItem\s+[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?:\s+\d+)?/i,
      /cheat_add_buff\s+(?:exact:|any:)?[A-Za-z0-9_.:-]+(?:\s+[A-Za-z0-9_.:-]+)*/i,
      /cheat_add_perk\s+[A-Za-z0-9_.:-]+(?:\s+\d+)?/i,
      /cheat_set_skill_level\s+(?:exact:|any:)?[A-Za-z0-9_.:-]+(?:\s+level:\d+)?/i,
      /cheat_[A-Za-z0-9_:-]+(?:\s+[A-Za-z0-9_.:"'=-]+){0,6}/i,
      /wh_[A-Za-z0-9_:-]+\s+[A-Za-z0-9_.:-]+(?:\s+\d+)?/i
    ];

    for(const re of patterns){
      const m = t.match(re);
      if(m && m[0]) return normalizeCommandText(m[0]);
    }

    return "";
  }

  function commandFromInternalKey(key, val){
    const k = norm(key);
    const v = normalizeCommandText(val);
    if(!v) return "";

    // UUID als Item nur bei passenden ID-/UUID-Feldern.
    if(/uuid|item.?id|id|guid/.test(k) && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v)){
      return "wh_cheat_addItem " + v;
    }

    // Skillbooks / Itemcodes als Item nur bei passenden Cheat-/Item-/Intern-Feldern.
    if(/cheat|befehl|kopieren|interner|internal|item|code|id/.test(k) && /^[A-Za-z][A-Za-z0-9_.:-]{3,}$/.test(v)){
      if(/^skillbook_/i.test(v) || /Potion|Poison|potion|poison|Sword|sword|Axe|axe|Bow|bow|crossbow|Cuirass|Boots|Gauntlets|recipe_/i.test(v)){
        return "wh_cheat_addItem " + v;
      }
    }
    return "";
  }

  // Sonderlogik Game-Log bleibt erhalten.
  if(kind==="gamelog_food"){
    const direct = safe(f["Befehl zum Kopieren"] || f["Cheat zum Kopieren"] || f["Cheat-Befehl"] || rec.cheat);
    const found = findCommandInText(direct);
    if(found) return found;
    const internal = safe(f["Interner Name"]);
    const uuid = safe(f["UUID"]);
    if(internal) return "wh_cheat_addItem " + internal;
    if(uuid) return "wh_cheat_addItem " + uuid;
  }

  if(kind==="gamelog_buff"){
    const direct = safe(f["Befehl zum Kopieren"] || f["Cheat zum Kopieren"] || f["Befehl"] || rec.cheat);
    const found = findCommandInText(direct);
    if(found) return found;
    const internal = safe(f["Interner Name"]);
    const uuid = safe(f["UUID"]);
    if(internal) return "cheat_add_buff exact:" + internal;
    if(uuid) return "cheat_add_buff exact:" + uuid;
  }

  if(kind==="gamelog_perk"){
    const direct = safe(f["Befehl zum Kopieren"] || f["Cheat zum Kopieren"] || f["Befehl prüfen"] || rec.cheat);
    const found = findCommandInText(direct);
    if(found) return found;
    const uuid = safe(f["UUID"]);
    if(uuid) return "cheat_add_perk " + uuid;
  }

  if(kind==="gamelog_skill"){
    const direct = safe(f["Befehl zum Kopieren"] || f["Cheat zum Kopieren"] || f["Skill-Befehl"] || rec.cheat);
    const found = findCommandInText(direct);
    if(found) return found;
    const internal = safe(f["Interner Name"]);
    if(internal) return "cheat_set_skill_level exact:" + internal + " level:20";
    const sid = safe(f["Skill-ID"]);
    if(sid) return "cheat_add_skill_levels " + sid + " 1";
  }

  // Priorisierte Feldnamen aus Excel/Log/kuratierter Datenbank.
  const keys = [
    "Befehl zum Kopieren","Cheat zum Kopieren","Cheat-Befehl","Befehl","Cheat",
    "Komfortblock","Block","Cheatblock","Cheat-Block","Set-Block","Komplettblock",
    "Code","Item-ID","Item ID","Interner Name","Internal Name","UUID","ID"
  ];

  for(const k of keys){
    if(Object.prototype.hasOwnProperty.call(f,k)){
      const v = safe(f[k]).trim();
      if(!v) continue;
      const found = findCommandInText(v);
      if(found) return found;
      const generated = commandFromInternalKey(k, v);
      if(generated) return generated;
      // Bei eindeutigen Befehlsfeldern auch vorhandenen Wert durchreichen, falls er mit wh_/cheat_/# beginnt.
      if(/befehl|cheat|kopieren|code/i.test(k) && /^(wh_|cheat_|#)/i.test(v)) return normalizeCommandText(v);
    }
  }

  // Direkte rec.cheat-Quelle.
  const directRec = findCommandInText(rec.cheat);
  if(directRec) return directRec;

  // Letzte Sicherheitsstufe: Zusatzfelder nach echter Befehls-Signatur scannen.
  for(const [k,v] of Object.entries(f)){
    const found = findCommandInText(v);
    if(found) return found;
    const generated = commandFromInternalKey(k, v);
    if(generated) return generated;
  }

  return "";
}

function extractLinks(rec){
  const f = rec.fields || {};
  const sources = [
    ["URL", rec.url],
    ["Info", rec.info],
    ["Quelle", rec.source],
    ["Cheat", rec.cheat],
    ...Object.entries(f)
  ];
  const found = [];
  const seen = new Set();
  const re = /https?:\/\/[^\s<>'")\]]+/gi;
  sources.forEach(([label, value]) => {
    const text = safe(value);
    let m;
    while((m = re.exec(text))){
      let url = m[0].replace(/[.,;:]+$/,"");
      if(!seen.has(url)){
        seen.add(url);
        found.push({label:safe(label)||"Link", url});
      }
    }
  });
  return found;
}
function linkKind(url, label){
  const u = norm(url + " " + label);
  if(/eurogamer/.test(u)) return "Eurogamer / Komplettlösung";
  if(/mapgenie|map/.test(u)) return "Interaktive Karte";
  if(/youtube|youtu\.be/.test(u)) return "Video-Guide";
  if(/wiki|fandom/.test(u)) return "Wiki / Quelle";
  if(/reddit|steam/.test(u)) return "Community-Quelle";
  return label || "Quelle öffnen";
}

function linksPanelHtml(rec){
  const links = extractLinks(rec);
  if(!links.length){
    if(rec.__main === "resources" || rec.__main === "quests"){
      return `<div class="hos-link-panel"><div class="hos-link-title">Links / Karten / Lösungen</div><div class="hos-link-empty">In diesem Datensatz wurde kein direkter http-Link gefunden. Möglich: Quelle steht nur als Text oder ist in einem anderen Datensatz hinterlegt.</div></div>`;
    }
    return "";
  }
  return `<div class="hos-link-panel">
    <div class="hos-link-title">Links / Karten / Lösungen <span class="hos-resource-badge">${links.length}</span></div>
    <div class="hos-link-actions">
      ${links.map((l,i) => `<div class="hos-link-row">
        <div class="hos-link-label">${esc(linkKind(l.url,l.label))}<span class="hos-link-url">${esc(l.url)}</span></div>
        <button class="hos-link-open-btn" data-url="${esc(l.url)}">Link öffnen</button>
      </div>`).join("")}
    </div>
  </div>`;
}
function bindLinksPanel(){
  $all(".hos-link-open-btn").forEach(btn => {
    btn.addEventListener("click", (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      const url = btn.getAttribute("data-url") || "";
      if(url){
        window.open(url, "_blank", "noopener,noreferrer");
      }
    });
  });
}


function setFamily(rec){
  const id=norm(rec&&rec.id), title=norm(displayRecordName(rec)), explicit=norm(field(rec,"Set-Familie")||field(rec,"Set")||field(rec,"Setname")||field(rec,"Loadout"));
  const known=(value)=>{
    if(/brunswiek|bruncvik|loewenwappen/.test(value)) return "Brunswiek/Löwenwappen";
    if(/legaten|legat/.test(value)) return "Legaten";
    if(/jaegermeister/.test(value)) return "Jägermeister";
    if(/wanderer/.test(value)) return "Wanderer";
    if(/taschendieb/.test(value)) return "Taschendieb";
    if(/schleich-set|^schleich$/.test(value)) return "Schleich-Set";
    if(/schmiede-set|schmiedesatz|schmiede-outfit/.test(value)) return "Schmiede-Set";
    return "";
  };
  const byId=known(id); if(byId) return byId;
  const byPatch=known(field(rec,"Set-Familie")); if(byPatch) return byPatch;
  const byTitle=known(title); if(byTitle) return byTitle;
  // Bestehende Schleichkarten sind ausdrücklich über das Set-Feld gepflegt.
  if(/schleich-set|^schleich$/.test(explicit) || (/^sets \/ loadouts|^top-empfehlungen/.test(norm(rawSection(rec))) && /schleichen/.test(norm(rawGroup(rec))))) return "Schleich-Set";
  // Schmiede-Materialien/Anleitungen/Waffen mit altem Set-Feld bleiben aus dem Outfitfilter draußen.
  if(/schmiede-set|schmiedesatz/.test(explicit)){
    if(/heinrichs schmiedeschuerze|heinrichs schmiedehandschuhe|wappenrock von heinrichs schmiede|arbeitstuch|arbeitsstiefel|gesteppte hose/.test(title)) return "Schmiede-Set";
    return "Prüfen/Teilpositiv";
  }
  const st=norm(rec.status||"");
  if(/getestet|bestaetigt|funktioniert/.test(st)) return "Bestätigt/getestet";
  if(/pruefen|teilpositiv|unklar|fehlgeschlagen|testen/.test(st)) return "Prüfen/Teilpositiv";
  return "Alle Sets";
}
function setPartsFor(rec){
  const fam = setFamily(rec);
  if(!fam || fam === "Alle Sets") return [];
  return enriched.filter(x => x !== rec && setFamily(x) === fam && primaryCommand(x));
}

function setBlockFor(rec){
  const parts = setPartsFor(rec);
  const cmds = parts.map(primaryCommand).filter(Boolean);
  const own = primaryCommand(rec);
  if(cmds.length) return cmds.join("\\n");
  if(own) return own;
  return "";
}


function setPanelHtml(rec){
  const fam = setFamily(rec);
  if(rec.__main !== "sets" && state.main !== "sets") return "";
  let parts = setPartsFor(rec);
  const own = primaryCommand(rec);
  if(!parts.length && own){
    parts = [rec];
  }
  const block = setBlockFor(rec) || (own || "");
  const partHtml = parts.length ? parts.slice(0,100).map(p => {
    const cmd = primaryCommand(p);
    return `<div class="hos-set-part">
      <div class="hos-set-part-name">${esc(p.name||"(ohne Name)")}<span class="hos-set-part-meta">${esc(p.__sub||"")} · ${esc(p.status||"")}</span></div>
      <button class="hos-part-copy" data-copy="${esc(cmd)}" ${cmd?"":"disabled"}>Kopieren</button>
    </div>`;
  }).join("") : `<div class="hos-set-part"><div class="hos-set-part-name">Keine einzelnen Set-Teile mit kopierbarem Befehl in dieser Gruppierung gefunden.</div></div>`;
  return `<div class="hos-set-panel">
    <div class="hos-set-title">Set-Komfort: ${esc(fam)}</div>
    <div class="hos-set-actions">
      <button id="hos-copy-set-block" ${block ? "" : "disabled"}>Kompletten Block kopieren</button>
      <button id="hos-copy-visible-parts" ${parts.length ? "" : "disabled"}>Alle Einzelteile kopieren</button>
    </div>
    <div class="hos-set-parts">${partHtml}</div>
    <div class="hos-set-warning">Hinweis: Komfortblock ist Bequemlichkeit. Vorher speichern. Einzelcheats bleiben Referenz. Wenn ein Set-Teil fehlt, bitte Name melden.</div>
    <div id="hos-set-copy-feedback" class="hos-copy-ok"></div>
  </div>`;
}

function bindSetPanel(rec){
  const fb = $("#hos-set-copy-feedback");
  const blockBtn = $("#hos-copy-set-block");
  if(blockBtn){
    blockBtn.addEventListener("click", () => {
      const block = setBlockFor(rec);
      copyText(block).then(ok => { if(fb) fb.textContent = ok ? "✅ Set-Block kopiert!" : "Kopieren nicht möglich – bitte manuell markieren."; });
    });
  }
  const visibleBtn = $("#hos-copy-visible-parts");
  if(visibleBtn){
    visibleBtn.addEventListener("click", () => {
      const block = setPartsFor(rec).map(primaryCommand).filter(Boolean).join("\n");
      copyText(block).then(ok => { if(fb) fb.textContent = ok ? "✅ Einzelteile als Block kopiert!" : "Kopieren nicht möglich – bitte manuell markieren."; });
    });
  }
  $all(".hos-part-copy").forEach(btn => {
    btn.addEventListener("click", () => {
      const text = btn.getAttribute("data-copy") || "";
      copyText(text).then(ok => { if(fb) fb.textContent = ok ? "✅ Einzelteil kopiert!" : "Kopieren nicht möglich – bitte manuell markieren."; });
    });
  });
}

function primaryValue(rec){
  if(isDiceRecord(rec)) return playerFieldValue(rec,"HeinrichOS-Wertung");
  const f=rec.fields||{}; const keys=["Wert","Preis","Schaden","Schutz","Charisma","Sichtbarkeit","Geräusch","Gewicht","Dauer","Status"];
  for(const k of keys){
    const value=playerFieldValue(rec,k);
    if(value) return value;
  }
  return "";
}
function statusClass(status){
  const s=norm(status);
  if(/bestätigt|bestaetigt|ramon|getestet|funktioniert|ok/.test(s))return"ok";
  if(/fehlgeschlagen|fail|falsch|fehler/.test(s))return"bad";
  if(/prüfen|pruefen|unklar|teilpositiv|roh|raw/.test(s))return"warn";
  return "";
}

function renderNav(){
  const nav=$("#hos-nav-list")||$(".nav-list"); if(!nav)return;
  const items=MAIN_NAV.filter(n=>n.key!=="workshop");
  nav.innerHTML=items.map(n=>`<li class="nav-item ${n.special?"hos-all-search":""} ${state.main===n.key?"active":""}" data-main="${n.key}">
      <div class="nav-icon-wrapper"><img src="${n.icon}" class="nav-icon" alt=""></div>
      <span class="nav-text">${esc(n.label)}</span>
      <div class="nav-count-wrapper"><span class="nav-count hos-count-pill" data-count-key="${n.key}">...</span></div>
    </li>`).join("");
  nav.querySelectorAll(".nav-item").forEach(el=>el.addEventListener("click",()=>{
    state.main=el.getAttribute("data-main")||"all";
    clearTimeout(window.__hosRegisterSearchTimer);
    state.query="";
    const hiddenSearch=$("#hos-search")||$(".search-input"); if(hiddenSearch) hiddenSearch.value="";
    state.sub=SUBFILTERS[state.main]?.[0]||"Alle";
    state.visible=HOS_VISIBLE_STEP; state.selectedId=null; state.sort="standard"; state.status="all"; renderAll(false);
  }));
  setTimeout(()=>{
    if(!nav.isConnected)return;
    for(const n of items){
      const pill=nav.querySelector(`.nav-count[data-count-key="${n.key}"]`);
      if(pill) pill.textContent=String(mainCount(n.key));
    }
  },0);
}
function renderSpoiler(){
  return `<div class="hos-spoiler-panel ${state.spoilerOpen?"open":""}" id="hos-spoiler">
    <button class="hos-spoiler-toggle" id="hos-spoiler-toggle"><span>⚠ Spoiler / Komfortbereich / Expertenmodus</span><span>${state.spoilerOpen?"einklappen":"ausklappen"}</span></button>
    <div class="hos-spoiler-content">Komfortblöcke sind nur Bequemlichkeit. Vorher speichern. Lange Blöcke können Zeilen verschlucken. Fehlende Teile bitte per Einzelbutton testen. Einzelcheats sind Referenz.
      <div class="hos-spoiler-actions"><button data-jump="quick">Schnellzugriff</button><button data-jump="sets">Sets</button><button data-jump="all">Alles durchsuchen</button></div>
    </div>
  </div>`;
}
function visibleSubfiltersForCurrent(){
  const ordered=(SUBFILTERS[state.main]||["Alle"]).slice();
  if(!ordered.length) ordered.push("Alle");
  if(!ordered.includes(state.sub)) state.sub=ordered[0];
  return ordered;
}
function registerSearchHtml(){
  return `<label class="hos-register-search-control" for="hos-register-search">
    <span class="hos-register-search-icon" aria-hidden="true">⌕</span>
    <input id="hos-register-search" type="text" autocomplete="off" spellcheck="false" value="${esc(state.query)}" placeholder="Suche in HeinrichOS …">
    <button type="button" id="hos-register-search-clear" aria-label="Suche leeren" title="Suche leeren">×</button>
  </label>`;
}
function statusControlHtml(){
  const options=HOS_STATUS_OPTIONS.map(opt=>({value:opt.value,label:opt.label,meta:`${statusCount(opt.value)} Treffer`}));
  if(!options.some(opt=>opt.value===state.status)) state.status="all";
  return customSelectHtml("status","Status","◆",options,state.status,false);
}
function viewControlHtml(){ return ""; }
function renderRegisterHeading(total,shown){
  const nav=currentNav();
  return `<div class="hos-register-heading" aria-label="Aktive Registerauswahl">
    <div class="hos-register-heading-icon"><img src="${esc(nav.icon)}" alt=""></div>
    <div class="hos-register-heading-copy"><strong>Register der Rüstkammer</strong><small>${esc(nav.label)} <i>›</i> ${esc(state.sub)}</small></div>
    <div class="hos-register-heading-tags"><span>${esc(currentSortLabel())}</span></div>
    <div class="hos-register-result-count" title="Treffer im aktuellen Filter"><b>${Number(total)||0}</b><span>Treffer</span><small>${Number(shown)||0} sichtbar</small></div>
  </div>`;
}
function renderRegisterControls(total,shown,list){
  const visible=visibleSubfiltersForCurrent();
  const nav=currentNav();
  const subfilterIcon=(state.main==="weapons"&&state.sub==="Schilde")?"../02_ASSETS/icons/v11_categories/item_weapon_shield_v11_inward_matte_transparent.png":"⌕";
  const filterOptions=visible.map(label=>({value:label,label,meta:`${subCount(label)} Treffer`}));
  return `<div class="hos-register-commandbar" aria-label="Registersteuerung für ${esc(nav.label)}">
    <div class="hos-register-primary-row">
      ${registerSearchHtml()}
      ${customSelectHtml("subfilter","Untergruppe",subfilterIcon,filterOptions,state.sub,visible.length<=1)}
    </div>
    <div class="hos-register-secondary-row">
      ${sortControlHtml(list)}
    </div>
  </div>`;
}
function cardCopyCommand(rec){
  if(isSetContext(rec)) return setBlockForStrict(rec) || primaryCommand(rec);
  return primaryCommand(rec);
}
function fitCardTitles(root){
  if(!root)return;
  root.querySelectorAll(".item-card .card-header").forEach(el=>{
    el.style.removeProperty("font-size");
    el.style.removeProperty("line-height");
    delete el.dataset.hosTitleSize;
  });
}
function card(rec){
  const animalContext=state.main==="animals"&&isAnimalRelated(rec);
  const displayMain=animalContext?"animals":(rec.__main||state.main||"");
  const sub=animalContext?animalSub(rec):(state.main==="all"?rec.__allSub:rec.__sub);
  const name=displayRecordName(rec);
  return `<article class="item-card ${state.selectedId===rec.id?"is-selected":""}" data-main="${esc(displayMain)}" data-sub="${esc(sub||"")}" data-id="${esc(rec.id)}">
    <div class="hos-card-top">
      <div class="hos-card-icon"><img src="${resolvedRecordAsset(rec)}" alt=""></div>
      <div class="hos-card-titleblock">
        <div class="card-header" title="${esc(name)}">${esc(name)}</div>
        <div class="card-type">${esc(sub||currentNav().label||"")}</div>
      </div>
    </div>
    <div class="hos-card-actions">
      <button class="hos-detail-btn" data-action="details" data-id="${esc(rec.id)}">${displayMain==="resources"&&resourceKind(rec)==="OFFLINE"?"Kodex":"Details"}</button>
    </div>
  </article>`;
}

/* =====================================================================
   HEINRICHOS – GARDEROBE V1 / INTEGRATION PASS 02 – 30.08.2026
   Konsolidierter 23-Look-Fundus aus geprüft, Werte-Audit, Dossiers,
   Asset-Matrix und Phase-4-Presetdaten.
   - f116_data.js bleibt vollständig TABU
   - keine fremden Silver-Lys-Binärassets
   - Normalmodus zeigt keine rohen Cheat-/UUID-/Aliaszeilen
   - Werte sind HeinrichOS-Testwerte gegen 12 / 81 / 0 / 59
   - eigene Looks bleiben localStorage
   ===================================================================== */
function hosWardrobeJsonLoad(key,fallback){
  try{ const raw=localStorage.getItem(key); return raw==null?fallback:JSON.parse(raw); }catch(e){ return fallback; }
}
function hosWardrobeJsonSave(key,value){
  try{ localStorage.setItem(key,JSON.stringify(value)); return true; }catch(e){ return false; }
}
function hosWardrobeFavoriteIds(){
  const v=hosWardrobeJsonLoad(HOS_WARDROBE_STORAGE.favorites,[]);
  return Array.isArray(v)?v.map(safe):[];
}
function hosWardrobeCustomLooks(){
  const v=hosWardrobeJsonLoad(HOS_WARDROBE_STORAGE.custom,[]);
  return Array.isArray(v)?v:[];
}
function hosWardrobeSaveCustomLooks(v){ return hosWardrobeJsonSave(HOS_WARDROBE_STORAGE.custom,v); }
function hosWardrobePreset(id){ return HOS_WARDROBE_PRESETS.find(p=>safe(p&&p.id)===safe(id)); }
function hosWardrobeIsFavorite(id){ return hosWardrobeFavoriteIds().includes(safe(id)); }
function hosWardrobeToggleFavorite(id){
  id=safe(id); let fav=hosWardrobeFavoriteIds();
  fav=fav.includes(id)?fav.filter(x=>x!==id):fav.concat(id);
  hosWardrobeJsonSave(HOS_WARDROBE_STORAGE.favorites,fav);
  renderNav();
}
function hosWardrobeCategoryMatch(p,label){
  const cats=(p.categories||[]).map(norm), origin=norm(p.origin);
  if(!label||label==="Alle") return true;
  if(label==="Ritter / Kampf") return cats.some(x=>x==="ritter"||x==="kampf"||x==="heraldik"||x==="ruestung");
  if(label==="Stadt / Hof") return cats.some(x=>x==="stadt"||x==="hof"||x==="charisma"||x==="story"||x==="charakter"||x==="verkleidung");
  if(label==="Jagd / Reise") return cats.some(x=>x==="jagd"||x==="reise"||x==="wald"||x==="wanderer");
  if(label==="Stealth") return cats.some(x=>x==="stealth"||x==="diebstahl");
  if(label==="Spezial") return cats.some(x=>x==="spezial"||x==="pest"||x==="arbeit"||x==="schmiede"||x==="funktion");
  if(label==="Original") return origin==="ramon_original";
  if(label==="Silver Lys") return origin==="silver_lys";
  if(label==="Pebbles") return cats.includes("pebbles");
  return true;
}
function hosWardrobeQueryMatch(p){
  const q=norm(state.query).trim(); if(!q)return true;
  const partBlob=(p.parts||[]).map(x=>[x.name,x.alias,x.uuid,x.source,x.slot].join(" ")).join(" ");
  const lookBlob=(p.looks||[]).map(x=>[x.label,x.role].join(" ")).join(" ");
  return norm([p.name,p.origin,(p.categories||[]).join(" "),p.rating,p.testStatus,(p.dependencies||[]).join(" "),partBlob,lookBlob].join(" ")).includes(q);
}
function hosWardrobeSlotLabel(slot){
  const map={
    head_under:"Kopf · Unterhaube",head_mail:"Kopf · Kettenhaube",head_hood:"Kopf/Hals · Gugel",
    head_cap:"Kopf · Kappe/Hut",head_special:"Kopf · Spezial",face:"Gesicht",helmet:"Helm",neck:"Hals/Kragen",
    torso_under:"Oberkörper · Unterkleidung",torso_work:"Oberkörper · Arbeit",torso_padding:"Oberkörper · Polsterung",
    torso_mail:"Oberkörper · Kette",torso_plate:"Oberkörper · Platte",torso_outer:"Oberkörper · Außenschicht",
    arms:"Arme",hands:"Hände",legs:"Beine",legs_padding:"Beine · Polsterung",legs_outer:"Beine · Außen",
    legs_plate:"Beine · Platte",feet:"Füße",spurs:"Sporen",weapon:"Waffe",shield:"Schild",
    horse_saddle:"Pebbles · Sattel",horse_bridle:"Pebbles · Zaumzeug",horse_harness:"Pebbles · Geschirr",
    horse_caparison:"Pebbles · Schabracke",horse_chanfron:"Pebbles · Rossstirn"
  };
  return map[slot]||slot||"Sonstiges";
}
function hosWardrobeGroupLabel(group){
  return ({hood:"Gugel",pest_head:"Pest-Variante",torso:"Oberkörper-Variante"})[group]||group||"Variante";
}
function hosWardrobeDefaultVariant(parts,preset,group){
  const preferred=preset&&preset.defaultVariants&&preset.defaultVariants[group];
  return parts.find(p=>p.variant===preferred) || parts.find(p=>p.variant==="main") || parts.find(p=>p.variant==="up") || parts.find(p=>p.variant==="normal") || parts[0] || null;
}
function hosWardrobeVariantValue(preset,group,parts){
  const runtime=HOS_WARDROBE_RUNTIME.variantByPreset[preset.id+"|"+group];
  if(runtime)return runtime;
  const chosen=hosWardrobeDefaultVariant(parts||[],preset,group);
  return chosen&&chosen.variant||"";
}
function hosWardrobeEffectiveParts(preset){
  if(!preset)return[];
  const byGroup=new Map(), out=[];
  for(const p of (preset.parts||[])){
    if(p.variantGroup){
      if(!byGroup.has(p.variantGroup))byGroup.set(p.variantGroup,[]);
      byGroup.get(p.variantGroup).push(p);
    }else if(p.required){ out.push(p); }
  }
  for(const [group,parts] of byGroup){
    const wanted=hosWardrobeVariantValue(preset,group,parts);
    const chosen=parts.find(x=>x.variant===wanted)||hosWardrobeDefaultVariant(parts,preset,group);
    if(chosen)out.push(chosen);
  }
  return out;
}
function hosWardrobeCurrentLookState(preset){
  const looks=Array.isArray(preset&&preset.looks)?preset.looks:[];
  if(!looks.length)return{look:null,exact:false};
  const exact=looks.find(look=>Object.entries(look.variantByGroup||{}).every(([group,value])=>{
    const parts=(preset.parts||[]).filter(x=>x.variantGroup===group);
    return hosWardrobeVariantValue(preset,group,parts)===value;
  }));
  return {look:exact||looks[0],exact:!!exact};
}
function hosWardrobeInternalVariantInfo(preset){
  const meta=preset&&preset.internalVariantMetrics||{};
  for(const group of Object.keys(meta)){
    const parts=(preset.parts||[]).filter(x=>x.variantGroup===group);
    const value=hosWardrobeVariantValue(preset,group,parts);
    if(meta[group]&&meta[group][value])return meta[group][value];
  }
  return null;
}
function hosWardrobeMetricState(preset){
  const st=hosWardrobeCurrentLookState(preset);
  if(st.exact&&st.look)return{metrics:st.look.metrics||null,delta:st.look.delta||null,control:st.look.assets&&st.look.assets.control||"",note:"",exact:true};
  const internal=hosWardrobeInternalVariantInfo(preset);
  if(internal)return{metrics:internal.metrics||null,delta:internal.delta||null,control:internal.control||"",note:internal.note||"",exact:true};
  return{metrics:null,delta:null,control:"",note:"Für die aktuell gewählte interne Variante liegt keine eigene Vierer-Messung und kein eigener Wertebeleg vor.",exact:false};
}
function hosWardrobeCopyEligible(part){
  if(!part||part.copyEligible===false)return false;
  if(part.identityStatus==="OPEN")return false;
  return !!(part.uuid||part.alias);
}
function hosWardrobeCommand(part){
  if(!hosWardrobeCopyEligible(part))return"";
  const ident=part.uuid||part.alias;
  return ident?`wh_cheat_addItem ${ident}`:"";
}
function hosWardrobeChunkCommands(parts){
  const commands=(parts||[]).map(hosWardrobeCommand).filter(Boolean);
  const n=Math.max(1,Number(HOS_WARDROBE_DATA.rules&&HOS_WARDROBE_DATA.rules.maxCommandsPerCopyBlock)||4);
  const chunks=[]; for(let i=0;i<commands.length;i+=n)chunks.push(commands.slice(i,i+n));
  return chunks;
}
function hosWardrobeIdentityOpen(parts){
  return (parts||[]).some(p=>p.identityStatus==="OPEN" || (!p.alias&&!p.uuid));
}
function hosWardrobeOriginLabel(v){
  const m={
    RAMON_ORIGINAL:"Original",HOS_CUSTOM:"HeinrichOS Custom",VANILLA:"Vanilla KCD2",
    SILVER_LYS:"Silver Lys",HYBRID_VANILLA_QUEST_ACCESSORIES:"Vanilla / Quest",
    VANILLA_STORY_CHARACTER:"Vanilla · Story/Charakter",VANILLA_CURATED_HOS_OUTFIT:"Vanilla · HeinrichOS-Zusammenstellung",
    VANILLA_QUEST_CURATED_HOS_OUTFIT:"Vanilla/Quest · HeinrichOS-Zusammenstellung",VANILLA_NAMED_FAMILY:"Vanilla · Namensfamilie"
  };
  return m[v]||v||"Unbekannt";
}
function hosWardrobeSyncNav(){
  $all(".nav-item").forEach(el=>{
    const active=(el.getAttribute("data-main")||"")===state.main;
    el.classList.toggle("active",active);
    if(active)el.setAttribute("aria-current","page");else el.removeAttribute("aria-current");
  });
}
function hosWardrobeFallbackIcon(){ return (MAIN_NAV.find(n=>n.key==="wardrobe")||MAIN_NAV.find(n=>n.key==="sets")||MAIN_NAV[0]).icon; }
function hosWardrobeCardImage(p){ const st=hosWardrobeCurrentLookState(p),a=st.look&&st.look.assets; return a&&a.card?a.card:hosWardrobeFallbackIcon(); }
function hosWardrobeBoardImage(p){ const st=hosWardrobeCurrentLookState(p),a=st.look&&st.look.assets; return a&&a.detail?a.detail:hosWardrobeFallbackIcon(); }
function hosWardrobeControlImage(p){ const ms=hosWardrobeMetricState(p); return ms.control||""; }
function hosWardrobePreviewNote(p){
  const st=hosWardrobeCurrentLookState(p);
  if(st.exact)return "Finales bzw. akzeptiertes geprüft-Foto des aktuell gewählten Looks.";
  return "Die gewählte interne Variante besitzt kein eigenes Frontalfoto; gezeigt wird das bestätigte MAIN-Foto des Presets.";
}
function hosWardrobeStatusKey(p){
  if(hosWardrobeIdentityOpen(p.parts||[])) return "open";
  if((p.dependencies||[]).length) return "external";
  return "ready";
}
function hosWardrobeDependencyText(p){
  const deps=(p.dependencies||[]).filter(Boolean);
  if(!deps.length)return "";
  return `Erforderlich: ${deps.join(", ")}. Nicht in HeinrichOS enthalten. Bitte von der Originalquelle installieren.`;
}
function hosWardrobeDependencyUrl(p){
  const deps=(p.dependencies||[]).join(" ");
  if(/silver\s*lys/i.test(deps))return "https://www.nexusmods.com/kingdomcomedeliverance2/mods/1303";
  return "";
}
function hosWardrobeDependencyHtml(p){
  const text=hosWardrobeDependencyText(p);
  if(!text)return "<p>Keine externe Abhängigkeit.</p>";
  const url=hosWardrobeDependencyUrl(p);
  return `<p><b>⚠ Externe Abhängigkeit</b><br>${esc(text)}</p>${url?`<p><a class="hos-action-btn" href="${esc(url)}" target="_blank" rel="noopener noreferrer">Originalseite öffnen</a></p>`:""}`;
}
function hosWardrobeStatusOptions(){
  const base=HOS_WARDROBE_PRESETS.filter(hosWardrobeQueryMatch).filter(p=>!state.sub||state.sub==="Alle"||state.sub==="Freie Garderobe"||hosWardrobeCategoryMatch(p,state.sub));
  const count=(k)=>k==="all"?base.length:base.filter(p=>hosWardrobeStatusKey(p)===k).length;
  return [
    {value:"all",label:"Alle Stände",meta:`${count("all")} Presets`},
    {value:"ready",label:"Direkt nutzbar",meta:`${count("ready")} Presets`},
    {value:"external",label:"Mit Abhängigkeit",meta:`${count("external")} Presets`},
    {value:"open",label:"Technik offen",meta:`${count("open")} Presets`}
  ];
}
function hosWardrobeSortOptions(){
  return [
    {value:"standard",label:"Fotosession-Reihenfolge",meta:"geprüft"},
    {value:"name",label:"Name A–Z",meta:"alphabetisch"},
    {value:"parts",label:"Meiste Teile",meta:"aktiver Aufbau"}
  ];
}
function hosWardrobeSortList(list){
  const out=list.slice();
  if(state.sort==="name") out.sort((a,b)=>safe(a.name).localeCompare(safe(b.name),"de"));
  else if(state.sort==="parts") out.sort((a,b)=>hosWardrobeEffectiveParts(b).length-hosWardrobeEffectiveParts(a).length || safe(a.name).localeCompare(safe(b.name),"de"));
  else out.sort((a,b)=>(Number(a.sortIndex)||999)-(Number(b.sortIndex)||999));
  return out;
}
function hosWardrobePresetList(){
  let list=HOS_WARDROBE_PRESETS.filter(hosWardrobeQueryMatch);
  if(state.sub && state.sub!=="Alle" && state.sub!=="Freie Garderobe") list=list.filter(p=>hosWardrobeCategoryMatch(p,state.sub));
  if(state.status && state.status!=="all") list=list.filter(p=>hosWardrobeStatusKey(p)===state.status);
  return hosWardrobeSortList(list);
}
function hosWardrobeRegisterHeading(total,shown,label){
  const nav=MAIN_NAV.find(n=>n.key===state.main)||MAIN_NAV.find(n=>n.key==="wardrobe")||MAIN_NAV[0];
  const normalWardrobe=state.main==="wardrobe"&&state.sub!=="Freie Garderobe";
  const freeBuilder=state.main==="wardrobe"&&state.sub==="Freie Garderobe";
  const headingLabel=normalWardrobe?"Garderobe":(label||"Garderobe");
  const totalLooks=normalWardrobe?Number(HOS_WARDROBE_DATA.lookCount||23):Number(total)||0;
  const search=normalWardrobe?`<div class="hos-wardrobe-heading-search">${registerSearchHtml()}</div>`:"";
  const headingAction=state.main==="looks"
    ? `<button type="button" class="hos-action-btn hos-wardrobe-heading-action" data-w-open-builder>＋ Freie Garderobe</button>`
    : (freeBuilder?`<button type="button" class="hos-action-btn hos-wardrobe-heading-action" data-w-back-looks>★ Meine Looks</button>`:"");
  const resultSmall=normalWardrobe?(state.query?`${Number(total)||0} Treffer`:"23 Looks · 21 Outfit-Gruppen"):(state.main==="looks"?`${Number(shown)||0} gespeichert/favorisiert`:"Werkbank");
  return `<div class="hos-register-heading hos-wardrobe-register-heading" data-hos-wardrobe-register="fix1c" aria-label="Aktive Garderobenauswahl">
    <div class="hos-register-heading-icon"><img src="${esc(nav.icon)}" alt=""></div>
    <div class="hos-register-heading-copy"><strong>${esc(headingLabel)}</strong><small>${normalWardrobe?"23 geprüfte Looks in 21 Outfit-Gruppen":(freeBuilder?"Eigene Kombination bauen":"Favoriten und Eigenkreationen")}</small></div>
    ${search||headingAction}
    <div class="hos-register-result-count" title="Garderoben-Looks"><b>${totalLooks}</b><span>${normalWardrobe?"Looks":(freeBuilder?"Werkbank":"Einträge")}</span><small>${esc(resultSmall)}</small></div>
  </div>`;
}
function hosWardrobeRegisterControls(){
  // FIX1C: Bei 23 festen geprüft-Looks keine zweite Filter-/Sortierzeile mehr.
  // Die Garderobe bleibt bewusst: Titel + Suche + Karten.
  state.status="all";
  state.sort="standard";
  return "";
}
function hosWardrobeBindRegisterControls(){
  // Gleiche stabile Registersuche wie im restlichen HeinrichOS verwenden.
  bindRegisterSearch();
  state.status="all";
  state.sort="standard";
  const openBuilder=document.querySelector("[data-w-open-builder]");
  if(openBuilder)openBuilder.addEventListener("click",()=>{
    clearTimeout(window.__hosRegisterSearchTimer);
    state.main="wardrobe";state.sub="Freie Garderobe";state.query="";state.status="all";state.sort="standard";state.selectedId=null;
    const hidden=$("#hos-search")||$(".search-input");if(hidden)hidden.value="";
    hosWardrobeRender();
  });
  const backLooks=document.querySelector("[data-w-back-looks]");
  if(backLooks)backLooks.addEventListener("click",()=>{
    clearTimeout(window.__hosRegisterSearchTimer);
    state.main="looks";state.sub="Alle";state.query="";state.status="all";state.sort="standard";state.selectedId=null;
    const hidden=$("#hos-search")||$(".search-input");if(hidden)hidden.value="";
    hosWardrobeRender();
  });
}
function hosWardrobeMetricChips(p){
  const ms=hosWardrobeMetricState(p),m=ms.metrics;if(!m)return `<div class="hos-wardrobe-card-stats"><span>Humanwerte N/A</span></div>`;
  return `<div class="hos-wardrobe-card-stats"><span>C ${m.charisma}</span><span>A ${m.conspicuousness}</span><span>G ${m.noise}</span><span>S ${m.visibility}</span></div>`;
}
function hosWardrobePresetCard(p){
  const parts=hosWardrobeEffectiveParts(p), fav=hosWardrobeIsFavorite(p.id), open=hosWardrobeIdentityOpen(p.parts||[]), lookCount=(p.looks||[]).length;
  const type=[hosWardrobeOriginLabel(p.origin),`${parts.length} Teile`,lookCount>1?`${lookCount} Foto-Looks`:"",open?"Technik offen":""].filter(Boolean).join(" · ");
  const dependencyBadge=(p.dependencies||[]).length?`<div class="hos-wardrobe-card-stats"><span>⚠ ${esc(p.dependencies.join(", "))} erforderlich · nicht enthalten</span></div>`:"";
  return `<article class="item-card hos-wardrobe-card ${state.selectedId===p.id?"is-selected":""}" data-wardrobe-preset="${esc(p.id)}" data-id="${esc(p.id)}">
    <div class="hos-card-top">
      <div class="hos-card-icon hos-wardrobe-photo"><img src="${esc(hosWardrobeCardImage(p))}" alt=""></div>
      <div class="hos-card-titleblock">
        <div class="card-header" title="${esc(p.name)}">${fav?"★ ":""}${esc(p.name)}</div>
        <div class="card-type">${esc(type)}</div>
        ${hosWardrobeMetricChips(p)}
        ${dependencyBadge}
      </div>
    </div>
    <div class="hos-card-actions">
      <button class="hos-detail-btn" data-wardrobe-detail="${esc(p.id)}">Details</button>
      <button class="hos-detail-btn" data-wardrobe-fav="${esc(p.id)}" title="${fav?"Favorit entfernen":"Als Favorit merken"}">${fav?"★":"☆"}</button>
    </div>
  </article>`;
}
function hosWardrobeCustomCard(x){
  const parts=Array.isArray(x.parts)?x.parts:[];
  return `<article class="item-card hos-wardrobe-card ${state.selectedId===x.id?"is-selected":""}" data-w-custom-card="${esc(x.id)}" data-id="${esc(x.id)}">
    <div class="hos-card-top">
      <div class="hos-card-icon hos-wardrobe-photo hos-wardrobe-own-photo"><img src="${esc(hosWardrobeFallbackIcon())}" alt=""></div>
      <div class="hos-card-titleblock"><div class="card-header" title="${esc(x.name||"Eigener Look")}">${esc(x.name||"Eigener Look")}</div><div class="card-type">Eigenkreation · ${parts.length} Teile</div><div class="hos-wardrobe-card-stats"><span>keine erfundenen Gesamtwerte</span></div></div>
    </div>
    <div class="hos-card-actions"><button class="hos-detail-btn" data-w-custom-detail="${esc(x.id)}">Details</button></div>
  </article>`;
}
function hosWardrobePartPool(){
  const byAlias=new Map();
  for(const p of HOS_WARDROBE_PRESETS){
    for(const x of (p.parts||[])){
      if(!x.alias)continue;
      if(!byAlias.has(x.alias))byAlias.set(x.alias,Object.assign({},x,{fromPresets:[p.id]}));
      else byAlias.get(x.alias).fromPresets.push(p.id);
    }
  }
  return Array.from(byAlias.values());
}
function hosWardrobeDraft(){ const x=hosWardrobeJsonLoad(HOS_WARDROBE_STORAGE.draft,{}); return x&&typeof x==="object"&&!Array.isArray(x)?x:{}; }
function hosWardrobeSaveDraft(x){ hosWardrobeJsonSave(HOS_WARDROBE_STORAGE.draft,x); }
function hosWardrobeDraftParts(){
  const draft=hosWardrobeDraft(), pool=hosWardrobePartPool();
  return Object.values(draft).map(alias=>pool.find(p=>p.alias===alias)).filter(Boolean);
}
function hosWardrobeConflictMessages(parts){
  const selectedSlots=new Set((parts||[]).map(p=>p.slot));
  const out=[];
  for(const p of (parts||[])){
    for(const c of (p.conflicts||[])){
      if(c==="footwear"&&selectedSlots.has("feet")) out.push(`${p.name} und Schuhe/Stiefel belegen einen bekannten kollidierenden Bereich.`);
      else if(selectedSlots.has(c)) out.push(`${p.name} kollidiert mit ${hosWardrobeSlotLabel(c)}.`);
    }
    if(p.identityStatus==="OPEN")out.push(`${p.name}: technische Identität noch OFFEN – wird nicht in Copy-Blöcke aufgenommen.`);
  }
  return Array.from(new Set(out));
}
function hosWardrobeCopyBlocksHtml(chunks){
  if(!(chunks||[]).length) return `<div class="hos-detail-board-empty">Keine bestätigten Copy-Befehle für diesen Aufbau.</div>`;
  return `<div class="hos-wardrobe-copy-list">${chunks.map((chunk,i)=>`<button type="button" class="hos-action-btn hos-wardrobe-copy-btn" data-w-copy="${esc(chunk.join("\n"))}"><b>Block ${i+1}</b><span>${chunk.length} Befehl${chunk.length===1?"":"e"} kopieren</span></button>`).join("")}</div>`;
}
function hosWardrobePartsTable(parts){
  if(!(parts||[]).length) return `<div class="hos-detail-board-empty">Keine Teile in diesem Abschnitt.</div>`;
  return `<table class="hos-detail-board-table hos-wardrobe-parts-table">${parts.map(p=>`<tr><td>${esc(hosWardrobeSlotLabel(p.slot))}</td><td><b>${esc(p.name)}</b>${p.provenance?`<br><small>${p.provenance==="HOS_SUPPLEMENT"?"HeinrichOS-Ergänzung":"Original-/Quellteil"}</small>`:""}</td></tr>`).join("")}</table>`;
}
function hosWardrobeBoardVariantHtml(p){
  const groups=new Map();
  for(const x of (p.parts||[])) if(x.variantGroup){ if(!groups.has(x.variantGroup))groups.set(x.variantGroup,[]); groups.get(x.variantGroup).push(x); }
  if(!groups.size)return"";
  return `<div class="hos-detail-board-card hos-wardrobe-variant-card"><h3>Variante wählen</h3>${Array.from(groups).map(([group,parts],idx)=>{
    const selected=hosWardrobeVariantValue(p,group,parts);
    const opts=parts.map(x=>({value:x.variant||"",label:x.name,meta:x.variant===((p.defaultVariants||{})[group])?"MAIN":"Variante"}));
    return customSelectHtml(`wardrobe-variant-${idx}`,hosWardrobeGroupLabel(group),"◆",opts,selected,false);
  }).join("")}</div>`;
}
function hosWardrobeSigned(v){ const n=Number(v); return n>0?`+${n}`:String(n); }
function hosWardrobeMetricsTable(p){
  const ms=hosWardrobeMetricState(p),m=ms.metrics,d=ms.delta;
  if(!m)return `<div class="hos-wardrobe-metrics-na"><b>Humanwerte: N/A bzw. nicht separat gemessen</b><span>${esc(ms.note||"Pferdelooks verwenden keine menschlichen C/A/G/S-Werte.")}</span></div>`;
  return `<table class="hos-detail-board-table hos-wardrobe-metrics-table"><thead><tr><th>Wert</th><th>INGAME ANGEZEIGT</th><th>Δ zum Testleerstand</th></tr></thead><tbody>
    <tr><td>Charisma</td><td><b>${m.charisma}</b></td><td>${hosWardrobeSigned(d.charisma)}</td></tr>
    <tr><td>Auffälligkeit</td><td><b>${m.conspicuousness}</b></td><td>${hosWardrobeSigned(d.conspicuousness)}</td></tr>
    <tr><td>Geräusche</td><td><b>${m.noise}</b></td><td>${hosWardrobeSigned(d.noise)}</td></tr>
    <tr><td>Sichtbarkeit</td><td><b>${m.visibility}</b></td><td>${hosWardrobeSigned(d.visibility)}</td></tr>
  </tbody></table><p class="hos-wardrobe-baseline-note">Vergleichsbasis: <b>12 / 81 / 0 / 59</b>. Das sind HeinrichOS-Vergleichswerte des festen Testsetups, keine universellen Spielerwerte.</p>${ms.note?`<p><small>${esc(ms.note)}</small></p>`:""}`;
}
function hosWardrobeBoardBody(p,tab){
  const parts=hosWardrobeEffectiveParts(p), open=hosWardrobeIdentityOpen(p.parts||[]), chunks=hosWardrobeChunkCommands(parts), optional=(p.parts||[]).filter(x=>!x.required&&!x.variantGroup), control=hosWardrobeControlImage(p);
  if(tab==="values"){
    return `<section class="hos-wardrobe-values-layout"><div class="hos-detail-board-card"><h3>Outfit-Werte</h3>${hosWardrobeMetricsTable(p)}</div><div class="hos-detail-board-card hos-wardrobe-control-card"><h3>Inventar-/Wertebeleg</h3>${control?`<img class="hos-wardrobe-control-image" src="${esc(control)}" alt="Inventar- und Wertebeleg ${esc(p.name)}">`:`<div class="hos-detail-board-empty">Kein separates Kontrollbild für diese interne Variante.</div>`}</div></section>`;
  }
  if(tab==="parts"){
    return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Aktiver Aufbau · ${parts.length} Teile</h3>${hosWardrobePartsTable(parts)}</div><div class="hos-detail-board-card"><h3>Optional / Zubehör</h3>${hosWardrobePartsTable(optional)}</div>${hosWardrobeBoardVariantHtml(p)}</section>`;
  }
  if(tab==="commands"){
    return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Copy-Blöcke · maximal 4 Befehle</h3>${open?`<p>Offene technische Identitäten werden bewusst ausgelassen.</p>`:""}${hosWardrobeCopyBlocksHtml(chunks)}<p><small>Normalmodus: Die Rohbefehle bleiben verborgen und werden direkt in die Zwischenablage kopiert.</small></p></div><div class="hos-detail-board-card"><h3>Schutzregel</h3><p>Keine geratenen IDs. Silver-Lys-Exact-Looks bleiben externe Abhängigkeit. Der globale Expertenmodus kann technische Details später sichtbar machen.</p></div></section>`;
  }
  if(tab==="notes"){
    const warnings=hosWardrobeConflictMessages(parts);
    return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Hinweise / Konflikte</h3>${warnings.length?`<p>${warnings.map(esc).join("<br>")}</p>`:`<p>Keine bekannte Konfliktwarnung im aktiven Aufbau.</p>`}</div><div class="hos-detail-board-card"><h3>Preset-Notizen</h3><p>${(p.notes||[]).length?p.notes.map(esc).join("<br>"):"Keine zusätzliche Notiz hinterlegt."}</p></div><div class="hos-detail-board-card"><h3>Abhängigkeiten</h3>${hosWardrobeDependencyHtml(p)}</div></section>`;
  }
  return `<section class="hos-detail-board-overview hos-wardrobe-overview">
    <div class="hos-detail-board-art hos-wardrobe-main-art"><img src="${esc(hosWardrobeBoardImage(p))}" alt="${esc(p.name)}"></div>
    <div class="hos-detail-board-card hos-detail-board-main">
      <h3>${esc(p.name)}</h3>
      <div class="hos-detail-board-type">Garderobe · ${esc(hosWardrobeOriginLabel(p.origin))}</div>
      <div class="hos-detail-board-mini-grid">
        <div><h4>Status</h4><table class="hos-detail-board-table"><tr><td>Bewertung</td><td>${esc(p.rating||"–")}</td></tr><tr><td>Test</td><td>${esc(p.testStatus||"–")}</td></tr><tr><td>Aktiver Aufbau</td><td>${parts.length} Teile</td></tr><tr><td>Foto-Looks</td><td>${(p.looks||[]).length}</td></tr><tr><td>Technik</td><td>${open?"teilweise offen":"geschlossen"}</td></tr></table></div>
        <div><h4>Aktionen</h4><p><button type="button" class="hos-action-btn" data-wardrobe-fav="${esc(p.id)}">${hosWardrobeIsFavorite(p.id)?"★ Favorit entfernen":"☆ Als Favorit merken"}</button></p><p><button type="button" class="hos-action-btn" data-wardrobe-clone="${esc(p.id)}">Als eigenen Look übernehmen</button></p></div>
      </div>
      <div class="hos-wardrobe-overview-metrics">${hosWardrobeMetricsTable(p)}</div>
    </div>
    ${hosWardrobeBoardVariantHtml(p)}
    <div class="hos-detail-board-card"><h3>Bildstatus</h3><p>${esc(hosWardrobePreviewNote(p))}</p></div>
    <div class="hos-detail-board-card"><h3>Abhängigkeit / Quelle</h3>${hosWardrobeDependencyHtml(p)}</div>
  </section>`;
}
function hosWardrobeBindCopies(root=document){
  root.querySelectorAll("[data-w-copy]").forEach(btn=>btn.addEventListener("click",ev=>{
    ev.preventDefault();ev.stopPropagation();const txt=btn.getAttribute("data-w-copy")||"";
    copyText(txt).then(ok=>{const old=btn.innerHTML;btn.innerHTML=ok?"<b>✓ Kopiert</b><span>in die Zwischenablage</span>":"<b>Fehler</b><span>nicht kopiert</span>";setTimeout(()=>btn.innerHTML=old,1100);});
  }));
}
function hosWardrobeBindBoard(p){
  const overlay=$("#hos-detail-board-overlay"); if(!overlay)return;
  overlay.querySelectorAll("[data-board-close]").forEach(btn=>btn.addEventListener("click",()=>overlay.remove()));
  overlay.addEventListener("click",ev=>{if(ev.target===overlay)overlay.remove();});
  const rerender=(tab)=>{
    const body=overlay.querySelector("#hos-detail-board-body");if(body)body.innerHTML=hosWardrobeBoardBody(p,tab);
    overlay.querySelectorAll(".hos-detail-board-tab").forEach(b=>b.classList.toggle("active",b.getAttribute("data-tab")===tab));
    hosWardrobeBindBoardBody(p,tab);
  };
  overlay.querySelectorAll(".hos-detail-board-tab").forEach(btn=>btn.addEventListener("click",()=>rerender(btn.getAttribute("data-tab")||"overview")));
  hosWardrobeBindBoardBody(p,"overview");
}
function hosWardrobeBindBoardBody(p,tab){
  const overlay=$("#hos-detail-board-overlay"); if(!overlay)return;
  hosWardrobeBindCopies(overlay);
  overlay.querySelectorAll("[data-wardrobe-fav]").forEach(btn=>btn.addEventListener("click",()=>{
    hosWardrobeToggleFavorite(p.id); hosWardrobeShowPresetPreview(p.id); hosWardrobeOpenDetailBoard(p.id,tab);
  }));
  overlay.querySelectorAll("[data-wardrobe-clone]").forEach(btn=>btn.addEventListener("click",()=>{hosWardrobeClonePreset(p.id);btn.textContent="✓ Unter Meine Looks gespeichert";}));
  const groups=new Map(); for(const x of (p.parts||[]))if(x.variantGroup){if(!groups.has(x.variantGroup))groups.set(x.variantGroup,[]);groups.get(x.variantGroup).push(x);}
  Array.from(groups).forEach(([group],idx)=>bindCustomDropdown(`wardrobe-variant-${idx}`,value=>{
    HOS_WARDROBE_RUNTIME.variantByPreset[p.id+"|"+group]=value;
    hosWardrobeShowPresetPreview(p.id);
    hosWardrobeRenderCardsOnly();
    const body=overlay.querySelector("#hos-detail-board-body");if(body)body.innerHTML=hosWardrobeBoardBody(p,tab);
    hosWardrobeBindBoardBody(p,tab);
  }));
}
function hosWardrobeOpenDetailBoard(id,initialTab="overview"){
  const p=hosWardrobePreset(id); if(!p)return;
  state.selectedId=id; hosWardrobeMarkSelected(); hosWardrobeShowPresetPreview(id);
  const old=$("#hos-detail-board-overlay");if(old)old.remove();
  const overlay=document.createElement("div");overlay.id="hos-detail-board-overlay";overlay.className="hos-detail-board-overlay";
  const tabs=[["overview","Übersicht"],["values","Werte & Beleg"],["parts","Aufbau"],["commands","Kopieren"],["notes","Notizen"]];
  overlay.innerHTML=`<article class="hos-detail-board" data-main="wardrobe" data-sub="${esc(state.sub||"Alle")}" role="dialog" aria-modal="true" aria-label="Grosse Garderoben-Detailansicht">
    <header class="hos-detail-board-head"><div class="hos-detail-board-titleline"><div class="hos-detail-board-small-icon hos-wardrobe-board-head-photo"><img src="${esc(hosWardrobeCardImage(p))}" alt=""></div><div><h2>${esc(p.name)}</h2><div>Garderobe · ${esc(hosWardrobeOriginLabel(p.origin))}</div></div></div><div class="hos-detail-board-head-actions"><button class="hos-detail-board-back" data-board-close>Zurück zur Liste</button><button class="hos-detail-board-x" data-board-close aria-label="Schließen">×</button></div></header>
    <nav class="hos-detail-board-tabs">${tabs.map(([key,label])=>`<button class="hos-detail-board-tab ${key===initialTab?"active":""}" data-tab="${key}">${label}</button>`).join("")}</nav>
    <div class="hos-detail-board-body" id="hos-detail-board-body">${hosWardrobeBoardBody(p,initialTab)}</div>
  </article>`;
  document.body.appendChild(overlay); hosWardrobeBindBoard(p);
  if(initialTab!=="overview"){
    const btn=overlay.querySelector(`.hos-detail-board-tab[data-tab="${CSS.escape(initialTab)}"]`);if(btn)btn.click();
  }
}
function hosWardrobeMarkSelected(){
  $all("#hos-item-grid .item-card").forEach(el=>el.classList.toggle("is-selected",safe(el.getAttribute("data-id"))===safe(state.selectedId)));
}
function hosWardrobeShowPresetPreview(id){
  const p=hosWardrobePreset(id), detail=$("#details-content");if(!p||!detail)return;
  state.selectedId=p.id;hosWardrobeMarkSelected();
  const parts=hosWardrobeEffectiveParts(p), open=hosWardrobeIdentityOpen(p.parts||[]), ms=hosWardrobeMetricState(p),m=ms.metrics;
  const rows=[
    ["Quelle",hosWardrobeOriginLabel(p.origin)],["Aktiver Aufbau",`${parts.length} Teile`],["Bewertung",p.rating||"–"],["Test",p.testStatus||"–"],["Technik",open?"teilweise offen":"geschlossen"],["Abhängigkeit",(p.dependencies||[]).join(", ")||"keine"]
  ];
  detail.innerHTML=`<article class="hos-kodex-entry hos-detail-stage hos-wardrobe-kodex" data-id="${esc(p.id)}" data-main="wardrobe" data-sub="${esc(state.sub||"Alle")}">
    <div class="hos-kodex-head"><div class="hos-kodex-icon"><img src="${esc(hosWardrobeCardImage(p))}" alt=""></div><div><h2 class="hos-kodex-title">${esc(p.name)}</h2><div class="hos-kodex-type">Garderobe · ${esc(hosWardrobeOriginLabel(p.origin))}</div></div></div>
    <div class="hos-wardrobe-kodex-photo"><img src="${esc(hosWardrobeBoardImage(p))}" alt="${esc(p.name)}"></div>
    <div class="hos-kodex-section"><h4>INGAME ANGEZEIGT</h4>${m?`<div class="hos-wardrobe-kodex-metrics"><span><b>${m.charisma}</b> Charisma</span><span><b>${m.conspicuousness}</b> Auffälligkeit</span><span><b>${m.noise}</b> Geräusche</span><span><b>${m.visibility}</b> Sichtbarkeit</span></div>`:`<div>Pferdelook / interne Variante ohne eigene Human-Vierermessung.</div>`}</div>
    <div class="hos-kodex-section"><h4>Schnellübersicht</h4><table class="stats-table">${rows.map(([k,v])=>`<tr><td>${esc(k)}</td><td class="val">${esc(v)}</td></tr>`).join("")}</table></div>
    ${(p.notes||[]).length?`<div class="hos-kodex-section"><h4>Hinweis</h4><div>${esc(p.notes[0])}</div></div>`:""}
    <div class="hos-kodex-section"><h4>Details</h4><p><button type="button" class="hos-action-btn" data-wardrobe-open-board="${esc(p.id)}">Große Details öffnen</button></p><p><button type="button" class="hos-action-btn" data-wardrobe-fav="${esc(p.id)}">${hosWardrobeIsFavorite(p.id)?"★ Favorit entfernen":"☆ Als Favorit merken"}</button></p></div>
  </article>`;
  hosWardrobeBindPreview();
  const codexScroll=document.querySelector(".hos-codex-scroll");if(codexScroll)codexScroll.scrollTop=0;
}
function hosWardrobeBindPreview(){
  const root=$("#details-content");if(!root)return;
  root.querySelectorAll("[data-wardrobe-open-board]").forEach(btn=>btn.addEventListener("click",()=>hosWardrobeOpenDetailBoard(btn.getAttribute("data-wardrobe-open-board"))));
  root.querySelectorAll("[data-wardrobe-fav]").forEach(btn=>btn.addEventListener("click",()=>{const id=btn.getAttribute("data-wardrobe-fav");hosWardrobeToggleFavorite(id);hosWardrobeRender();}));
}
function hosWardrobeClonePreset(id){
  const p=hosWardrobePreset(id); if(!p)return;
  const current=hosWardrobeCustomLooks(), parts=hosWardrobeEffectiveParts(p).map(x=>Object.assign({},x));
  current.push({id:"custom_"+Date.now()+"_"+Math.random().toString(36).slice(2,7),name:"Kopie – "+p.name,createdAt:new Date().toISOString(),parts});
  hosWardrobeSaveCustomLooks(current); renderNav();
}
function hosWardrobeSaveDraftAsLook(){
  const parts=hosWardrobeDraftParts().map(x=>Object.assign({},x)); if(!parts.length)return false;
  let name=window.prompt("Name für den eigenen Look:","Mein HeinrichOS-Look"); if(name===null)return false;
  name=safe(name).trim()||"Mein HeinrichOS-Look";
  const list=hosWardrobeCustomLooks(); list.push({id:"custom_"+Date.now()+"_"+Math.random().toString(36).slice(2,7),name,createdAt:new Date().toISOString(),parts});
  const ok=hosWardrobeSaveCustomLooks(list); if(ok)renderNav(); return ok;
}
function hosWardrobeCustomPreview(id){
  const look=hosWardrobeCustomLooks().find(x=>x.id===id), detail=$("#details-content");if(!look||!detail)return;
  state.selectedId=id;hosWardrobeMarkSelected();const parts=Array.isArray(look.parts)?look.parts:[], warnings=hosWardrobeConflictMessages(parts);
  detail.innerHTML=`<article class="hos-kodex-entry hos-detail-stage"><div class="hos-kodex-head"><div class="hos-kodex-icon"><img src="${esc(hosWardrobeFallbackIcon())}" alt=""></div><div><h2 class="hos-kodex-title">${esc(look.name||"Eigener Look")}</h2><div class="hos-kodex-type">★ Meine Looks · Eigenkreation</div></div></div><div class="hos-kodex-section"><h4>Schnellübersicht</h4><table class="stats-table"><tr><td>Teile</td><td class="val">${parts.length}</td></tr><tr><td>Konflikte</td><td class="val">${warnings.length}</td></tr><tr><td>Gesamtwerte</td><td class="val">nicht erfunden</td></tr><tr><td>Speicher</td><td class="val">lokal</td></tr></table></div><div class="hos-kodex-section"><h4>Details</h4><div>Eigene Kombinationen bekommen keine künstlich addierten Outfit-Gesamtwerte. Aufbau und Copy-Blöcke stehen im Detailboard.</div><p><button type="button" class="hos-action-btn" data-w-custom-open="${esc(id)}">Große Details öffnen</button></p></div></article>`;
  const root=detail;root.querySelectorAll("[data-w-custom-open]").forEach(btn=>btn.addEventListener("click",()=>hosWardrobeOpenCustomBoard(btn.getAttribute("data-w-custom-open"))));
}
function hosWardrobeOpenCustomBoard(id,initialTab="overview"){
  const look=hosWardrobeCustomLooks().find(x=>x.id===id);if(!look)return;const parts=Array.isArray(look.parts)?look.parts:[];
  const old=$("#hos-detail-board-overlay");if(old)old.remove();const overlay=document.createElement("div");overlay.id="hos-detail-board-overlay";overlay.className="hos-detail-board-overlay";
  const tabs=[["overview","Übersicht"],["parts","Aufbau"],["commands","Kopieren"]];
  const bodyHtml=(tab)=>{
    const warnings=hosWardrobeConflictMessages(parts),chunks=hosWardrobeChunkCommands(parts);
    if(tab==="parts")return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Teile</h3>${hosWardrobePartsTable(parts)}</div><div class="hos-detail-board-card"><h3>Konflikte</h3><p>${warnings.length?warnings.map(esc).join("<br>"):"Keine bekannte Konfliktwarnung."}</p></div></section>`;
    if(tab==="commands")return `<section class="hos-detail-board-tabgrid"><div class="hos-detail-board-card"><h3>Copy-Blöcke</h3>${hosWardrobeCopyBlocksHtml(chunks)}<p><small>Rohbefehle bleiben im Normalmodus verborgen.</small></p></div></section>`;
    return `<section class="hos-detail-board-overview"><div class="hos-detail-board-art"><img src="${esc(hosWardrobeFallbackIcon())}" alt=""></div><div class="hos-detail-board-card hos-detail-board-main"><h3>${esc(look.name||"Eigener Look")}</h3><div class="hos-detail-board-type">★ Meine Looks · Eigenkreation</div><table class="hos-detail-board-table"><tr><td>Teile</td><td>${parts.length}</td></tr><tr><td>Gesamtwerte</td><td>bewusst nicht berechnet</td></tr><tr><td>Speicher</td><td>localStorage</td></tr></table><p><button class="hos-action-btn" data-w-custom-edit="${esc(id)}">In freier Garderobe bearbeiten</button></p><p><button class="hos-action-btn" data-w-custom-rename="${esc(id)}">Umbenennen</button> <button class="hos-action-btn" data-w-custom-delete="${esc(id)}">Löschen</button></p></div><div class="hos-detail-board-card"><h3>Hinweis</h3><p>Eigene Looks sind editierbar. Feste HeinrichOS-Presets bleiben unverändert.</p></div></section>`;
  };
  overlay.innerHTML=`<article class="hos-detail-board" data-main="looks" role="dialog" aria-modal="true"><header class="hos-detail-board-head"><div class="hos-detail-board-titleline"><div class="hos-detail-board-small-icon"><img src="${esc(hosWardrobeFallbackIcon())}" alt=""></div><div><h2>${esc(look.name||"Eigener Look")}</h2><div>★ Meine Looks · Eigenkreation</div></div></div><div class="hos-detail-board-head-actions"><button class="hos-detail-board-back" data-board-close>Zurück zur Liste</button><button class="hos-detail-board-x" data-board-close>×</button></div></header><nav class="hos-detail-board-tabs">${tabs.map(([k,l])=>`<button class="hos-detail-board-tab ${k===initialTab?"active":""}" data-tab="${k}">${l}</button>`).join("")}</nav><div class="hos-detail-board-body" id="hos-detail-board-body">${bodyHtml(initialTab)}</div></article>`;
  document.body.appendChild(overlay);
  const bindBody=(tab)=>{
    hosWardrobeBindCopies(overlay);
    overlay.querySelectorAll("[data-w-custom-edit]").forEach(btn=>btn.addEventListener("click",()=>{const draft={};for(const p of parts)if(p.slot&&p.alias)draft[p.slot]=p.alias;hosWardrobeSaveDraft(draft);overlay.remove();state.main="wardrobe";state.sub="Freie Garderobe";state.query="";state.status="all";state.sort="standard";renderAll(true);}));
    overlay.querySelectorAll("[data-w-custom-rename]").forEach(btn=>btn.addEventListener("click",()=>{const list=hosWardrobeCustomLooks(),target=list.find(x=>x.id===id);if(!target)return;const name=window.prompt("Neuer Name:",target.name||"Eigener Look");if(name===null)return;target.name=safe(name).trim()||target.name;hosWardrobeSaveCustomLooks(list);overlay.remove();hosWardrobeRender();hosWardrobeCustomPreview(id);}));
    overlay.querySelectorAll("[data-w-custom-delete]").forEach(btn=>btn.addEventListener("click",()=>{if(!window.confirm("Diesen eigenen Look wirklich löschen?"))return;hosWardrobeSaveCustomLooks(hosWardrobeCustomLooks().filter(x=>x.id!==id));overlay.remove();renderNav();hosWardrobeRender();}));
  };
  overlay.querySelectorAll("[data-board-close]").forEach(btn=>btn.addEventListener("click",()=>overlay.remove()));overlay.addEventListener("click",ev=>{if(ev.target===overlay)overlay.remove();});
  overlay.querySelectorAll(".hos-detail-board-tab").forEach(btn=>btn.addEventListener("click",()=>{const tab=btn.getAttribute("data-tab")||"overview";overlay.querySelector("#hos-detail-board-body").innerHTML=bodyHtml(tab);overlay.querySelectorAll(".hos-detail-board-tab").forEach(b=>b.classList.toggle("active",b===btn));bindBody(tab);}));bindBody(initialTab);
}
function hosWardrobeBuilderSections(pool,draft){
  const sections=[
    ["Kopf & Hals",["head_under","head_mail","head_hood","head_cap","head_special","face","helmet","neck"]],
    ["Oberkörper",["torso_under","torso_work","torso_padding","torso_mail","torso_plate","torso_outer"]],
    ["Arme & Hände",["arms","hands"]],
    ["Beine & Füße",["legs","legs_padding","legs_outer","legs_plate","feet","spurs"]],
    ["Waffe & Schild",["weapon","shield"]],
    ["Pebbles",["horse_saddle","horse_bridle","horse_harness","horse_caparison","horse_chanfron"]]
  ];
  let idx=0;
  return sections.map(([title,order])=>{
    const slots=order.filter(slot=>pool.some(p=>p.slot===slot));if(!slots.length)return"";
    return `<section class="hos-wardrobe-builder-section"><h4>${esc(title)}</h4>${slots.map(slot=>{
      const myIdx=idx++;
      const opts=[{value:"",label:"— leer —",meta:""}].concat(pool.filter(p=>p.slot===slot).sort((a,b)=>safe(a.name).localeCompare(safe(b.name),"de")).map(p=>({value:p.alias,label:p.name,meta:p.identityStatus==="OPEN"?"Technik offen":hosWardrobeOriginLabel(p.source)})));
      return customSelectHtml(`wardrobe-slot-${myIdx}`,hosWardrobeSlotLabel(slot),"◆",opts,draft[slot]||"",false);
    }).join("")}</section>`;
  }).join("");
}
function hosWardrobeBuilderSlotSequence(pool){
  const sections=[["head_under","head_mail","head_hood","head_cap","head_special","face","helmet","neck"],["torso_under","torso_work","torso_padding","torso_mail","torso_plate","torso_outer"],["arms","hands"],["legs","legs_padding","legs_outer","legs_plate","feet","spurs"],["weapon","shield"],["horse_saddle","horse_bridle","horse_harness","horse_caparison","horse_chanfron"]];
  return sections.flat().filter(slot=>pool.some(p=>p.slot===slot));
}
function hosWardrobeBuilderHtml(){
  const pool=hosWardrobePartPool(), draft=hosWardrobeDraft(), selected=hosWardrobeDraftParts(), warnings=hosWardrobeConflictMessages(selected), chunks=hosWardrobeChunkCommands(selected);
  return `<section class="hos-wardrobe-builder">
    <div class="hos-wardrobe-builder-main"><div class="hos-detail-board-card"><div class="hos-wardrobe-builder-head"><div><h3>Freie Garderobe</h3><p>Baue deinen Look Layer für Layer. Die Auswahl bleibt lokal gespeichert.</p></div><div class="hos-wardrobe-builder-count"><b>${selected.length}</b><span>Teile gewählt</span></div></div><div class="hos-wardrobe-builder-sections">${hosWardrobeBuilderSections(pool,draft)}</div></div></div>
    <aside class="hos-wardrobe-builder-side">
      <div class="hos-detail-board-card"><h3>Aktueller Aufbau</h3>${selected.length?`<ul class="hos-wardrobe-build-list">${selected.map(p=>`<li><span>${esc(hosWardrobeSlotLabel(p.slot))}</span><b>${esc(p.name)}</b></li>`).join("")}</ul>`:`<div class="hos-detail-board-empty">Noch kein Teil ausgewählt.</div>`}</div>
      <div class="hos-detail-board-card"><h3>Prüfung</h3>${warnings.length?`<ul class="hos-wardrobe-warning-list">${warnings.map(w=>`<li>${esc(w)}</li>`).join("")}</ul>`:`<p class="hos-wardrobe-pass">✓ Keine bekannte Konfliktwarnung im aktuellen Entwurf.</p>`}</div>
      <div class="hos-detail-board-card"><h3>Copy-Blöcke</h3>${hosWardrobeCopyBlocksHtml(chunks)}<p><small>Es werden nur technisch bestätigte Identitäten kopiert.</small></p></div>
      <div class="hos-detail-board-card"><h3>Mein Look</h3><p><button type="button" class="hos-action-btn" id="hos-w-save-look">Als eigenen Look speichern</button></p><p><button type="button" class="hos-action-btn" id="hos-w-clear-draft">Entwurf leeren</button></p><p><small>Eigene Looks bekommen keine erfundenen Gesamtwerte.</small></p></div>
    </aside>
  </section>`;
}
function hosWardrobeBindBuilder(){
  const pool=hosWardrobePartPool(), slots=hosWardrobeBuilderSlotSequence(pool);
  slots.forEach((slot,idx)=>bindCustomDropdown(`wardrobe-slot-${idx}`,value=>{const d=hosWardrobeDraft();if(value)d[slot]=value;else delete d[slot];hosWardrobeSaveDraft(d);hosWardrobeRender();}));
  const save=$("#hos-w-save-look");if(save)save.addEventListener("click",()=>{const ok=hosWardrobeSaveDraftAsLook();save.textContent=ok?"✓ Gespeichert":"Speichern nicht möglich";});
  const clear=$("#hos-w-clear-draft");if(clear)clear.addEventListener("click",()=>{hosWardrobeSaveDraft({});hosWardrobeRender();});
  const grid=$("#hos-item-grid");if(grid)hosWardrobeBindCopies(grid);
}
function hosWardrobeLooksList(){
  const favIds=hosWardrobeFavoriteIds(), customs=hosWardrobeCustomLooks();let items=[];
  if(state.sub==="Alle"||state.sub==="Favoriten") items.push(...HOS_WARDROBE_PRESETS.filter(p=>favIds.includes(p.id)&&hosWardrobeQueryMatch(p)).map(p=>({kind:"fav",data:p})));
  if(state.sub==="Alle"||state.sub==="Eigene Looks") items.push(...customs.filter(x=>!state.query||norm([x.name,(x.parts||[]).map(p=>p.name+" "+p.alias).join(" ")].join(" ")).includes(norm(state.query))).map(x=>({kind:"custom",data:x})));
  if(state.sort==="name")items.sort((a,b)=>safe(a.data.name).localeCompare(safe(b.data.name),"de"));
  else if(state.sort==="parts")items.sort((a,b)=>(b.data.parts||[]).length-(a.data.parts||[]).length);
  return items;
}
function hosWardrobeRenderCardsOnly(){
  if(state.main!=="wardrobe"&&state.main!=="looks")return;
  const grid=$("#hos-item-grid");if(!grid)return;
  if(state.main==="wardrobe"&&state.sub!=="Freie Garderobe"){
    const list=hosWardrobePresetList();grid.querySelectorAll(".item-card").forEach(el=>el.remove());grid.insertAdjacentHTML("beforeend",list.map(hosWardrobePresetCard).join(""));hosWardrobeBindCards(grid);fitCardTitles(grid);
  }else if(state.main==="looks") hosWardrobeRender();
}
function hosWardrobeBindCards(grid){
  grid.querySelectorAll("[data-wardrobe-preset]").forEach(el=>el.addEventListener("click",ev=>{if(ev.target.closest("button")||ev.target.closest("a"))return;hosWardrobeShowPresetPreview(el.getAttribute("data-wardrobe-preset"));}));
  grid.querySelectorAll("[data-wardrobe-detail]").forEach(btn=>btn.addEventListener("click",ev=>{ev.preventDefault();ev.stopPropagation();hosWardrobeOpenDetailBoard(btn.getAttribute("data-wardrobe-detail"));}));
  grid.querySelectorAll("[data-wardrobe-fav]").forEach(btn=>btn.addEventListener("click",ev=>{ev.preventDefault();ev.stopPropagation();const id=btn.getAttribute("data-wardrobe-fav");hosWardrobeToggleFavorite(id);hosWardrobeRender();hosWardrobeShowPresetPreview(id);}));
  grid.querySelectorAll("[data-w-custom-card]").forEach(el=>el.addEventListener("click",ev=>{if(ev.target.closest("button")||ev.target.closest("a"))return;hosWardrobeCustomPreview(el.getAttribute("data-w-custom-card"));}));
  grid.querySelectorAll("[data-w-custom-detail]").forEach(btn=>btn.addEventListener("click",ev=>{ev.preventDefault();ev.stopPropagation();hosWardrobeOpenCustomBoard(btn.getAttribute("data-w-custom-detail"));}));
}
function hosWardrobeRender(){
  hosWardrobeEnsureStyles();setResourceModeBody();hosWardrobeSyncNav();
  const grid=$("#hos-item-grid")||$(".item-grid");if(!grid)return;const title=$("#hos-pane-title");if(title)title.textContent=state.main==="looks"?"★ Meine Looks":"Garderobe";
  if(state.main==="wardrobe"&&state.sub==="Freie Garderobe"){
    const heading=hosWardrobeRegisterHeading(1,1,"Werkbank der Garderobe"),controls=hosWardrobeRegisterControls();grid.innerHTML=heading+controls+hosWardrobeBuilderHtml();hosWardrobeBindRegisterControls();hosWardrobeBindBuilder();
    const detail=$("#details-content");if(detail)detail.innerHTML=`<div class="hos-kodex-empty"><strong>Freie Garderobe</strong><span>Links Layer auswählen, rechts Aufbau und Konflikte prüfen. Rohbefehle bleiben im Normalmodus verborgen.</span></div>`;return;
  }
  if(state.main==="looks"){
    const items=hosWardrobeLooksList(),heading=hosWardrobeRegisterHeading(items.length,items.length,"Meine Looks"),controls=hosWardrobeRegisterControls();
    grid.innerHTML=heading+controls+(items.length?items.map(x=>x.kind==="fav"?hosWardrobePresetCard(x.data):hosWardrobeCustomCard(x.data)).join(""):`<div class="hos-empty"><strong>Noch keine Looks</strong><span>Favoriten und Eigenkreationen erscheinen hier.</span></div>`);fitCardTitles(grid);hosWardrobeBindRegisterControls();hosWardrobeBindCards(grid);
    const selected=items.find(x=>safe(x.data.id)===safe(state.selectedId))||items[0];if(selected){selected.kind==="fav"?hosWardrobeShowPresetPreview(selected.data.id):hosWardrobeCustomPreview(selected.data.id);}else{const detail=$("#details-content");if(detail)detail.innerHTML=`<div class="hos-kodex-empty"><strong>Meine Looks</strong><span>In der Garderobe kannst du Favoriten setzen oder eigene Looks speichern.</span></div>`;}return;
  }
  const list=hosWardrobePresetList(),heading=hosWardrobeRegisterHeading(list.length,list.length,"Register der Garderobe"),controls=hosWardrobeRegisterControls();
  grid.innerHTML=heading+controls+(list.length?list.map(hosWardrobePresetCard).join(""):`<div class="hos-empty"><strong>Keine Looks</strong><span>Suchbegriff ändern oder Suche leeren.</span></div>`);fitCardTitles(grid);hosWardrobeBindRegisterControls();hosWardrobeBindCards(grid);
  const selected=list.find(p=>safe(p.id)===safe(state.selectedId))||list[0];if(selected)hosWardrobeShowPresetPreview(selected.id);else{const detail=$("#details-content");if(detail)detail.innerHTML=`<div class="hos-kodex-empty"><strong>Keine Auswahl</strong><span>Im aktuellen Filter ist kein Garderoben-Look sichtbar.</span></div>`;}
}
function hosWardrobeEnsureStyles(){
  if(document.getElementById("hos-wardrobe-integration02-style"))return;
  const style=document.createElement("style");style.id="hos-wardrobe-integration02-style";style.textContent=`
body .item-card.hos-wardrobe-card{min-height:88px;padding:9px 11px;}
body .item-card.hos-wardrobe-card .hos-card-top{align-items:center;gap:12px;}
body .item-card.hos-wardrobe-card .hos-card-icon.hos-wardrobe-photo{width:96px;height:64px;flex:0 0 96px;padding:0;overflow:hidden;border-color:rgba(184,122,38,.82);background:#090503;}
body .item-card.hos-wardrobe-card .hos-card-icon.hos-wardrobe-photo img{width:100%;height:100%;max-width:none;max-height:none;object-fit:cover;object-position:center 48%;filter:none;}
body .item-card.hos-wardrobe-card .hos-card-icon.hos-wardrobe-own-photo img{object-fit:contain;padding:12px;}
body .item-card.hos-wardrobe-card .card-header{font-size:18px;white-space:normal;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.04;}
body .hos-wardrobe-card-stats{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px;}
body .hos-wardrobe-card-stats span{display:inline-flex;align-items:center;min-height:19px;padding:1px 6px;border:1px solid rgba(176,117,38,.48);border-radius:999px;background:rgba(8,4,2,.72);color:#e8c57b;font-size:10.5px;font-weight:800;}
body .hos-wardrobe-kodex-photo{height:210px;margin:0 0 12px;border:1px solid rgba(119,72,22,.35);border-radius:7px;overflow:hidden;background:#1b0e06;box-shadow:inset 0 0 18px rgba(0,0,0,.45);}
body .hos-wardrobe-kodex-photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 46%;}
body .hos-wardrobe-kodex-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;}
body .hos-wardrobe-kodex-metrics span{padding:7px 8px;border:1px solid rgba(100,59,18,.20);border-radius:5px;background:rgba(255,239,194,.35);font-size:12px;}
body .hos-wardrobe-kodex-metrics b{font-size:17px;color:#6d3f13;margin-right:3px;}
body .hos-wardrobe-board-head-photo{width:72px!important;height:46px!important;overflow:hidden;border-radius:5px;}
body .hos-wardrobe-board-head-photo img{width:100%!important;height:100%!important;object-fit:cover!important;max-width:none!important;max-height:none!important;}
body .hos-wardrobe-main-art{overflow:hidden;}
body .hos-wardrobe-main-art img{width:100%!important;height:100%!important;max-width:100%!important;max-height:540px!important;object-fit:contain!important;}
body .hos-wardrobe-overview-metrics{margin-top:14px;}
body .hos-wardrobe-metrics-table th{padding:8px 7px;text-align:left;color:#704515;border-bottom:1px solid rgba(92,54,15,.25);font-size:12px;}
body .hos-wardrobe-metrics-table td:nth-child(2),body .hos-wardrobe-metrics-table td:nth-child(3){text-align:center;}
body .hos-wardrobe-baseline-note{margin:10px 0 0;font-size:11.5px;color:#62441f;}
body .hos-wardrobe-metrics-na{display:flex;flex-direction:column;gap:7px;padding:12px;border:1px dashed rgba(108,65,20,.42);border-radius:6px;background:rgba(255,241,204,.24);}
body .hos-wardrobe-values-layout{display:grid;grid-template-columns:minmax(320px,.78fr) minmax(0,1.22fr);gap:14px;align-items:start;}
body .hos-wardrobe-control-card{overflow:hidden;}
body .hos-wardrobe-control-image{display:block;width:100%;height:auto;max-height:620px;object-fit:contain;border-radius:5px;border:1px solid rgba(90,53,17,.24);background:#170c06;}
body .hos-wardrobe-copy-list{display:grid;gap:9px;}
body .hos-wardrobe-copy-btn{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:14px!important;width:100%!important;height:auto!important;min-height:43px!important;padding:8px 12px!important;text-align:left!important;}
body .hos-wardrobe-copy-btn span{font-size:11px;font-weight:700;opacity:.82;}
body .hos-wardrobe-parts-table small{color:#735122;}
body .hos-wardrobe-builder{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(285px,.7fr);gap:14px;align-items:start;margin-top:10px;}
body .hos-wardrobe-builder-main,body .hos-wardrobe-builder-side{min-width:0;}
body .hos-wardrobe-builder-side{display:grid;gap:12px;position:sticky;top:0;}
body .hos-wardrobe-builder-head{display:flex;align-items:start;justify-content:space-between;gap:16px;margin-bottom:12px;}
body .hos-wardrobe-builder-head h3{margin-bottom:4px;}
body .hos-wardrobe-builder-head p{margin:0;}
body .hos-wardrobe-builder-count{flex:0 0 auto;min-width:92px;padding:8px 10px;text-align:center;border:1px solid rgba(130,78,25,.30);border-radius:6px;background:rgba(255,236,180,.24);}
body .hos-wardrobe-builder-count b{display:block;font-size:25px;color:#6d3e12;line-height:1;}
body .hos-wardrobe-builder-count span{font-size:10px;font-weight:800;}
body .hos-wardrobe-builder-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;align-items:start;}
body .hos-wardrobe-builder-section{min-width:0;padding:10px;border:1px solid rgba(108,65,21,.22);border-radius:7px;background:rgba(255,239,195,.20);}
body .hos-wardrobe-builder-section h4{margin:0 0 8px;color:#70410e;font-size:13px;text-transform:uppercase;letter-spacing:.06em;}
body .hos-wardrobe-builder-section .hos-register-select-control{margin:0 0 7px;min-width:0;}
body .hos-wardrobe-builder-section .hos-register-control-label{font-size:11px;line-height:1.05;}
body .hos-wardrobe-builder-section .hos-custom-select-trigger{min-width:0;}
body .hos-wardrobe-build-list,body .hos-wardrobe-warning-list{list-style:none;margin:0;padding:0;display:grid;gap:7px;}
body .hos-wardrobe-build-list li{padding:7px 8px;border-bottom:1px solid rgba(95,57,19,.17);}
body .hos-wardrobe-build-list li span{display:block;font-size:10px;color:#7f5d31;text-transform:uppercase;}
body .hos-wardrobe-build-list li b{display:block;margin-top:2px;font-size:12px;color:#2f1909;}
body .hos-wardrobe-warning-list li{padding:8px;border:1px solid rgba(146,76,19,.22);border-radius:5px;background:rgba(145,70,18,.08);font-size:12px;}
body .hos-wardrobe-pass{padding:8px;border:1px solid rgba(73,113,46,.22);border-radius:5px;background:rgba(73,113,46,.08);font-weight:800;}
body .hos-wardrobe-variant-card{align-self:start;}
