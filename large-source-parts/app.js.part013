`;
  document.head.appendChild(style);
}
hosWardrobeEnsureStyles();

function renderGrid(){
  if(state.main==="wardrobe"||state.main==="looks"){ hosWardrobeRender(); return; }
  setResourceModeBody();
  const grid=$("#hos-item-grid")||$(".item-grid"); if(!grid)return;
  state.view="cards";
  grid.classList.remove("hos-view-compact");
  const list=filtered(), shown=list.slice(0,state.visible), nav=currentNav();
  const title=$("#hos-pane-title"); if(title)title.textContent=nav.label;
  // Keep the left navigation highlight synchronized with the actual register state.
  $all(".nav-item").forEach(el=>{
    const active=(el.getAttribute("data-main")||"")===state.main;
    el.classList.toggle("active",active);
    if(active) el.setAttribute("aria-current","page"); else el.removeAttribute("aria-current");
  });
  ensureSchreibstubeBoardDock();
  const headingTotal=list.length;
  const heading=renderRegisterHeading(headingTotal,shown.length);
  const controls=renderRegisterControls(headingTotal,shown.length,list);
  const more=list.length>shown.length?`<div class="hos-list-more"><span>${list.length} Treffer · ${shown.length} sichtbar</span><button id="hos-more-results" class="hos-small-btn">Weitere ${Math.min(HOS_VISIBLE_STEP,list.length-shown.length)} anzeigen</button></div>`:"";
  if(state.main==="resources"&&state.sub==="Wegweiser"){
    grid.innerHTML=renderSpoiler()+heading+controls+resourceGuideHtml();
    bindGridButtons(); return;
  }
  if(!list.length){
    state.selectedId=null;
    grid.innerHTML=renderSpoiler()+heading+controls+`<div class="hos-empty"><strong>Keine Treffer</strong><span>Suche oder Untergruppe anpassen.</span></div>`;
    const detail=$("#details-content");
    if(detail) detail.innerHTML=`<div class="hos-kodex-empty"><strong>Keine Auswahl</strong><span>Im aktuellen Filter sind keine Einträge vorhanden.</span></div>`;
    bindGridButtons(); return;
  }
  grid.innerHTML=renderSpoiler()+heading+controls+shown.map(card).join("")+more;
  fitCardTitles(grid);
  bindGridButtons();
  grid.querySelectorAll(".item-card").forEach(el=>{
    el.addEventListener("click",ev=>{
      if(ev.target&&(ev.target.closest("button")||ev.target.closest("a")))return;
      selectRecord(el.getAttribute("data-id"));
    });
  });
  grid.querySelectorAll(".hos-detail-btn").forEach(btn=>btn.addEventListener("click",ev=>{
    ev.preventDefault();ev.stopPropagation();openDetailBoard(btn.getAttribute("data-id"));
  }));
  grid.querySelectorAll(".hos-copy-btn").forEach(btn=>btn.addEventListener("click",ev=>{
    ev.preventDefault();ev.stopPropagation();const text=btn.getAttribute("data-copy")||"";
    copyText(text).then(ok=>{btn.textContent=ok?"✓ Kopiert":"Fehler";setTimeout(()=>{btn.textContent="Kopieren";},1200);});
  }));
  const selected=shown.find(rec=>rec.id===state.selectedId)||shown[0];
  if(selected) selectRecord(selected.id,false);
}

let hosRegisterGlobalCloseBound=false;
function closeRegisterDropdowns(except){
  $all(".hos-custom-select.open").forEach(root=>{
    if(root===except) return;
    root.classList.remove("open");
    const trigger=root.querySelector(".hos-custom-select-trigger");
    if(trigger) trigger.setAttribute("aria-expanded","false");
  });
}
function bindRegisterGlobalClose(){
  if(hosRegisterGlobalCloseBound) return;
  hosRegisterGlobalCloseBound=true;
  document.addEventListener("click",ev=>{
    if(!ev.target.closest(".hos-custom-select")) closeRegisterDropdowns();
  });
  document.addEventListener("keydown",ev=>{
    if(ev.key==="Escape") closeRegisterDropdowns();
  });
}
function bindCustomDropdown(id,onSelect){
  bindRegisterGlobalClose();
  const root=document.querySelector(`[data-hos-dropdown="${id}"]`);
  if(!root) return;
  const trigger=root.querySelector(".hos-custom-select-trigger");
  const options=Array.from(root.querySelectorAll(".hos-custom-select-option"));
  if(!trigger || trigger.disabled) return;
  const openMenu=()=>{
    closeRegisterDropdowns(root);
    root.classList.add("open");
    trigger.setAttribute("aria-expanded","true");
  };
  const closeMenu=()=>{
    root.classList.remove("open");
    trigger.setAttribute("aria-expanded","false");
  };
  trigger.addEventListener("click",ev=>{
    ev.preventDefault(); ev.stopPropagation();
    if(root.classList.contains("open")) closeMenu(); else openMenu();
  });
  trigger.addEventListener("keydown",ev=>{
    if(ev.key==="ArrowDown"||ev.key==="Enter"||ev.key===" "){
      ev.preventDefault(); openMenu();
      const active=root.querySelector(".hos-custom-select-option.active")||options[0];
      if(active) active.focus();
    }
  });
  options.forEach((option,index)=>{
    option.addEventListener("click",ev=>{
      ev.preventDefault(); ev.stopPropagation();
      const value=option.getAttribute("data-value")||"";
      closeMenu();
      if(typeof onSelect==="function") onSelect(value);
    });
    option.addEventListener("keydown",ev=>{
      if(ev.key==="ArrowDown"||ev.key==="ArrowUp"){
        ev.preventDefault();
        const step=ev.key==="ArrowDown"?1:-1;
        options[(index+step+options.length)%options.length]?.focus();
      }
      if(ev.key==="Escape"){
        ev.preventDefault(); closeMenu(); trigger.focus();
      }
    });
  });
}
function bindRegisterSearch(){
  const input=$("#hos-register-search"), clear=$("#hos-register-search-clear");
  if(!input)return;
  const syncHidden=()=>{const hidden=$("#hos-search")||$(".search-input");if(hidden&&hidden!==input)hidden.value=state.query;};
  const run=(keepFocus=true)=>{
    state.query=input.value||"";state.visible=HOS_VISIBLE_STEP;state.selectedId=null;syncHidden();
    const caret=input.selectionStart==null?state.query.length:input.selectionStart;
    renderGrid();
    if(keepFocus){const next=$("#hos-register-search");if(next){next.focus();try{next.setSelectionRange(caret,caret);}catch(e){}}}
  };
  input.addEventListener("input",()=>{clearTimeout(window.__hosRegisterSearchTimer);window.__hosRegisterSearchTimer=setTimeout(()=>run(true),90);});
  input.addEventListener("keydown",ev=>{if(ev.key==="Enter"){ev.preventDefault();run(true);}if(ev.key==="Escape"){ev.preventDefault();input.value="";run(true);}});
  if(clear)clear.addEventListener("click",()=>{input.value="";run(true);});
}
function bindGridButtons(){
  const moreBtn=$("#hos-more-results");if(moreBtn)moreBtn.addEventListener("click",()=>{state.visible+=HOS_VISIBLE_STEP;renderGrid();});
  bindRegisterSearch();
  bindCustomDropdown("subfilter",value=>{
    state.sub=value||SUBFILTERS[state.main]?.[0]||"Alle";state.sort="standard";state.visible=HOS_VISIBLE_STEP;state.selectedId=null;renderGrid();
  });
  bindCustomDropdown("sort",value=>{
    state.sort=value||"standard";state.visible=HOS_VISIBLE_STEP;state.selectedId=null;renderGrid();
  });
  const tog=$("#hos-spoiler-toggle");if(tog)tog.addEventListener("click",()=>{state.spoilerOpen=!state.spoilerOpen;renderGrid();});
  $all(".hos-spoiler-actions button").forEach(btn=>btn.addEventListener("click",()=>{
    state.main=btn.getAttribute("data-jump")||"all";clearTimeout(window.__hosRegisterSearchTimer);state.query="";const hiddenSearch=$("#hos-search")||$(".search-input");if(hiddenSearch)hiddenSearch.value="";state.sub=SUBFILTERS[state.main]?.[0]||"Alle";state.status="all";state.visible=HOS_VISIBLE_STEP;state.sort="standard";state.selectedId=null;renderAll(true);
  }));
}

function fieldRows(rec){
  const f=rec.fields||{}, entries=Object.entries(f).filter(([k,v])=>safe(v).trim());
  if(!entries.length)return`<div class="hos-field-row"><b>Hinweis</b><span>Keine Zusatzfelder vorhanden.</span></div>`;
  return entries.slice(0,55).map(([k,v])=>`<div class="hos-field-row"><b>${esc(k)}</b><span>${esc(v)}</span></div>`).join("");
}
function copyText(text){
  if(!text)return Promise.resolve(false);
  if(navigator.clipboard&&navigator.clipboard.writeText)return navigator.clipboard.writeText(text).then(()=>true).catch(()=>fallbackCopy(text));
  return Promise.resolve(fallbackCopy(text));
}
function fallbackCopy(text){try{const ta=document.createElement("textarea");ta.value=text;ta.style.position="fixed";ta.style.left="-9999px";document.body.appendChild(ta);ta.select();const ok=document.execCommand("copy");document.body.removeChild(ta);return ok;}catch(e){return false;}}




function setFamilyStrict(rec){
  if(!rec) return "";
  const kind=safe(rec.kind);
  // Nur echte Set-Datensätze und die im Patch erzeugten Setanker/-mitglieder zulassen.
  // So wird z. B. der Schnellzugriff „Taschendiebstahl leichter“ nicht wegen seines Namens
  // fälschlich als Mitglied des Taschendieb-Outfits behandelt.
  if(rec.__main!=="sets" && kind!=="hos_set_member_patch" && kind!=="hos_set_anchor_patch") return "";
  const fam=setFamily(rec);
  return HOS_PATCH_SET_FAMILIES.includes(fam)?fam:"";
}

function isSetContext(rec){
  return !!rec && (rec.__main === "sets" || !!setFamilyStrict(rec));
}

function setPartsForStrict(rec){
  const fam=setFamilyStrict(rec);
  if(!fam) return [];
  let candidates;
  if(fam==="Schleich-Set"){
    candidates=enriched.filter(x=>x.__main==="sets" && setFamilyStrict(x)===fam && safe(x.kind)!=="hos_set_anchor_patch" && primaryCommand(x));
  }else{
    candidates=enriched.filter(x=>safe(x.kind)==="hos_set_member_patch" && field(x,"Set-Familie")===fam);
  }
  const seen=new Set(), out=[];
  candidates.forEach(x=>{
    const key=norm(primaryCommand(x)||x.name).replace(/\s+/g," ").trim();
    if(!key||seen.has(key)) return;
    seen.add(key); out.push(x);
  });
  const slotRank=x=>{
    const s=norm(field(x,"Slot/Rolle")+" "+x.name);
    if(/kopf|hut|gugel|mütze|muetze|haube/.test(s))return 10;
    if(/oberkoerper|oberkörper|tunika|mantel|wappenrock|schuerze|schürze|pourpoint|gewand|kuerass|kürass|brust|brigantine/.test(s))return 20;
    if(/hand|arme/.test(s))return 30;
    if(/bein|hose/.test(s))return 40;
    if(/schuh|stiefel/.test(s))return 50;
    if(/waffe|dolch|axt/.test(s))return 60;
    if(/rezept|anleitung/.test(s))return 70;
    return 80;
  };
  return out.sort((a,b)=>slotRank(a)-slotRank(b)||safe(a.name).localeCompare(safe(b.name),"de"));
}

function setBlockForStrict(rec){
  const fam=setFamilyStrict(rec);
  const parts=setPartsForStrict(rec);
  const lines=[], seen=new Set();
  parts.forEach(part=>{
    const cmd=primaryCommand(part);
    if(!cmd) return;
    // Bewährte QC-Grenzen aus dem Altstand erhalten.
    if(fam==="Taschendieb" && /BootsAnkle05_m06_C\b/i.test(cmd)) return;
    if(fam==="Brunswiek/Löwenwappen" && /(?:polearmBruncvik|recipe_polearmBruncvik)\b/i.test(cmd)) return;
    safe(cmd).split(/\r?\n|\\r?\\n/).map(s=>s.trim()).filter(Boolean).forEach(line=>{
      if(!seen.has(line)){seen.add(line);lines.push(line);}
    });
  });
  return lines.join("\n");
}

function setPanelHtmlStrict(rec){
  if(!isSetContext(rec)) return "";
  const fam=setFamilyStrict(rec);
  if(!fam) return `<div class="hos-set-panel"><div class="hos-set-title"><span>Set / Komfort</span></div><div class="hos-set-no-block">Für diesen allgemeinen Set-/Empfehlungseintrag ist kein geprüfter Familienblock hinterlegt.</div></div>`;
  const parts=setPartsForStrict(rec);
  const block=setBlockForStrict(rec);
  const critical=parts.filter(p=>{
    const cmd=primaryCommand(p);
    return (fam==="Taschendieb"&&/BootsAnkle05_m06_C\b/i.test(cmd))||(fam==="Brunswiek/Löwenwappen"&&/(?:polearmBruncvik|recipe_polearmBruncvik)\b/i.test(cmd));
  });
  const safeCount=block?block.split(/\r?\n/).filter(Boolean).length:0;
  const famList=parts.length?`<div class="hos-set-family-list">${parts.map(p=>`<span class="hos-set-family-chip">${esc(p.name||"(ohne Name)")}</span>`).join("")}</div>`:"";
  const partHtml=parts.length?parts.map(p=>{
    const cmd=primaryCommand(p), isCritical=critical.includes(p);
    const note=isCritical?(fam==="Taschendieb"?"Nur einzeln zuverlässig":"Questrelevant: separat prüfen"):"Blocktauglich";
    return `<div class="hos-set-part"><div class="hos-set-part-name">${esc(p.name||"(ohne Name)")}<span class="hos-set-part-meta">${esc(field(p,"Slot/Rolle")||p.group||"")} · ${esc(note)}</span><span class="hos-part-command">${esc(cmd)}</span></div><button class="hos-part-copy" data-copy="${esc(cmd)}">Kopieren</button></div>`;
  }).join(""):`<div class="hos-set-part"><div class="hos-set-part-name">Keine geprüften Setteile hinterlegt.</div></div>`;
  const actions=block?`<button id="hos-copy-set-block">Sicheren Komfortblock kopieren</button><button id="hos-copy-visible-parts">Alle blocktauglichen Teile kopieren</button>`:`<div class="hos-set-no-block">Kein sicherer Komfortblock vorhanden.</div>`;
  return `<div class="hos-set-panel"><div class="hos-set-title"><span>Set-Komfort: ${esc(fam)}</span><span class="hos-set-count">${safeCount} blocktauglich / ${parts.length} Einträge</span></div>${famList}<div class="hos-set-actions">${actions}</div><div class="hos-set-parts">${partHtml}</div><div class="hos-set-warning">Nur exakt gepflegte Setmitglieder. ${critical.length?`${critical.length} kritische(s) Teil(e) bleiben bewusst außerhalb des Sammelblocks und sind einzeln kopierbar.`:"Keine Fremdeinträge erkannt."}</div><div id="hos-set-copy-feedback" class="hos-copy-ok"></div></div>`;
}

function bindSetPanelStrict(rec){
  const fb=$("#hos-set-copy-feedback"), blockBtn=$("#hos-copy-set-block"), visibleBtn=$("#hos-copy-visible-parts");
  const block=setBlockForStrict(rec);
  if(blockBtn) blockBtn.addEventListener("click",ev=>{ev.preventDefault();ev.stopPropagation();copyText(block).then(ok=>{if(fb)fb.textContent=ok?"✅ Sicherer Set-Block kopiert!":"Kopieren nicht möglich – bitte manuell markieren.";});});
  if(visibleBtn) visibleBtn.addEventListener("click",ev=>{ev.preventDefault();ev.stopPropagation();copyText(block).then(ok=>{if(fb)fb.textContent=ok?"✅ Blocktaugliche Teile kopiert!":"Kopieren nicht möglich – bitte manuell markieren.";});});
  $all(".hos-part-copy").forEach(btn=>btn.addEventListener("click",ev=>{ev.preventDefault();ev.stopPropagation();const value=btn.getAttribute("data-copy")||"";copyText(value).then(ok=>{if(fb)fb.textContent=ok?"✅ Einzelteil kopiert!":"Kopieren nicht möglich – bitte manuell markieren.";});}));
}


function extractLinksForce(rec){
  const f = rec.fields || {};
  const sources = [
    ["URL", rec.url],
    ["Info", rec.info],
    ["Quelle", rec.source],
    ["Cheat", rec.cheat],
    ...Object.entries(f)
  ];
  const found = [];
  const seen = new Set();
  const re = /https?:\/\/[^\s<>'")\]]+/gi;
  sources.forEach(([label, value]) => {
    const text = safe(value);
    let m;
    while((m = re.exec(text))){
      let url = m[0].replace(/[.,;:]+$/,"");
      if(!seen.has(url)){
        seen.add(url);
        found.push({label:safe(label)||"Link", url});
      }
    }
  });
  return found;
}
function linkButtonTextForce(url, label){
  const u = norm(url + " " + label);
  if(/pdf|loesungsbuch|lösungsbuch/.test(u)) return "PDF öffnen";
  if(/eurogamer|komplettloesung|komplettlösung|walkthrough|loesung|lösung/.test(u)) return "Lösung öffnen";
  if(/nebenquest|quest|page=|section/.test(u)) return "Questlösung öffnen";
  if(/mapgenie|interactive map|interaktive karte|map|karte/.test(u)) return "Karte öffnen";
  if(/youtube|youtu\.be|video/.test(u)) return "Video öffnen";
  return "Link öffnen";
}
function linkKindForce(url, label){
  const u = norm(url + " " + label);
  if(/eurogamer/.test(u)) return "Eurogamer / Komplettlösung";
  if(/pdf|loesungsbuch|lösungsbuch/.test(u)) return "PDF / Lösungsbuch";
  if(/mapgenie|interactive map|interaktive karte|map|karte/.test(u)) return "Interaktive Karte / Fundort";
  if(/youtube|youtu\.be/.test(u)) return "Video-Guide";
  if(/quest|page=|section/.test(u)) return "Quest / Lösung";
  return label || "Quelle";
}

function linksPanelHtmlForce(rec){
  const links = extractLinksForce(rec);
  const isResourceLike = rec.__main === "resources" || rec.__main === "quests" || /eurogamer|komplettloesung|komplettlösung|quest|fundort|karte|loesungsbuch|lösungsbuch|pdf|guide|http/.test(blob(rec));
  if(resourceKind(rec)==="OFFLINE" || resourceKind(rec)==="JUNK") return "";
  if(!links.length){
    if(resourceKind(rec)==="OFFLINE" || resourceKind(rec)==="JUNK") return "";
    if(isResourceLike){
      return `<div class="hos-link-panel-force"><div class="hos-link-title-force"><span>Links / Karten / Lösungen</span><span class="hos-link-count-force">0</span></div><div class="hos-link-empty-force">Kein direkter http-Link in diesem Datensatz gefunden. Der Link kann in einem Nachbar-Datensatz liegen.</div></div>`;
    }
    return "";
  }
  return `<div class="hos-link-panel-force">
    <div class="hos-link-title-force"><span>Links / Karten / Lösungen</span><span class="hos-link-count-force">${links.length}</span></div>
    ${links.map(l => `<div class="hos-link-row-force">
      <div class="hos-link-label-force">${esc(linkKindForce(l.url,l.label))}<span class="hos-link-url-force">${esc(l.url)}</span></div>
      <div>
        <button class="hos-link-open-force" data-url="${esc(l.url)}">${esc(linkButtonTextForce(l.url,l.label))}</button>
        <button class="hos-link-copy-force" data-url="${esc(l.url)}">URL kopieren</button>
      </div>
    </div>`).join("")}
  </div>`;
}

function bindLinksPanelForce(){
  $all(".hos-link-open-force").forEach(btn => {
    btn.addEventListener("click", (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      const url = btn.getAttribute("data-url") || "";
      if(url){
        window.open(url, "_blank", "noopener,noreferrer");
      }
    });
  });
  $all(".hos-link-copy-force").forEach(btn => {
    btn.addEventListener("click", (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      const url = btn.getAttribute("data-url") || "";
      copyText(url).then(ok => {
        btn.textContent = ok ? "✅ URL kopiert" : "Fehler";
        setTimeout(()=>{btn.textContent="URL kopieren";},1200);
      });
    });
  });
}



function resourceSortWeight(rec){
  const k = resourceKind(rec);
  const h = blob(rec);
  let w = 50;
  if(k==="ONLINE") w = 10;
  if(k==="QUEST") w = 20;
  if(k==="KARTE") w = 30;
  if(k==="OFFLINE") w = 40;
  if(k==="VIDEO") w = 45;
  if(/eurogamer/.test(h)) w -= 5;
  if(/alle hauptquests|alle nebenquests|tödlicher pinselstrich|toedlicher pinselstrich/.test(h)) w -= 2;
  return w;
}


